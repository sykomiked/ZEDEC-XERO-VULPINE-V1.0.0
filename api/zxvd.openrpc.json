    {
      "name": "swarm.earnings",
      "summary": "The swarm's earnings in the owner's books (docs/ZXVD.md, zxvd_rpc.h E1-E5). After every settled market cycle the owner's account is set to the Financial capital (SWC) the owner's models hold, times rate_minor, by one balanced posting from or to the swarm market account. The accounts are null until the first settled cycle. With a books file (--books), accounts brought back at start keep their balance: the run's first cycle is the base and later cycles post only the change (E5).",
      "params": [],
      "result": {
        "name": "earnings",
        "schema": {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "description": "Earnings currency (default VFV, a private unit with 2 minor units; --earnings-ccy)"
            },
            "rate_minor": {
              "type": "string",
              "pattern": "^-?[0-9]+$",
              "description": "Minor units per SWC (--earnings-rate); a bookkeeping rate, not a market price"
            },
            "source_account": {
              "type": [
                "integer",
                "null"
              ],
              "description": "The swarm market issuer account"
            },
            "owner_account": {
              "type": [
                "integer",
                "null"
              ],
              "description": "The owner's holder account"
            },
            "balance_minor": {
              "type": "string",
              "pattern": "^-?[0-9]+$",
              "description": "The owner's earnings balance"
            },
            "postings": {
              "type": "string",
              "pattern": "^-?[0-9]+$",
              "description": "Postings made"
            },
            "cycles": {
              "type": "string",
              "pattern": "^-?[0-9]+$",
              "description": "Settled cycles mirrored"
            },
            "resumed": {
              "type": "boolean",
              "description": "The accounts came back from the books file (E5)"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "mesh.books",
      "summary": "Settled peer requests in the owner's books (zxvd_rpc.h S1-S4): sales, purchases and the 0.08889% fee the node paid, in VFV, with the demo float posted as 'mesh float' when a purchase needs more than the wallet account holds. The accounts are null until the first settled request.",
