    {
      "name": "ledger.post",
      "summary": "Post a balanced transfer in minor units (libzxv zxv_ledger_post_cap). Amounts must be integers; fractions are refused, never rounded.",
      "params": [
        {
          "name": "from",
          "required": true,
          "description": "account id",
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        },
        {
          "name": "to",
          "required": true,
          "description": "account id",
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        },
        {
          "name": "amount_minor",
          "required": true,
          "description": "> 0 and at most 2^53-1 (libzxv ZXV_AMOUNT_MAX): a JSON integer or a decimal string",
          "schema": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^[0-9]{1,19}$"
              }
            ]
          }
        },
        {
          "name": "currency",
          "required": true,
          "description": "the accounts' currency",
          "schema": {
            "type": "string",
            "maxLength": 15
          }
        },
        {
          "name": "reference",
          "required": true,
          "description": "unique, at most 35 bytes (e.g. EndToEndId)",
          "schema": {
            "type": "string",
            "maxLength": 35
          }
        }
      ],
      "result": {
        "name": "entry",
        "schema": {
          "type": "object",
          "properties": {
            "entry_id": {
              "type": "string",
              "pattern": "^-?[0-9]{1,19}$",
              "description": "64-bit integer as a decimal string"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
