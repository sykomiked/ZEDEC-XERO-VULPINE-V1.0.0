    },
    {
      "name": "net.command",
      "summary": "Vinea peer network: off, lan, online, peer IP:PORT, share C S, want RES UNITS MAX, sell RES UNITS PRICE NODEID. Off by default.",
      "params": [
        {
          "name": "command",
          "required": true,
          "description": "one command line",
          "schema": {
            "type": "string",
            "maxLength": 255
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "properties": {
            "result": {
              "type": "string"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "peer.ask",
      "summary": "Ask another node (found over UDP, then a TCP session: X25519 + ML-KEM-1024 key exchange, ML-DSA-87 on both sides) and pay its price plus the 0.08889% assurance fee from the peer wallet (kernel/arch/hosted/zxv_peer_host.h). Needs networking on. The daemon's loop waits while the request runs.",
      "params": [
        {
          "name": "peer",
          "required": true,
          "description": "IPV4 or IPV4:PORT (default port 8723)",
          "schema": {
            "type": "string",
            "maxLength": 63
          }
        },
        {
          "name": "prompt",
          "required": true,
          "description": "UTF-8, at most 4096 bytes",
          "schema": {
            "type": "string",
            "maxLength": 4096
          }
        },
        {
          "name": "max_price_minor",
          "required": true,
          "description": "the most this node will pay, VFV minor units, before the fee",
          "schema": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^[0-9]{1,19}$"
              }
            ]
          }
        }
      ],
      "result": {
        "name": "answer",
        "schema": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string"
            },
            "settlement": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "buyer",
                    "seller"
                  ]
                },
                "peer": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "price_minor": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "fee_minor": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "paid_minor": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "fee_parts": {
                  "type": "object",
                  "properties": {
                    "reserve floor": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    "V-Bill dividend pool": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    "infrastructure/node bounties": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    "regenerative capital": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    }
                  }
                },
                "invoice": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "settle": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "session": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "security": {
              "type": "string"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "peer.serve",
      "summary": "Start answering other nodes over TCP for price_minor VFV minor units per answer, or stop when price_minor is absent. Off by default; needs networking on.",
      "params": [
        {
          "name": "price_minor",
          "required": false,
          "description": "VFV minor units per answer; absent stops serving",
          "schema": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^[0-9]{1,19}$"
              }
            ]
          }
        }
      ],
      "result": {
        "name": "status",
        "schema": {
          "type": "object",
          "properties": {
