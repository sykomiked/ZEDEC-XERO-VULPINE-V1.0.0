{
  "openrpc": "1.3.2",
  "info": {
    "title": "zxvd JSON-RPC",
    "version": "1.0.0",
    "description": "zxvd-rpc/1: JSON-RPC 2.0, one request per line over a 0600 UNIX socket owned by the same user (kernel/arch/hosted/zxvd_rpc.h). Errors: -32700 parse, -32600 invalid request or batch, -32601 unknown method, -32602 bad params, -32603 internal, -32000 libzxv status: error.data = {status: ZXV_E_* number, name: its symbolic name, class: USAGE|REFUSED|FATAL|SYSTEM}, -32010 peer request refused or failed (message says why), -32011 AIPI call refused or failed (message: the AIPI_ERR_* name and what it means). 64-bit integers (entry ids, *_minor results) travel as decimal strings. zxvd refuses to start against libzxv older than ABI 1.3.",
    "license": {
      "name": "Apache-2.0"
    }
  },
  "methods": [
    {
      "name": "rpc.discover",
      "summary": "The protocol name and every method name this zxvd serves.",
      "params": [],
      "result": {
        "name": "discovery",
        "schema": {
          "type": "object",
          "properties": {
            "protocol": {
              "type": "string"
            },
            "methods": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "zxvd.version",
      "summary": "App version, protocol and the libzxv ABI version and feature mask.",
      "params": [],
      "result": {
        "name": "version",
        "schema": {
          "type": "object",
          "properties": {
            "app": {
              "type": "string"
            },
            "protocol": {
              "type": "string"
            },
            "libzxv": {
              "type": "string"
            },
            "libzxv_features": {
              "type": "integer"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "zxvd.shutdown",
      "summary": "Stop the daemon after this reply; the socket file is removed.",
      "params": [],
      "result": {
        "name": "stopping",
        "schema": {
          "type": "object",
          "properties": {
            "stopping": {
              "type": "boolean"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "swarm.state",
      "summary": "The live swarm: hardware budget, levels, cycles, market, settlement spine (pay_ledger postings, fees, halt), audit, quest, companion budget and last answer tag, network and update status. Same object as the window's /api/state.",
      "params": [],
      "result": {
        "name": "state",
        "schema": {
          "type": "object"
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "swarm.ask",
      "summary": "Ask the companion. With a model installed it answers under the tokens-per-cycle budget gate and the answer is tagged; with none, shorthand is read back.",
      "params": [
        {
          "name": "prompt",
          "required": true,
          "description": "UTF-8, at most 4095 bytes",
          "schema": {
            "type": "string",
            "maxLength": 4095
          }
        }
      ],
      "result": {
        "name": "answer",
        "schema": {
          "type": "object",
          "properties": {
