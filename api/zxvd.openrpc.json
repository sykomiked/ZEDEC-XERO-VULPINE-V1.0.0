                    "type": "string",
                    "pattern": "^[0-9]+$"
                  },
                  "paid_minor": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  },
                  "fee_parts": {
                    "type": "object",
                    "properties": {
                      "reserve floor": {
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "V-Bill dividend pool": {
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "infrastructure/node bounties": {
                        "type": "string",
