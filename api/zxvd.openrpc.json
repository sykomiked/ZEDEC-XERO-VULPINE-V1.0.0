{
  "openrpc": "1.3.2",
  "info": {
    "title": "zxvd JSON-RPC",
    "version": "1.0.0",
    "description": "zxvd-rpc/1: JSON-RPC 2.0, one request per line over a 0600 UNIX socket owned by the same user (kernel/arch/hosted/zxvd_rpc.h). Errors: -32700 parse, -32600 invalid request or batch, -32601 unknown method, -32602 bad params, -32603 internal, -32000 libzxv status: error.data = {status: ZXV_E_* number, name: its symbolic name, class: USAGE|REFUSED|FATAL|SYSTEM}, -32010 peer request refused or failed (message says why). 64-bit integers (entry ids, *_minor results) travel as decimal strings. zxvd refuses to start against libzxv older than ABI 1.3.",
    "license": {
      "name": "Apache-2.0"
    }
  },
  "methods": [
    {
      "name": "rpc.discover",
      "summary": "The protocol name and every method name this zxvd serves.",
      "params": [],
      "result": {
        "name": "discovery",
        "schema": {
          "type": "object",
          "properties": {
            "protocol": {
              "type": "string"
            },
            "methods": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "zxvd.version",
      "summary": "App version, protocol and the libzxv ABI version and feature mask.",
      "params": [],
      "result": {
        "name": "version",
        "schema": {
          "type": "object",
          "properties": {
            "app": {
              "type": "string"
            },
            "protocol": {
              "type": "string"
            },
            "libzxv": {
              "type": "string"
            },
            "libzxv_features": {
              "type": "integer"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "zxvd.shutdown",
      "summary": "Stop the daemon after this reply; the socket file is removed.",
      "params": [],
      "result": {
        "name": "stopping",
        "schema": {
          "type": "object",
          "properties": {
            "stopping": {
              "type": "boolean"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "swarm.state",
      "summary": "The live swarm: hardware budget, levels, cycles, market, settlement spine (pay_ledger postings, fees, halt), audit, quest, companion budget and last answer tag, network and update status. Same object as the window's /api/state.",
      "params": [],
      "result": {
        "name": "state",
        "schema": {
          "type": "object"
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "swarm.ask",
      "summary": "Ask the companion. With a model installed it answers under the tokens-per-cycle budget gate and the answer is tagged; with none, shorthand is read back.",
      "params": [
        {
          "name": "prompt",
          "required": true,
          "description": "UTF-8, at most 4095 bytes",
          "schema": {
            "type": "string",
            "maxLength": 4095
          }
        }
      ],
      "result": {
        "name": "answer",
        "schema": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "model.info",
      "summary": "The model slot: loaded, can_generate, name, arch, n_layers, n_vocab and one status line.",
      "params": [],
      "result": {
        "name": "model",
        "schema": {
          "type": "object",
          "properties": {
            "loaded": {
              "type": "boolean"
            },
            "can_generate": {
              "type": "boolean"
            },
            "name": {
              "type": "string"
            },
            "arch": {
              "type": "string"
            },
            "n_layers": {
              "type": "integer"
            },
            "n_vocab": {
              "type": "integer"
            },
            "status": {
              "type": "string"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "notes.list",
      "summary": "Recent notifications and the unread count.",
      "params": [],
      "result": {
        "name": "notes",
        "schema": {
          "type": "object"
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "notes.mark_read",
      "summary": "Mark every notification read.",
      "params": [],
      "result": {
        "name": "marked",
        "schema": {
          "type": "object",
          "properties": {
            "marked": {
              "type": "integer"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "net.command",
      "summary": "Vinea peer network: off, lan, online, peer IP:PORT, share C S, want RES UNITS MAX, sell RES UNITS PRICE NODEID. Off by default.",
      "params": [
        {
          "name": "command",
          "required": true,
          "description": "one command line",
          "schema": {
            "type": "string",
            "maxLength": 255
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "properties": {
            "result": {
              "type": "string"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "net.peers",
      "summary": "The routing table's contacts (zxv_net_host.h U9, zxvd_rpc.h V1). Every contact answered a signed message, so its NodeID is verified. Each row is joined with the peer's mesh-book account when there is one. Empty while networking is off.",
      "params": [],
      "result": {
        "name": "peers",
        "schema": {
          "type": "object",
          "properties": {
            "peers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "description": "NodeID"
                  },
                  "addr": {
                    "type": "string",
                    "description": "a.b.c.d:port, or \"\" for a non-IPv4 address"
                  },
                  "bucket": {
                    "type": "integer",
                    "description": "Kademlia bucket"
                  },
                  "ubh": {
                    "type": "boolean",
                    "description": "The peer advertised UBH-168"
                  },
                  "last_seen_ms": {
                    "type": "string",
                    "pattern": "^[0-9]+$",
                    "description": "Wall-clock milliseconds of the last message"
                  },
                  "in_book": {
                    "type": "boolean",
                    "description": "The mesh book has an account for it"
                  },
                  "member": {
                    "type": "boolean",
                    "description": "Admitted to the commons by the owner"
                  },
                  "held": {
                    "type": "string",
                    "pattern": "^[0-9]+$",
                    "description": "Units the peer issued that this node holds"
                  },
                  "receivable": {
                    "type": "string",
                    "pattern": "^[0-9]+$",
                    "description": "Units delivered to the peer on credit"
                  },
                  "social": {
                    "type": "string",
                    "pattern": "^[0-9]+$",
                    "description": "Crown: earned, never moved"
                  },
                  "pending": {
                    "type": "integer",
                    "description": "Receipts outstanding with this peer"
                  }
                }
              }
            },
            "count": {
              "type": "integer",
              "description": "Contacts in the table (the list holds at most 256)"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "net.offers",
      "summary": "What the owner shares, the open wants, and the receipts still waiting on the other side (zxvd_rpc.h V2): a sell offer the buyer has not accepted, or a buy the seller has not committed.",
      "params": [],
      "result": {
        "name": "offers",
        "schema": {
          "type": "object",
          "properties": {
            "share": {
              "type": "object",
              "properties": {
                "compute": {
                  "type": "string",
                  "pattern": "^[0-9]+$",
                  "description": "Compute tokens shared per cycle"
                },
                "storage": {
                  "type": "string",
                  "pattern": "^[0-9]+$",
                  "description": "Storage bytes shared"
                }
              }
            },
            "wants": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slot": {
                    "type": "integer"
                  },
                  "resource": {
                    "type": "string",
                    "enum": [
                      "compute",
                      "storage",
                      "other"
                    ]
                  },
                  "units_left": {
                    "type": "string",
                    "pattern": "^[0-9]+$",
                    "description": "Still wanted"
                  },
                  "max_price": {
                    "type": "string",
                    "pattern": "^[0-9]+$",
                    "description": "The most this node pays for one receipt"
                  }
                }
              }
            },
            "outstanding": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "sell",
                      "buy"
                    ]
                  },
                  "peer": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$",
                    "description": "NodeID"
                  },
                  "units": {
                    "type": "string",
                    "pattern": "^[0-9]+$",
                    "description": "Units in the receipt"
                  },
                  "seq": {
                    "type": "string",
                    "pattern": "^[0-9]+$",
                    "description": "Pair sequence number"
                  },
                  "tries": {
                    "type": "integer",
                    "description": "Sends so far"
                  },
                  "want": {
                    "type": "integer",
                    "description": "buy: the want slot it reserves from; -1 for sell"
                  }
                }
              }
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "player.card",
      "summary": "The owner's Player Card (sicily.h S2/S3, zxvd_rpc.h V3): the tier the measured inputs earn, each input with its source, the next tier's thresholds and which are missing, and the perks. Bond, uptime and giving have no source on this node yet and are reported as 0 with the reason. Tiers give no priority, discount or credit.",
      "params": [],
      "result": {
        "name": "card",
        "schema": {
          "type": "object",
          "properties": {
            "tier": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "metal": {
              "type": "string"
            },
            "stone": {
              "type": "string"
            },
            "inputs": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              }
            },
            "next": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "tier": {
                  "type": "integer"
                },
                "metal": {
                  "type": "string"
                },
                "stone": {
                  "type": "string"
                },
                "credibility": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "bond": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "uptime_bps": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "missing": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "credibility",
                      "bond",
                      "uptime_bps"
                    ]
                  }
                }
              }
            },
            "perks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "peer.ask",
      "summary": "Ask another node (found over UDP, then a TCP session: X25519 + ML-KEM-1024 key exchange, ML-DSA-87 on both sides) and pay its price plus the 0.08889% assurance fee from the peer wallet (kernel/arch/hosted/zxv_peer_host.h). Needs networking on. The daemon's loop waits while the request runs.",
      "params": [
        {
          "name": "peer",
          "required": true,
          "description": "IPV4 or IPV4:PORT (default port 8723)",
          "schema": {
            "type": "string",
            "maxLength": 63
          }
        },
        {
          "name": "prompt",
          "required": true,
          "description": "UTF-8, at most 4096 bytes",
          "schema": {
            "type": "string",
            "maxLength": 4096
          }
        },
        {
          "name": "max_price_minor",
          "required": true,
          "description": "the most this node will pay, VFV minor units, before the fee",
          "schema": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^[0-9]{1,19}$"
              }
            ]
          }
        }
      ],
      "result": {
        "name": "answer",
        "schema": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string"
            },
            "settlement": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "buyer",
                    "seller"
                  ]
                },
                "peer": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "price_minor": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "fee_minor": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "paid_minor": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "fee_parts": {
                  "type": "object",
                  "properties": {
                    "reserve floor": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    "V-Bill dividend pool": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    "infrastructure/node bounties": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    },
                    "regenerative capital": {
                      "type": "string",
                      "pattern": "^[0-9]+$"
                    }
                  }
                },
                "invoice": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "settle": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "session": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "security": {
              "type": "string"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "peer.serve",
      "summary": "Start answering other nodes over TCP for price_minor VFV minor units per answer, or stop when price_minor is absent. Off by default; needs networking on.",
      "params": [
        {
          "name": "price_minor",
          "required": false,
          "description": "VFV minor units per answer; absent stops serving",
          "schema": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^[0-9]{1,19}$"
              }
            ]
          }
        }
      ],
      "result": {
        "name": "status",
        "schema": {
          "type": "object",
