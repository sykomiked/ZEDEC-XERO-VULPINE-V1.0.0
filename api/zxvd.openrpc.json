    {
      "name": "currency.enable",
      "summary": "Enable an ISO 4217 currency in the owner's books (libzxv zxv_ccy_enable_cap).",
      "params": [
        {
          "name": "code",
          "required": true,
          "description": "ISO 4217 alpha code, e.g. USD",
          "schema": {
            "type": "string",
            "maxLength": 15
          }
        }
      ],
      "result": {
        "name": "enabled",
        "schema": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "string"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "ledger.open_account",
      "summary": "Open an account (libzxv zxv_ledger_open_account_cap).",
      "params": [
        {
          "name": "name",
          "required": true,
          "description": "at most 63 bytes",
          "schema": {
            "type": "string",
            "maxLength": 63
          }
        },
        {
          "name": "currency",
          "required": true,
          "description": "an enabled currency",
          "schema": {
            "type": "string",
            "maxLength": 15
          }
        },
        {
          "name": "kind",
          "required": false,
          "description": "holder (default; never below zero) or issuer",
          "schema": {
            "type": "string",
            "enum": [
              "holder",
              "issuer"
            ]
          }
        }
      ],
      "result": {
        "name": "account",
        "schema": {
          "type": "object",
          "properties": {
            "account": {
              "type": "integer"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "ledger.post",
      "summary": "Post a balanced transfer in minor units (libzxv zxv_ledger_post_cap). Amounts must be integers; fractions are refused, never rounded.",
      "params": [
        {
          "name": "from",
          "required": true,
          "description": "account id",
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        },
        {
          "name": "to",
          "required": true,
          "description": "account id",
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        },
        {
          "name": "amount_minor",
          "required": true,
          "description": "> 0 and at most 2^53-1 (libzxv ZXV_AMOUNT_MAX): a JSON integer or a decimal string",
          "schema": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "pattern": "^[0-9]{1,19}$"
              }
            ]
          }
        },
        {
          "name": "currency",
          "required": true,
          "description": "the accounts' currency",
          "schema": {
            "type": "string",
            "maxLength": 15
          }
        },
        {
          "name": "reference",
          "required": true,
          "description": "unique, at most 35 bytes (e.g. EndToEndId)",
          "schema": {
            "type": "string",
            "maxLength": 35
          }
        }
      ],
      "result": {
        "name": "entry",
        "schema": {
          "type": "object",
          "properties": {
            "entry_id": {
              "type": "string",
              "pattern": "^-?[0-9]{1,19}$",
              "description": "64-bit integer as a decimal string"
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
    {
      "name": "ledger.balance",
      "summary": "Rail balances of an account: DEBIT 555, CREDIT 777, EQUITY 888, in minor units.",
      "params": [
        {
          "name": "account",
          "required": true,
          "description": "account id",
          "schema": {
            "type": "integer",
            "minimum": 0
          }
        }
      ],
      "result": {
        "name": "balance",
        "schema": {
          "type": "object",
          "properties": {
            "debit_minor": {
              "type": "string",
              "pattern": "^-?[0-9]{1,19}$",
              "description": "64-bit integer as a decimal string"
            },
            "credit_minor": {
              "type": "string",
              "pattern": "^-?[0-9]{1,19}$",
              "description": "64-bit integer as a decimal string"
            },
            "equity_minor": {
              "type": "string",
              "pattern": "^-?[0-9]{1,19}$",
              "description": "64-bit integer as a decimal string"
            }
          }
        }
      },
      "paramStructure": "by-name"
