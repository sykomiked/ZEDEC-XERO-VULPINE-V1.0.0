                      },
                      "V-Bill dividend pool": {
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "infrastructure/node bounties": {
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      },
                      "regenerative capital": {
                        "type": "string",
                        "pattern": "^[0-9]+$"
                      }
                    }
                  },
                  "invoice": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "settle": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "session": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      },
      "paramStructure": "by-name"
    },
