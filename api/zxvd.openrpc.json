            },
            "wallet_minor": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "fees_paid_minor": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "buckets": {
              "type": "object",
              "properties": {
                "reserve floor": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "V-Bill dividend pool": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "infrastructure/node bounties": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "regenerative capital": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              }
            },
            "sold": {
              "type": "integer"
            },
            "bought": {
              "type": "integer"
            },
            "refused": {
              "type": "integer"
            },
            "sessions": {
              "type": "integer"
            },
            "book_ok": {
              "type": "boolean"
            },
            "history": {
              "type": "array",
