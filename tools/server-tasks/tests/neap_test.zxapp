# neap — the test manifest (checks at 7:1)
# every check below exercises a boundary of its entry.
zxapp 1
id neap_test
matrix 234
name Neap Test
provides count_ok truth count cap
provides flags_none truth bits forbidden
provides running_state truth state event
provides product num a b
logic eve count_ok <<
eve neap
counts = 1 .. 100

count_ok {
  count: counts 1 .. 100
  cap: counts 100 .. 100
}
.
logic kron flags_none <<
(_bits&_forbidden)=0
.
logic kron running_state <<
((_state=0)&(_event=1))|((_state=1)&(_event=1))
.
logic kron product <<
0|_a*_b
.
check count_ok count=1,100,101,0 cap=100,100,100,100 = true,true,false,false
check count_ok count=0,0 cap=0,0
check count_ok count=1,1 cap=1,1
check count_ok count=1,0 cap=1,0
check count_ok count=1000000,1 cap=1,1000000
check count_ok count=0,1000000 cap=1000000,0
check count_ok count=999999999,999999999 cap=999999999,999999999
check flags_none bits=0,1,2,3 forbidden=1,1,1,1 = true,false,true,false
check flags_none bits=0,0 forbidden=0,0
check flags_none bits=1,1 forbidden=1,1
check flags_none bits=1,0 forbidden=1,0
check flags_none bits=1000000,1 forbidden=1,1000000
check flags_none bits=0,1000000 forbidden=1000000,0
check flags_none bits=999999999,999999999 forbidden=999999999,999999999
check running_state state=0,0,1,1 event=1,2,1,2 = true,false,true,false
check running_state state=0,0 event=0,0
check running_state state=1,1 event=1,1
check running_state state=1,0 event=1,0
check running_state state=1000000,1 event=1,1000000
check running_state state=0,1000000 event=1000000,0
check running_state state=999999999,999999999 event=999999999,999999999
check product a=1,12,0,999 b=1250,999,7,1000 = 1250,11988,0,999000
check product a=0,0 b=0,0
check product a=1,1 b=1,1
check product a=1,0 b=1,0
check product a=1000000,1 b=1,1000000
check product a=0,1000000 b=1000000,0
check product a=999999999,999999999 b=999999999,999999999
