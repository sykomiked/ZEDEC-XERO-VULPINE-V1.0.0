# cusp — the test manifest (checks at 7:1)
# every check below exercises a boundary of its entry.
zxapp 1
id cusp_test
matrix 287
name Cusp Test
provides modular_draw num seed members step
provides product num a b
provides difference num a b
logic kron modular_draw <<
0|(((_seed*1103515245)+12345)+(_step*7))|_members
.
logic kron product <<
0|_a*_b
.
logic kron difference <<
0|_a-_b
.
check modular_draw seed=1,1,1,2 members=10,10,10,7 step=0,1,2,0 = 5,2,9,6
check product a=1,12,0,999 b=1250,999,7,1000 = 1250,11988,0,999000
check product a=0,0 b=0,0
check product a=1,1 b=1,1
check product a=1,0 b=1,0
check product a=1000000,1 b=1,1000000
check product a=0,1000000 b=1000000,0
check product a=999999999,999999999 b=999999999,999999999
check difference a=10,5,0,100 b=3,5,0,99 = 7,0,0,1
check difference a=0,0 b=0,0
check difference a=1,1 b=1,1
check difference a=1,0 b=1,0
check difference a=1000000,1 b=1,1000000
check difference a=0,1000000 b=1000000,0
check difference a=999999999,999999999 b=999999999,999999999
