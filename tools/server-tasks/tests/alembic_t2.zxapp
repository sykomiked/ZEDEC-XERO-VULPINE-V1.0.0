# T2 — alembic: the inter-language agreement
zxapp 1
id alembic_t2
matrix 11
name Alembic T2
provides count_ok truth count cap
logic eve count_ok <<
eve alembic
counts = 1 .. 100

count_ok {
  count: counts 1 .. 100
  cap: counts 100 .. 100
}
.
logic kron count_ok <<
(_count>0)&(_count le _cap)
.
check count_ok count=0,1,2,3 cap=0,1,2,3 = both
