# atrium — the test manifest (checks at 7:1)
# every check below exercises a boundary of its entry.
zxapp 1
id atrium_test
matrix 332
name Atrium Test
provides limit_excess num value limit
provides count_ok truth count cap
logic trebago limit_excess <<
trebago limit_excess
  in  value, limit
  out excess
  excess = max(0, value - limit)
end
.
logic eve count_ok <<
eve atrium
counts = 1 .. 100

count_ok {
  count: counts 1 .. 100
  cap: counts 100 .. 100
}
.
check limit_excess value=0,1000,1001,2000 limit=1000,1000,1000,1000 = 0,0,1,1000
check limit_excess value=0,0 limit=0,0
check limit_excess value=1,1 limit=1,1
check limit_excess value=1,0 limit=1,0
check limit_excess value=1000000,1 limit=1,1000000
check limit_excess value=0,1000000 limit=1000000,0
check limit_excess value=999999999,999999999 limit=999999999,999999999
check count_ok count=1,100,101,0 cap=100,100,100,100 = true,true,false,false
check count_ok count=0,0 cap=0,0
check count_ok count=1,1 cap=1,1
check count_ok count=1,0 cap=1,0
check count_ok count=1000000,1 cap=1,1000000
check count_ok count=0,1000000 cap=1000000,0
check count_ok count=999999999,999999999 cap=999999999,999999999
