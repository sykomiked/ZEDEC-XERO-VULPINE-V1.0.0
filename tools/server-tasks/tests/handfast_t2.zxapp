# T2 — handfast: the inter-language agreement
zxapp 1
id handfast_t2
matrix 20
name Handfast T2
provides count_ok truth count cap
logic eve count_ok <<
eve handfast
counts = 1 .. 100

count_ok {
  count: counts 1 .. 100
  cap: counts 100 .. 100
}
.
logic kron count_ok <<
(_count>0)&(_count le _cap)
.
check count_ok count=0,1,2,3 cap=0,1,2,3 = both
