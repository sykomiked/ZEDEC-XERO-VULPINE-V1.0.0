# T2 — pharos: the inter-language agreement
zxapp 1
id pharos_t2
matrix 38
name Pharos T2
provides count_ok truth count cap
logic eve count_ok <<
eve pharos
counts = 1 .. 100

count_ok {
  count: counts 1 .. 100
  cap: counts 100 .. 100
}
.
logic kron count_ok <<
(_count>0)&(_count le _cap)
.
check count_ok count=0,1,2,3 cap=0,1,2,3 = both
