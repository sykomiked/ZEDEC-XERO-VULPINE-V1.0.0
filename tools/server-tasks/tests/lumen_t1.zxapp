# T1 — lumen: the entry checks
zxapp 1
id lumen_t1
matrix 12
name Lumen T1
provides limit_excess num value limit
provides composite_key num high low
provides largest_remainder num pool w1 w2 w3 w4
provides ratio_x1000 num num den
logic trebago limit_excess <<
trebago limit_excess
  in  value, limit
  out excess
  excess = max(0, value - limit)
end
.
logic kron composite_key <<
0|((_high*1000)+_low)
.
logic kron largest_remainder <<
0|(_pool*_w1)%(_w1+_w2+_w3+_w4)
.
logic kron ratio_x1000 <<
0|(_num*1000)%_den
.
check limit_excess value=0,1000,1001,2000 limit=1000,1000,1000,1000 = 0,0,1,1000
check limit_excess value=1000,999 limit=1000,1000 = 0,0
check limit_excess value=1,1000000 limit=0,999999 = 1,1
check composite_key high=2024,0,1,999 low=7,0,999,999 = 2024007,0,1999,999999
check largest_remainder pool=100,10,7,100 w1=1,1,1,1 w2=1,1,1,1 w3=1,1,1,1 w4=1,0,0,0 = 25,5/2,7/4,100/3
check ratio_x1000 num=1,1,1,3 den=3,8,1000,4 = 1000/3,125,1,750
