# crown — the test manifest (checks at 7:1)
# every check below exercises a boundary of its entry.
zxapp 1
id crown_test
matrix 75
name Crown Test
provides flags_none truth bits forbidden
provides exact_total num n a b c d
provides share_x100 num part whole
provides modular_draw num seed members step
provides count_ok truth count cap
logic kron flags_none <<
(_bits&_forbidden)=0
.
logic trebago exact_total <<
trebago exact_total
  in  n, a, b, c, d
  out total
  total = sum(i = 1:n, (i=1)*a + (i=2)*b + (i=3)*c + (i=4)*d)
end
.
logic kron share_x100 <<
0|(_part*10000)%_whole
.
logic kron modular_draw <<
0|(((_seed*1103515245)+12345)+(_step*7))|_members
.
logic eve count_ok <<
eve crown
counts = 1 .. 100

count_ok {
  count: counts 1 .. 100
  cap: counts 100 .. 100
}
.
check flags_none bits=0,1,2,3 forbidden=1,1,1,1 = true,false,true,false
check flags_none bits=0,0 forbidden=0,0
check flags_none bits=1,1 forbidden=1,1
check flags_none bits=1,0 forbidden=1,0
check flags_none bits=1000000,1 forbidden=1,1000000
check flags_none bits=0,1000000 forbidden=1000000,0
check flags_none bits=999999999,999999999 forbidden=999999999,999999999
check exact_total n=2,4,1,0 a=10,1,7,5 b=20,2,7,5 c=0,3,7,5 d=0,4,7,5 = 30,10,7,0
check share_x100 part=1,1,1,50 whole=3,4,100,100 = 10000/3,2500,100,5000
check share_x100 part=0,0 whole=0,0
check share_x100 part=1,1 whole=1,1
check share_x100 part=1,0 whole=1,0
check share_x100 part=1000000,1 whole=1,1000000
check share_x100 part=0,1000000 whole=1000000,0
check share_x100 part=999999999,999999999 whole=999999999,999999999
check modular_draw seed=1,1,1,2 members=10,10,10,7 step=0,1,2,0 = 5,2,9,6
check count_ok count=1,100,101,0 cap=100,100,100,100 = true,true,false,false
check count_ok count=0,0 cap=0,0
check count_ok count=1,1 cap=1,1
check count_ok count=1,0 cap=1,0
check count_ok count=1000000,1 cap=1,1000000
check count_ok count=0,1000000 cap=1000000,0
check count_ok count=999999999,999999999 cap=999999999,999999999
