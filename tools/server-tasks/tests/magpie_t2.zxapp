# T2 — magpie: the inter-language agreement
zxapp 1
id magpie_t2
matrix 119
name Magpie T2
provides count_ok truth count cap
provides flags_none truth bits forbidden
logic eve count_ok <<
eve magpie
counts = 1 .. 100

count_ok {
  count: counts 1 .. 100
  cap: counts 100 .. 100
}
.
logic kron count_ok <<
(_count>0)&(_count le _cap)
.
logic kron flags_none <<
(_bits&_forbidden)=0
.
logic kron flags_none <<
(_bits|(_forbidden*2))<_forbidden
.
check count_ok count=0,1,2,3 cap=0,1,2,3 = both
check flags_none bits=0,1,2,3 forbidden=0,1,2,3 = both
