# skep — the test manifest (checks at 7:1)
# every check below exercises a boundary of its entry.
zxapp 1
id skep_test
matrix 185
name Skep Test
provides exact_total num n a b c d
provides largest_remainder num pool w1 w2 w3 w4
provides limit_excess num value limit
logic trebago exact_total <<
trebago exact_total
  in  n, a, b, c, d
  out total
  total = sum(i = 1:n, (i=1)*a + (i=2)*b + (i=3)*c + (i=4)*d)
end
.
logic kron largest_remainder <<
0|(_pool*_w1)%(_w1+_w2+_w3+_w4)
.
logic trebago limit_excess <<
trebago limit_excess
  in  value, limit
  out excess
  excess = max(0, value - limit)
end
.
check exact_total n=2,4,1,0 a=10,1,7,5 b=20,2,7,5 c=0,3,7,5 d=0,4,7,5 = 30,10,7,0
check largest_remainder pool=100,10,7,100 w1=1,1,1,1 w2=1,1,1,1 w3=1,1,1,1 w4=1,0,0,0 = 25,10/3,7/3,50
check limit_excess value=0,1000,1001,2000 limit=1000,1000,1000,1000 = 0,0,1,1000
check limit_excess value=0,0 limit=0,0
check limit_excess value=1,1 limit=1,1
check limit_excess value=1,0 limit=1,0
check limit_excess value=1000000,1 limit=1,1000000
check limit_excess value=0,1000000 limit=1000000,0
check limit_excess value=999999999,999999999 limit=999999999,999999999
