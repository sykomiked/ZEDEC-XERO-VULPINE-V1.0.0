# shanty — the test manifest (checks at 7:1)
# every check below exercises a boundary of its entry.
zxapp 1
id shanty_test
matrix 362
name Shanty Test
provides grade_band num value b1 b2 b3 b4
provides ratio_x1000 num num den
provides within_range truth value lo hi
provides count_ok truth count cap
provides running_state truth state event
logic kron grade_band <<
(_value>_b1)+(_value>_b2)+(_value>_b3)+(_value>_b4)
.
logic kron ratio_x1000 <<
0|(_num*1000)%_den
.
logic eve within_range <<
eve shanty
values = 0 .. 100

within_range {
  value: values 0 .. 100
  lo: values 0 .. 0
  hi: values 100 .. 100
}
.
logic eve count_ok <<
eve shanty
counts = 1 .. 100

count_ok {
  count: counts 1 .. 100
  cap: counts 100 .. 100
}
.
logic kron running_state <<
((_state=0)&(_event=1))|((_state=1)&(_event=1))
.
check grade_band value=0,5,15,25,100 b1=10,b2=20,b3=30,b4=40 = 0,0,1,2,4
check ratio_x1000 num=1,1,1,3 den=3,8,1000,4 = 1000/3,125,1,750
check ratio_x1000 num=0,0 den=0,0
check ratio_x1000 num=1,1 den=1,1
check ratio_x1000 num=1,0 den=1,0
check ratio_x1000 num=1000000,1 den=1,1000000
check ratio_x1000 num=0,1000000 den=1000000,0
check ratio_x1000 num=999999999,999999999 den=999999999,999999999
check within_range value=0,50,100,101 lo=0,0,0,0 hi=100,100,100,100 = true,true,true,false
check count_ok count=1,100,101,0 cap=100,100,100,100 = true,true,false,false
check count_ok count=0,0 cap=0,0
check count_ok count=1,1 cap=1,1
check count_ok count=1,0 cap=1,0
check count_ok count=1000000,1 cap=1,1000000
check count_ok count=0,1000000 cap=1000000,0
check count_ok count=999999999,999999999 cap=999999999,999999999
check running_state state=0,0,1,1 event=1,2,1,2 = true,false,true,false
check running_state state=0,0 event=0,0
check running_state state=1,1 event=1,1
check running_state state=1,0 event=1,0
check running_state state=1000000,1 event=1,1000000
check running_state state=0,1000000 event=1000000,0
check running_state state=999999999,999999999 event=999999999,999999999
