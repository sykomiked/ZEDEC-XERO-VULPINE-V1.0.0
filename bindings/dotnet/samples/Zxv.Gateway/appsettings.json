{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",
  "Zxv": {
    "Currencies": [ "NGN", "GHS", "KES", "XOF", "XAF", "ZAR", "EGP", "MAD", "ETB", "RWF" ],
    "PrivateUnits": [ { "Code": "VFV", "MinorUnits": 2 } ],
    "IdentifierPrefix": "ZXV"
  },
  "Gateway": {
    "Transport": {
      "Directory": ""
    },
    "Authentication": {
      "Mode": "Oidc",
      "RequiredScope": "zxv.operator",
      "Oidc": {
        "Authority": "",
        "Audience": "zxv-operator-api"
      },
      "Mtls": {
        "AllowedThumbprints": [],
        "RevocationCheck": true
      }
    }
  }
}
