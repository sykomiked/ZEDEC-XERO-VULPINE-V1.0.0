#
# Vintner, the vineyard and wine ledger: layer 91 of the matrix. Vineyard
# lots from harvest through must and barrel to bottle, their volumes and
# losses in millilitres, the cellar probe, and sales in the owner's books
# (ledger.accounts, ledger.open_account, ledger.post, ledger.balance,
# ledger.entries); barrel lot labels come from the grant engine
# (grants.status). Advisory and owner-confirmed: a sale is only checked
# and held until the owner confirms it (vintner_model.h VN5). Money is
# integer minor units and volume integer millilitres, never a float.
#
# A foundation of the matrix: 10 later layers lean on this one, so each
# general rule is registered in CONCEPTS.tsv with Vintner as its owner (a
# quantity at a unit price, the volume a stage leaves unaccounted, a probe
# count in tenths of a degree). Coffer (built before) owns the money: the
# revenue after a sale is coffer.balance and a sale is a transfer that
# coffer.transfer_ok allows, so neither is written again. Gleaner (71) and
# Gatehouse (8) are built after this layer and Ninefold (80) is not built
# yet: nothing of theirs is used.
#
#   sale_value   bottles * price in minor units (VN1), Sutra and C++ (as
#                WebAssembly), witnessed: Sutra holds nine digits each and
#                refuses past them, C++ answers to 64 bits, so past nine
#                digits the sale is held.
#   flow_gap     what a stage leaves unaccounted (VN2), exact in Trebago,
#                one stage per row: 0 conserves the volume.
#   probe_tenths a cellar probe count of sixteenths of a degree in tenths
#                (VN3): Forth, written in its twin Cairndrake's canonical
#                form (zxlang twin), checks the probe's range, and KRON
#                witnesses the conversion. A Forth program reads its input
#                from the stack and Lingua's Forth has no DEPTH, so it takes
#                one reading per call: each check line is one row. A count
#                outside -880..2000 is refused by Forth and converted by
#                KRON: held.
#   lot_ok       a lot's record, ^ZXVINTNER, in MYRA (VN4).
#
# The task names no planned languages, so no entry is pending. zxvd has
# no method for the probe itself (the view hands the model its count) and
# no notification method (the model composes the notice); none is
# invented.
zxapp 1
id     vintner
name   Vintner
version 1.0.0
slot   91
layer  L1
matrix 91
icon   icons/l1/091-vintner.svg
budget 233
needs  ledger.read
needs  ledger.post
model  apps/vintner_model.c
use    coffer 1   # @num.coffer_balance @logic.coffer_transfer_ok

# A sale's value, bottles * price in minor units (VN1): Sutra and C++.
provides sale_value num bottles price
logic    sutra sale_value apps/blocks/vintner/sale.sutra
logic    wasm  sale_value apps/blocks/vintner/sale.wasm

# What one stage leaves unaccounted, before - after - loss in ml (VN2).
provides flow_gap num before after loss
logic    trebago flow_gap apps/blocks/vintner/flow.tb

# A cellar probe reading in tenths of a degree (VN3). Forth, twin
# Cairndrake; the line names the runtime "forth", since the Alexandria
# index numbers runtimes, not twins.
provides probe_tenths num raw
logic    forth probe_tenths apps/blocks/vintner/probe.fs
logic    kron  probe_tenths apps/blocks/vintner/probe.kron

# A lot's record (VN4), in MYRA.
provides lot_ok truth lot vintage stage bottles volume
logic    myra lot_ok apps/blocks/vintner/lot.myra

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check sale_value bottles=0,1,12,999999999 price=0,1500,2499,999999999 = 0,1500,29988,999999998000000001
check sale_value bottles=1,1000000000 price=1,1 = both
check sale_value bottles=1,1 price=1,1000000000 = both
check flow_gap before=1000000,750000,600000,100,0 after=750000,600000,598500,90,0 loss=250000,150000,1500,5,1 = 0,0,0,5,-1
check probe_tenths raw=-880 = -550
check probe_tenths raw=2000 = 1250
check probe_tenths raw=0 = 0
check probe_tenths raw=-1 = -1
check probe_tenths raw=200 = 125
check probe_tenths raw=2001 = both
check probe_tenths raw=-881 = both
check lot_ok lot=1,999999999,1000000000,7,7 vintage=2024,9999,2024,10000,2024 stage=1,4,1,1,10 bottles=0,999999999,0,0,0 volume=0,999999999999,0,0,0 = true,true,false,false,false
check coffer.balance before=0,100 moved=2499,-100 = 2499,0
