#
# Bonfire, events and gatherings: layer 95 of the matrix. The owner plans
# a gathering (a name, a start, the seats and a venue from the owner's
# saved places, place.list), keeps its invite list and the guests'
# answers, opens it as a public space (pspace.create) or an invite-only
# group (social.group_create), announces it there (pspace.post) and reads
# who is in the space (pspace.members). Every method is zxvd's; none is
# invented. zxvd has no calendar, invitation or RSVP method, so the
# gathering, its list and the answers are the model's own records
# (bonfire_model.h BM2-BM5); zxvd has no notification method, so the
# notice of seats left is only composed.
#
# Announcements cannot be deleted (pspace.post has no delete, vna_space.h
# P5), and opening a space or a group makes a record peers keep: each of
# the three is sent only on the owner's word (owner_confirmed), checked
# after the arguments and before anything is sent (BM6, BM7).
#
# Built on what is nearer the core: how many guests gave each answer is
# Witness's count by kind (witness.kind_count); how full a gathering is is
# used_share.used_x100 over its seats; a space CID's text is Seedbank's
# cid_byte, checked before a CID pspace.create answers is kept; and
# whether an announcement may go out is Meadow's seat_post_ok (this node
# made the room, so its seat is the public's in a park, Meadow's MM1, and
# a post is 1..1024 bytes). Hamlet (96) owns social groups but is built
# after this layer (MATRIX_ORDER.tsv), so it is not used: the group is
# opened with zxvd's social.group_create directly.
#
# No other layer leans on this one yet (MATRIX_ORDER.tsv), but each entry
# is a general rule of bookings (a guest list and its seats, a headcount,
# their records), so each is registered in CONCEPTS.tsv with Bonfire as
# owner.
#
# Witness pairs are of one kind. guest_join_ok is a truth, Eve and MYRA,
# as the task asks. MYRA checks only whether values fit their fields
# (zxapp_myra.c MY1-MY4), so both languages get each part as a margin:
# the guest's place on the list (-1 not on it) and the seats left once the
# party is seated. MYRA reads each as a $H day (0..2980013, so a margin
# below 0 does not fit) and Eve holds it to its meaning: a margin past its
# meaning is held (BOTH). The counts are exact in Trebago, as the task
# asks; KRON witnesses each and answers where Trebago refuses (held). The
# gathering and invite records are MYRA's alone, as the task asks. The
# model's C (bonfire_rules.h) is the third witness.
#
# Kept in C, since no runnable language owns it: reading zxvd's answers,
# names as whole UTF-8 and the announcement's text.
#
# Defaults taken (bonfire_model.h BM1-BM3): 8 gatherings, 100 guests a
# list, 9999 seats, a party of 1..99; a space is opened as a room governed
# by its owner (pspace.create's kind and gov) and a group invite-only.
#
# Logo (twin Kiteling) runs now and owns geometry, but it is not used:
# Lingua's Logo refuses readword and readlist (zl_logo.c), so a Logo
# program cannot read an entry's arguments (zxapp_lingua.c L1), and
# Bonfire decides no geometry (the distance to a venue is zxvd's,
# place.list's distance_m). Smalltalk owns live objects: a gathering is
# Bonfire's object, so its record waits on Smalltalk (pending below).
zxapp 1
id     bonfire
name   Bonfire
version 1.0.0
slot   95
layer  L1
matrix 95
icon   icons/l1/095-bonfire.svg
budget 233
needs  peers
needs  net
needs  location
needs  notify
model  apps/bonfire_model.c
use    witness 1      # @num.witness_kind_count
use    used_share 1   # @num.used_x100
use    seedbank 1     # @num.seedbank_cid_byte
use    meadow 1       # @logic.meadow_seat_post_ok

# May this guest join (BR1): on the invite list (listpos 0..99) and the
# party fits (seatroom 0..9999), each as its margin. Eve's ranges,
# witnessed by MYRA's days; a margin past its meaning is held.
provides guest_join_ok truth listpos seatroom
logic    eve  guest_join_ok apps/blocks/bonfire/join.eve
logic    myra guest_join_ok apps/blocks/bonfire/join.myra

# Seats left at each gathering (BR2): seats - going, refused outside
# 0 <= going <= seats <= 9999 (Trebago); KRON subtracts as it is: held.
provides seats_left num seats going
logic    trebago seats_left apps/blocks/bonfire/seats.tb
logic    kron    seats_left apps/blocks/bonfire/seats.kron

# The people coming (BR3): the exact sum of the yes guests' parties, a
# party outside 1..99 or an answer outside 0..3 refusing the whole sum
# (Trebago); KRON counts only the yes rows: held.
provides rsvp_headcount num party answer
logic    trebago rsvp_headcount apps/blocks/bonfire/headcount.tb
logic    kron    rsvp_headcount apps/blocks/bonfire/headcount.kron

# A gathering makes a ^ZXBONFIRE record (BR4), in MYRA.
provides event_record_ok truth gathering start seats going venue
logic    myra event_record_ok apps/blocks/bonfire/gathering.myra
pending  Smalltalk event_record_ok

# A line of an invite list makes a ^ZXBONFIREINV record (BR5), in MYRA.
provides invite_record_ok truth gathering guest answer party stamp
logic    myra invite_record_ok apps/blocks/bonfire/invite.myra

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check guest_join_ok listpos=0,99,-1,0,5 seatroom=0,9999,10,-1,40 = true,true,false,false,true
check guest_join_ok listpos=0,100 seatroom=0,0 = both
check guest_join_ok listpos=0,0 seatroom=0,10000 = both
check seats_left seats=0,40,40,9999,12 going=0,0,40,1,7 = 0,40,0,9998,5
check seats_left seats=40,40 going=0,41 = both
check rsvp_headcount party=1,4,2,99,3 answer=1,1,2,1,3 = 104
check rsvp_headcount party=2,2 answer=1,0 = 2
check rsvp_headcount party=2,2 answer=1,4 = both
check event_record_ok gathering=0,7,1000,1,1,1 start=1767225600,99999999999,0,100000000000,0,0 seats=40,9999,1,1,10000,1 going=0,9999,0,0,0,0 venue=-1,199,0,0,0,1000 = true,true,false,false,false,false
check invite_record_ok gathering=0,7,1000,1,1,1 guest=0,99,0,1000,1,1 answer=1,3,0,0,10,0 party=1,99,1,1,1,100 stamp=1700000000000,9999999999999,0,0,0,0 = true,true,false,false,false,false
# Witness's count by kind, used as it is: how many guests said yes (1)
check witness.kind_count kind=1,2,1,3,0 want=1 = 2
# used_share.used_x100, used as it is: 40 seats, 30 left, a quarter taken
check used_share.used_x100 total=40,40 left=30,0 = 2500,10000
