#
# Neap, double-entry books: L2, slot 234. Its chart of accounts sorts
# zxvd's accounts into assets, liabilities, equity, income and expenses
# (ledger.accounts, ledger.balance, ledger.entries); an entry is checked
# and held for the owner, then posted (ledger.post) and the books checked
# (ledger.check) with A = L + E after every post; a bank statement line
# with no matching book entry is held BOTH and its amount put on a
# suspense hold (ledger.hold, ledger.holds, ledger.release), each the
# owner's word; statements are rendered as camt.053 (iso20022.render),
# under the jurisdiction the books keep (jurisdiction.get), and reports
# saved and printed (files.write, print.submit). See neap_model.h NM1-NM9
# and neap_rules.h NR1-NR7. Tax figures are advisory, not tax advice: a
# person files. Every post waits for the owner.
#
# Composed, not written again (four uses of ZXAPP_USES 8; its own 11
# logic lines and its parts' 21 are 32 of ZXAPP_LOGIC_MAX 128): an
# account's balance after a movement is coffer.balance and a transfer's
# limits coffer.transfer_ok (asked beside entry_may_post, never instead);
# an invoice line's total is tallystick.taxed_line_total and "paid in
# full" tallystick.paid_in_full; a period's closing is
# reckoner.statement_close, the tax estimate reckoner.band_tax and
# "report allowed" reckoner.report_ok; a trial balance's column is
# furrow.range_total and an amount typed in units and cents
# furrow.money_cell. reckoner.statement_close is an account's own
# opening + credits - debits; a general ledger line is one line's move on
# its account's normal side, which no part says, so gl_line_amount is new.
#
# The task's "matrix 234" is refused by zxapp.c (M1: a matrix layer is
# 0..144); an L2 app sits on the outermost L1 layer it is composed from in
# MATRIX_ORDER.tsv, Furrow's 40.
#
# Later layers will lean on the entry rule, the equation, both
# depreciation methods and the ledger line, so they are general and
# registered in CONCEPTS.tsv with Neap as owner.
#
# zxvd keeps no account class, no closed account and no period, so the
# chart (kind, open) and the period are Neap's own; ledger.hold is
# zxvd's escrow ("escrow: <CCY>"), here the suspense account. Kept in C:
# zxvd's answers, the chart's text and the reports' text.
zxapp 1
id     neap
name   Neap
version 1.0.0
slot   234
layer  L2
matrix 40
icon   icons/l2/234-neap.svg
budget 233
needs  ledger.read
needs  ledger.post
needs  fs.write
needs  print
needs  notify
model  apps/neap_model.c
use    coffer 1       # @num.coffer_balance @logic.coffer_transfer_ok
use    tallystick 1   # @num.tallystick_taxed_line_total @logic.tallystick_paid_in_full
use    reckoner 1     # @num.reckoner_statement_close @num.reckoner_band_tax @logic.reckoner_report_ok
use    furrow 1       # @num.furrow_range_total @num.furrow_money_cell
# what it exports, so apps built from it can use them too (C1)
provides coffer.balance num before moved
provides coffer.transfer_ok truth amount after room gap
provides tallystick.taxed_line_total num qty price taxn taxd
provides tallystick.paid_in_full truth total over
provides reckoner.statement_close num opening credits debits
provides reckoner.band_tax num income lo hi rate
provides reckoner.report_ok truth closed books
provides furrow.range_total num pos lo hi cell
provides furrow.money_cell num units cents

# An entry may post (NR1, critical): debits equal credits, every account
# open, the period open, the amount a posting's. Ada as Eve (the limits)
# and COBOL as Sutra (the business record), witnessed; past Sutra's
# pictures held (Sutra refuses, Eve answers no).
provides entry_may_post truth amount gap shut period
logic    eve   entry_may_post apps/blocks/neap/entry.eve
logic    sutra entry_may_post apps/blocks/neap/entry.sutra

# A = L + E after every post (NR2, critical): the gap, 0 when it holds.
# COBOL as Sutra (money refusing past 18 digits) and FORTRAN as Trebago
# (the exact sum), witnessed; past 18 digits held.
provides equation_gap num assets liabilities equity
logic    sutra   equation_gap apps/blocks/neap/equation.sutra
logic    trebago equation_gap apps/blocks/neap/equation.tb

# Depreciation in minor units, the remainder in the last period (NR3,
# NR4): FORTRAN as Trebago (exact) and COBOL as Sutra (money), witnessed;
# a cost or book past Sutra's 9(12) held.
provides straight_charge num cost salvage life period
logic    trebago straight_charge apps/blocks/neap/straight.tb
logic    sutra   straight_charge apps/blocks/neap/straight.sutra
provides declining_charge num book salvage rate last
logic    trebago declining_charge apps/blocks/neap/declining.tb
logic    sutra   declining_charge apps/blocks/neap/declining.sutra

# A general ledger line (NR5), refusing on overflow: COBOL as Sutra. RPG
# (reports from fixed records) owns the ledger's report lines; it does
# not run yet, so Sutra stands in.
provides gl_line_amount num debit credit normal
logic    sutra gl_line_amount apps/blocks/neap/line.sutra
pending  RPG gl_line_amount

# The account grid, accounts by months (NR6): APL as KRON.
provides account_month_total num account month amount
logic    kron account_month_total apps/blocks/neap/grid.kron

# The chart-of-accounts tree (NR7): ^ZXNEAP(parent, code) = kind ^ open,
# MUMPS as MYRA.
provides coa_node_ok truth parent code kind open
logic    myra coa_node_ok apps/blocks/neap/chart.myra

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check entry_may_post amount=1,9007199254740991,0,500,500,500,500 gap=0,0,0,1,0,0,0 shut=0,0,0,0,1,0,0 period=1,1,1,1,1,0,2 = true,true,false,false,false,false,false
check entry_may_post amount=500,500 gap=0,0 shut=0,-1 period=1,1 = both
check entry_may_post amount=500,500 gap=0,1000000000000000000 shut=0,0 period=1,1 = both
check equation_gap assets=0,1500,-200,999999999999999999,100,0 liabilities=0,1000,0,0,0,0 equity=0,500,-200,999999999999999999,0,1 = 0,0,0,0,100,-1
check equation_gap assets=0,1000000000000000000 liabilities=0,0 equity=0,0 = both
check straight_charge cost=100000,100000,100000,0,999999999999,1000 salvage=10000,10000,10000,0,0,1000 life=7,7,1,1,1200,3 period=1,7,1,1,1200,2 = 12857,12858,90000,0,833333732,0
check straight_charge cost=999999999999,999999999999 salvage=0,0 life=1200,1200 period=1,1199 = 833333333,833333333
check straight_charge cost=100,1000000000000 salvage=0,0 life=1,1 period=1,1 = both
check declining_charge book=100000,100000,100000,1000,999999999999,5000 salvage=10000,10000,99000,0,0,5000 rate=2000,2000,2000,3333,10000,10000 last=0,1,0,0,0,0 = 20000,90000,1000,333,999999999999,0
check declining_charge book=100,1000000000000 salvage=0,0 rate=1000,1000 last=0,0 = both
check gl_line_amount debit=500,0,500,0,999999999999999999 credit=0,500,0,500,0 normal=1,1,-1,-1,1 = 500,-500,-500,500,999999999999999999
check account_month_total account=1,1,2,1,2 month=1,1,1,2,1 amount=100,250,40,7,-10 = 350,350,30,7,30
check coa_node_ok parent=0,100,999999,1000000,1,-999999 code=100,110,999999,1,1,5 kind=1,1,9,1,10,1 open=1,0,9,1,1,0 = true,true,true,false,false,true
# A balance after a movement, and a transfer's limits
check coffer.balance before=0,100,-50,999999999999999998 moved=0,-100,25,1 = 0,0,-25,999999999999999999
check coffer.balance before=1,1000000000000000000 moved=0,0 = both
check coffer.transfer_ok amount=1,9007199254740991,0,5,5,5 after=0,0,0,-1,0,0 room=0,0,0,0,-1,0 gap=0,0,0,0,0,1 = true,true,false,false,false,false
check coffer.transfer_ok amount=5,5 after=0,1000000000000000000 room=0,0 gap=0,0 = both
# An invoice line's total and whether it is paid in full
check tallystick.taxed_line_total qty=0,1,3,999999,2,1 price=0,1000,1999,9999999,5,1 taxn=0,1,2,1,1,1 taxd=1,10,25,1,4,2 = 0,1100,6477,19999978000002,13,2
check tallystick.taxed_line_total qty=1,1000000 price=1,1 taxn=0,0 taxd=1,1 = both
check tallystick.paid_in_full total=100,100,0,9007199254740991,100,9007199254740992 over=0,5,0,999999999999999999,-1,0 = true,true,true,true,false,false
check tallystick.paid_in_full total=100,100 over=0,1000000000000000000 = both
# A period's closing, a band's tax and whether a report is allowed
check reckoner.statement_close opening=0,100,-500,999999999999999999 credits=0,250,0,0 debits=0,50,100,999999999999999999 = 0,300,-600,0
check reckoner.statement_close opening=0,0 credits=0,1000000000000000000 debits=0,0 = both
check reckoner.band_tax income=0,50000,150000,10001,99999999999999,150000 lo=10000,10000,10000,0,0,200000 hi=100000,100000,100000,100000,99999999999999,300000 rate=2000,2000,2000,3333,10000,3000 = 0,8000,18000,3333,99999999999999,0
check reckoner.band_tax income=1,100000000000000 lo=0,0 hi=1,100000000000000 rate=10000,10000 = both
check reckoner.report_ok closed=1,1,0,0,2 books=1,0,1,0,1 = true,false,false,false,false
# A trial balance's column and an amount typed in units and cents
check furrow.range_total pos=1,2,3,4,5 lo=2,2,2,2,2 hi=4,4,4,4,4 cell=10,20,30,40,50 = 90
check furrow.range_total pos=1,1,1 lo=1,1,1 hi=1,1,1 cell=9223372036854775807,1,-1 = both
check furrow.money_cell units=0,12,-12,9999999999999999,-9999999999999999 cents=0,34,-34,99,-99 = 0,1234,-1234,999999999999999999,-999999999999999999
check furrow.money_cell units=1,1 cents=0,100 = both
