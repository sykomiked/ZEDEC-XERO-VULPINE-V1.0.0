#
# Wake, the event console. How many events pass the view's level is
# counted in KRON and in Trebago; the two must agree before the count is
# shown.
zxapp 1
id     wake
name   Wake
version 1.0.0
slot   14
layer  L1
icon   icons/l1/014-wake.svg
budget 55
needs  journal
model  apps/wake_model.c

provides count num level bar
logic    kron    count apps/blocks/wake/count.kron
logic    trebago count apps/blocks/wake/count.tb
# best fit is Natural (queries over records); it has no front-end yet
pending  Natural count

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check count level=0,3,5,2 bar=3 = 2
check count level=0,3 bar=1,2 = both
