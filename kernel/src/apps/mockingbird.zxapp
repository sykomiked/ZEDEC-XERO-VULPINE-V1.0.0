#
# Mockingbird, the hardware emulator: layer 128 of the matrix. It emulates
# a ZXV device to try drivers and apps against: RAM sized from the machine
# zxvd runs on (sys.info), devices wired to a memory map, a boot through
# five stages in order and runs counted in cycles (mockingbird_model.h
# MM1-MM4, mockingbird_rules.h MR1-MR5). zxvd has no emulator method, and
# none is invented: the emulated device lives in the model, and zxvd is
# asked only for the machine's facts.
#
# Two later layers lean on this one, so its entries are general rules owned
# here (CONCEPTS.tsv), for any later layer that boots, maps or runs
# something:
#
#   boot_passed      every stage of a boot ran, in order, and gave code 0.
#                    Eve and KRON are witnessed: Eve's only record is all
#                    zeros, KRON reads any code below 1 as passed, so a
#                    stage that never ran (-1) where none failed before it
#                    is held. Which stage failed first is the model's C.
#   region_overlaps  how many neighbours of a map sorted by base overlap
#                    (or are out of order), in KRON and Trebago witnessed:
#                    Trebago refuses a base or size outside a 48-bit
#                    address space, KRON answers any integers: held.
#   run_cycles       the cycles one run takes, steps * cost + stall, in
#                    Sutra and Trebago witnessed: Sutra refuses past its
#                    pictures, Trebago only past 64 bits: held.
#   emu_limits_ok    RAM at most 4 GiB, at most 64 devices, at most 10^9
#                    cycles, each against its own range, so Eve alone.
#   emu_device_ok    a device's record (kind, base, size, irq) in MYRA,
#                    ^ZXMOCK.
#
# Of the layers the task names, Kitling (62), Relief (60), Trellis (29),
# Caravan (90) and Hollow (2) are built before this one, and none fits:
# Kitling grows a companion, Relief draws and measures solids, Trellis
# keeps the owner's mesh of real devices (its peer_record_ok is a roster
# entry, not a device on a memory map), Caravan weighs parcels and Hollow
# lays out windows (hollow.shown is pixels of a segment on a screen, not
# regions of an address space counted against each other). No shared block
# boots, maps or counts cycles either, so nothing is used: reuse 0, and
# every entry here is new.
#
# Planned (no runtime yet): Simula 67 owns simulation, and a run's cycle
# count is the emulator's simulation step; B owns word-level machine code,
# and the memory map is the machine-level rule here. Both are pending.
# Racket owns symbolic work and parsing; Mockingbird parses nothing, so it
# has no entry of its kind and no pending line.
zxapp 1
id     mockingbird
name   Mockingbird
version 1.0.0
slot   128
layer  L1
matrix 128
icon   icons/l1/128-mockingbird.svg
budget 233
needs  sys.read
model  apps/mockingbird_model.c

# MR1: the boot, five stage codes in order.
provides boot_passed truth rom loader kernel drivers apps
logic    eve  boot_passed apps/blocks/mockingbird/boot.eve
logic    kron boot_passed apps/blocks/mockingbird/boot.kron

# MR2: the memory map, one region per row, sorted by base.
provides region_overlaps num base size
logic    kron    region_overlaps apps/blocks/mockingbird/overlaps.kron
logic    trebago region_overlaps apps/blocks/mockingbird/overlaps.tb
pending  B region_overlaps

# MR3: one run per row.
provides run_cycles num steps cost stall
logic    sutra   run_cycles apps/blocks/mockingbird/cycles.sutra
logic    trebago run_cycles apps/blocks/mockingbird/cycles.tb
pending  Simula_67 run_cycles

# MR4: what an emulated device may be.
provides emu_limits_ok truth ram devices cycles
logic    eve emu_limits_ok apps/blocks/mockingbird/limits.eve

# MR5: a device fits its record.
provides emu_device_ok truth device kind base size irq
logic    myra emu_device_ok apps/blocks/mockingbird/device.myra

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check boot_passed rom=0,1,0,0,255 loader=0,-1,0,0,-1 kernel=0,-1,3,0,-1 drivers=0,-1,-1,0,-1 apps=0,-1,-1,5,-1 = true,false,false,false,false
check boot_passed rom=0,0 loader=0,0 kernel=0,-1 drivers=0,0 apps=0,0 = both
check region_overlaps base=0,4096,8192 size=4096,4096,4096 = 0
check region_overlaps base=0,4000,8192 size=4096,4096,4096 = 1
check region_overlaps base=0,8192,4096 size=4096,4096,4096 = 1
check region_overlaps base=0,0,0 size=0,0,0 = 0
check region_overlaps base=0,281474976706560 size=281474976706561,4096 = 1
check region_overlaps base=0,4096 size=4096,-1 = both
check region_overlaps base=0,281474976710656 size=4096,1 = both
check run_cycles steps=0,1,1000,999999999 cost=0,1,4,9999 stall=0,0,7,999999999 = 0,1,4007,9999999990000
check run_cycles steps=1,1000000000 cost=1,1 stall=0,0 = both
check emu_limits_ok ram=1,4294967296,0,4294967297,65536,65536,65536 devices=0,64,0,0,65,-1,0 cycles=0,1000000000,0,0,0,0,1000000001 = true,true,false,false,false,false,false
check emu_device_ok device=99,100,0,0,-99 kind=99,1,1,1,8 base=999999999999999,0,1000000000000000,0,0 size=999999999999999,1,1,0,4096 irq=999,1,1,1000,-999 = true,false,false,false,true
