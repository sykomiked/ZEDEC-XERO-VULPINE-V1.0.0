#
# Shepherd, family and screen time. Minutes left today are worked out in
# Sutra and KRON, the same rule zxvd applies (zxv_screen.c); what a limit
# may say is Eve; a week's minutes are an exact Trebago sum.
zxapp 1
id     shepherd
name   Shepherd
version 1.0.0
slot   142
layer  L1
matrix 142
icon   icons/l1/142-shepherd.svg
budget 233
needs  screen.time
needs  ai.ask
model  apps/shepherd_model.c

provides left num minutes extra used
logic    sutra left apps/blocks/shepherd/left.sutra
logic    kron  left apps/blocks/shepherd/left.kron

provides limit_ok truth minutes from to
logic    eve limit_ok apps/blocks/shepherd/limit.eve

provides week num minutes
logic    trebago week apps/blocks/shepherd/week.tb

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check left minutes=60,60,0 extra=0,15,0 used=60,60,0 = 0,15,0
check left minutes=10000 extra=0 used=0 = both
check limit_ok minutes=-2,-1,1440,1441 from=0 to=0 = false,true,true,false
check week minutes=30,0,1440,45,12,0,7 = 1534
