#
# Lodestone, the inspector for developers: layer 23 of the matrix
# (terminal, console and monitors). What this zxvd serves and how fast:
# its methods by group (rpc.discover), the model in the slot (model.info),
# the routing table's contacts (net.peers), its version and feature
# switches, the capabilities it was built with (zxvd.version,
# features.get), and the latency of each of those calls, timed by the
# caller's clock. Every method is zxvd's and read only; Lodestone changes
# nothing, switches nothing on and moves no money (lodestone_model.h
# LM1-LM6).
#
# No later layer leans on this one (MATRIX_ORDER.tsv), but two of its
# entries are general rules other layers may need, so they are owned here
# (CONCEPTS.tsv): the exact mean of measured latencies, and a routing
# table contact's record. Earlier layers own the rest of what Lodestone
# decides, used as they are: how many methods a group holds is a count by
# kind (witness.kind_count, Trebago and KRON witnessed, as the task asks),
# and the fastest and slowest call are Retort's latency folds
# (retort.latency_fastest_ms and latency_slowest_ms, KRON and wasm). Of
# the layers the task names, Seedbank (33) and Trellis (29) are built
# before this one, but neither owns a rule Lodestone needs: model.info
# names no CID (Seedbank's cid_byte), and Trellis's peer record is a
# device of the owner's mesh (devmesh.devices), not a contact of the
# routing table, which has its own fields (bucket, UBH-168, last seen,
# receipts pending); Trellis's states (active, revoked, waiting) are no
# state a contact has.
#
# Witness pairs are of one kind (zxapp.c run_one B3): Trebago and KRON
# witness latency_mean_ms, a number; MYRA alone files the contact record.
# The model's C (lodestone_rules.h) is the third witness of each.
#
# Defaults taken (lodestone_rules.h LR2): zxvd sets no limit on how long a
# call may take, so a latency is 0..3600000 ms, Retort's range; a clock
# that goes back counts the call as 0 ms (Retort's default, RM4); a call
# that takes longer is kept out of the samples and said so.
zxapp 1
id     lodestone
name   Lodestone
version 1.0.0
slot   23
layer  L1
matrix 23
icon   icons/l1/023-lodestone.svg
budget 233
needs  sys.read
needs  peers
model  apps/lodestone_model.c
use    witness 1   # @num.witness_kind_count
use    retort 1    # @num.retort_latency_fastest_ms @num.retort_latency_slowest_ms

# The exact mean latency of the calls measured (LR2), each 0..3600000 ms.
# Trebago refuses one outside; KRON adds it: held.
provides latency_mean_ms num ms
logic    trebago latency_mean_ms apps/blocks/lodestone/mean.tb
logic    kron    latency_mean_ms apps/blocks/lodestone/mean.kron

# A routing table contact fits its record (LR4): ^ZXLODESTONE's digits.
provides net_contact_ok truth contact bucket ubh seen book member pending
logic    myra net_contact_ok apps/blocks/lodestone/contact.myra

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check latency_mean_ms ms=1,2,2 = 5/3
check latency_mean_ms ms=0,0 = 0
check latency_mean_ms ms=3600000,3600000 = 3600000
check latency_mean_ms ms=120,121 = 241/2
check latency_mean_ms ms=5,3600001 = both
check latency_mean_ms ms=-1,5 = both
check net_contact_ok contact=0,255,1000,0,0,0,0,0,0 bucket=0,255,0,1000,0,0,0,0,0 ubh=0,1,0,0,10,0,0,0,0 seen=0,999999999999999,0,0,0,1000000000000000,0,0,0 book=0,1,0,0,0,0,10,0,0 member=0,1,0,0,0,0,0,10,0 pending=0,999999999,0,0,0,0,0,0,1000000000 = true,true,false,false,false,false,false,false,false
# Methods per group (LR1): rpc.discover's groups 1 1 2 3 1, group 1 holds 3
check witness.kind_count kind=1,1,2,3,1 want=1 = 3
check witness.kind_count kind=1,2 want=1,1 = both
# The fastest and the slowest call (LR3), folded one step at a time
check retort.latency_fastest_ms fastest=3600000,120,95 ms=120,95,300 = 120,95,95
check retort.latency_slowest_ms slowest=0,120,120 ms=120,95,300 = 120,120,300
