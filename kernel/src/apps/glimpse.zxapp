#
# Glimpse, screenshots and screen recording: layer 111 of the matrix. A
# screenshot of the screen, a window or a region is saved into the Hoard
# with zxvd's files.write as "Screenshots/Screenshot N.png", N the first
# number free in files.list's listing of that folder; a recording's size is
# checked against the room sys.disk reports before it starts, and a
# finished recording is cut into segments with stream.plan
# (glimpse_model.c). A recording always shows that it is recording
# (glimpse_model.h GM4), and nothing is captured in the tests.
#
# zxvd has no display-capture method: none captures the screen, a window
# or a region, none records the screen, none lists the windows and their
# places, and none posts a notice to the person (notes.* only lists and
# marks; api/zxvd.openrpc.json lists none of these). So the view captures
# the frame and hands the model a PNG (glimpse_take) with the screen's size
# and the window's rectangle; "notify" is the capability the view's
# recording notice asks for. None is invented.
#
#   capture_origin  where the capture region starts along one side, clamped
#                   to the screen (GR1): min(max(pos, 0), span), KRON and
#                   Trebago witnessed. Trebago holds pos to -99999..99999
#                   and the screen's side to 1..16384 and refuses anything
#                   else; KRON clamps whatever it is given: held.
#   recording_bytes the exact raw size of a recording (GR3): w * h * bytes
#                   per pixel * secs * fps, at most 7200 s and 60 fps, and
#                   -1 when it is past the room sys.disk reports (avail,
#                   what this user may still write, less the owner's
#                   floor), Trebago and KRON witnessed. Trebago refuses an
#                   input past its range (a 61st frame a second, a 7201st
#                   second), KRON multiplies it out: held.
#   first_free_n    the first free screenshot number from the used numbers
#                   (GR4), in KRON alone, as the task asks: the smallest
#                   N >= 1 not among them; a number below 1 holds no place.
#
# Used, never written again (CONCEPTS.tsv):
#   hollow.shown           how much of the region lies on the screen along
#                          a side (GR2, segment_on_screen): with
#                          capture_origin it clamps x, y, w, h inside the
#                          width and height, never negative.
#   lifeboat.restore_fits  a screenshot fits (GR5, space_for_write): its
#                          bytes with the owner's floor kept free, at most
#                          what may still be written.
#
# Planned languages (no runtime yet): Visual Basic owns views and stands
# for the region's place on the screen (capture_origin); dBase owns records
# and queries and stands for the lookup of the first free number
# (first_free_n); ALGOL 68 owns strongly typed formulas and stands for the
# recording's size (recording_bytes).
zxapp 1
id     glimpse
name   Glimpse
version 1.0.0
slot   111
layer  L1
matrix 111
icon   icons/l1/111-glimpse.svg
budget 233
needs  fs.read
needs  fs.write
needs  sys.read
needs  notify
model  apps/glimpse_model.c
use    hollow 1     # @num.hollow_shown
use    lifeboat 1   # @logic.lifeboat_restore_fits

# The capture region's origin along one side (GR1), KRON and Trebago.
provides capture_origin num pos span
logic    kron    capture_origin apps/blocks/glimpse/origin.kron
logic    trebago capture_origin apps/blocks/glimpse/origin.tb
pending  Visual_Basic capture_origin

# A recording's exact raw size, refused past the room (GR3), Trebago and KRON.
provides recording_bytes num w h bpp secs fps room
logic    trebago recording_bytes apps/blocks/glimpse/recording.tb
logic    kron    recording_bytes apps/blocks/glimpse/recording.kron
pending  ALGOL_68 recording_bytes

# The first free screenshot number (GR4), KRON.
provides first_free_n num used
logic    kron first_free_n apps/blocks/glimpse/first_free.kron
pending  dBase first_free_n

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check capture_origin pos=-5,0,10,1919,1920,3000,-99999,99999 span=1920,1920,1920,1920,1920,1920,1,16384 = 0,0,10,1919,1920,1920,0,16384
check capture_origin pos=10,10 span=1920,0 = both
check capture_origin pos=10,100000 span=1920,1920 = both
check capture_origin pos=10,10 span=1920,16385 = both
check recording_bytes w=1920,1920,1,16384,1,640 h=1080,1080,1,16384,1,480 bpp=4,4,1,8,1,3 secs=10,10,1,7200,1,7200 fps=30,30,1,60,1,60 room=2488320000,2488319999,0,999999999999999999,1,999999999999999999 = 2488320000,-1,-1,927712935936000,1,398131200000
check recording_bytes w=1920,1920 h=1080,1080 bpp=4,4 secs=10,10 fps=30,61 room=999999999,999999999999 = both
check recording_bytes w=1920,1920 h=1080,1080 bpp=4,4 secs=10,7201 fps=30,30 room=999999999,999999999999 = both
check recording_bytes w=1920,0 h=1080,1080 bpp=4,4 secs=10,10 fps=30,30 room=999999999,999999999999 = both
check first_free_n used=0 = 1
check first_free_n used=1,3,2,6 = 4
check first_free_n used=2,2,-1,1,1 = 3
check first_free_n used=3,1 = 2
check first_free_n used=1,2,3,4,5,6,7,8 = 9
check hollow.shown pos=-100,1900,0,2000 size=300,800,1920,10 span=1920,1920,1920,1920 = 200,20,1920,0
check hollow.shown pos=0,0 size=800,-1 span=1920,1920 = both
check lifeboat.restore_fits need=0,3000000,3000001 free=0,4000000,4000000 reserve=0,1000000,1000000 = true,true,false
check lifeboat.restore_fits need=1,-1 free=10,10 reserve=1,1 = both
