#
# Murmuration, the swarm dashboard. One app, three languages: the screen and
# the zxvd link are C; the numbers it shows about the cycle (KRON) and the
# limits it checks them against (Eve) come from the swarm_shares block,
# which other apps can use too.
zxapp 1
id     murmuration
name   Murmuration
version 1.0.0
slot   61
layer  L1
matrix 61
icon   icons/l1/061-murmuration.svg
budget 89
needs  swarm
view   zui/views/murmuration.c
model  apps/murmuration_model.c
use    swarm_shares 1   # @swarm.cycle_share @swarm.busiest @swarm.within_limits
# what it exports, so apps built from it can use the shares too (C1)
provides swarm_shares.cycle_share num t
provides swarm_shares.busiest num t
provides swarm_shares.within_limits truth share intensity

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check swarm_shares.cycle_share t=1,1,2 = 250,250,500
check swarm_shares.busiest t=5,9,1,7 = 1,3,0
check swarm_shares.within_limits share=0,500,501,10 intensity=5,0,0,6 = true,true,false,false
