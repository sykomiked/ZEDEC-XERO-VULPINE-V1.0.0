#
# Tally, the calculator: layer 109 of the matrix. Integer and exact
# rational arithmetic (kernel/src/rational: reduced num/den, overflow
# refused, integers only, so 1/3 stays 1/3), units by exact factors, and
# currency in integer minor units. The currencies offered are the ones the
# owner enabled, read from the books with ledger.accounts (ledger.read
# only). zxvd has no exchange-rate method and none is invented: the owner
# types the rate as two integers, and a conversion is shown, never posted
# (the model calls no posting method).
#
# 3 later layers lean on this one (Coffer, Ninefold and Toolchest), so its
# entries are general and owned here (CONCEPTS.tsv): the four exact
# rational operations, a unit conversion by exact factors, and a currency
# amount at a rate with its remainder. Nothing nearer the core fits them:
# the shared blocks are capacities, shares, days, swarm shares and the
# decision engines, and the apps before this one hold balances, prices at
# fixed scales and shares, none an exact rational result. The pce_fin
# block is used: a net present value at an exact rate is a calculator's
# function (tally_model.h TM7), and Tally writes none of its own. The gcd
# (number_classics) would fit the "reduced by" Tally shows, but the
# per-app harness registers only used_share, swarm_shares and the pce
# blocks, so the model takes it from the reduction itself (rat_make).
#
# Defaults taken, and why (tally_rules.h):
# - The task pairs the rational operations in Trebago and Sutra. Sutra
#   answers only whole numbers (zxapp_sutra.c SU4: "the answer is not a
#   whole number"), so it cannot answer 1/3, and a witness that refuses
#   every proper fraction would hold them all. Trebago is witnessed by
#   KRON instead, the other runtime whose answers are exact reduced
#   rationals; Sutra witnesses the currency entries, where it fits.
# - A rational's parts are held to 18 digits either way (the ledger's
#   s9(18)): Trebago refuses past that, KRON answers: held.
# - The currency domain is Sutra's pictures: an amount 0..999999999999
#   minor units (9(12)) and a rate of two parts 1..999999 (9(6)), so the
#   product fits 9(18).
# - ALGOL 60 (twin Rootwyrm) states the conversion formula and joins
#   Sutra and KRON on fx_amount. A Lingua block reads one row per call
#   (zxapp_lingua.c L1), so fx_amount's check lines have one row each.
#
# Planned (no runtime yet): TRAC owns macro text processing; Tally decides
# nothing of that kind, so it has no pending line.
zxapp 1
id     tally
name   Tally
version 1.0.0
slot   109
layer  L1
matrix 109
icon   icons/l1/109-tally.svg
budget 233
needs  ledger.read
model  apps/tally_model.c
use    pce_fin 1   # @fin.npv

# The four exact rational operations (TL1), each Trebago and KRON: an / ad
# with bn / bd, reduced; a part past 18 digits held (Trebago refuses, KRON
# answers), a denominator of 0 or a result past int64 / int64 refused by
# both.
provides ratio_add num an ad bn bd
logic    trebago ratio_add apps/blocks/tally/ratio_add.tb
logic    kron    ratio_add apps/blocks/tally/ratio_add.kron
provides ratio_sub num an ad bn bd
logic    trebago ratio_sub apps/blocks/tally/ratio_sub.tb
logic    kron    ratio_sub apps/blocks/tally/ratio_sub.kron
provides ratio_mul num an ad bn bd
logic    trebago ratio_mul apps/blocks/tally/ratio_mul.tb
logic    kron    ratio_mul apps/blocks/tally/ratio_mul.kron
provides ratio_div num an ad bn bd
logic    trebago ratio_div apps/blocks/tally/ratio_div.tb
logic    kron    ratio_div apps/blocks/tally/ratio_div.kron

# A currency amount at a rate (TL3): floor(amount * rnum / rden) whole
# minor units. Sutra and KRON, and the formula again in ALGOL 60, twin
# Rootwyrm; past Sutra's pictures held (Sutra and ALGOL refuse, KRON
# answers).
provides fx_amount num amount rnum rden
logic    sutra   fx_amount apps/blocks/tally/fx_amount.sutra
logic    kron    fx_amount apps/blocks/tally/fx_amount.kron
# ALGOL 60, twin Rootwyrm
logic    algol60 fx_amount apps/blocks/tally/fx_amount.alg

# What that conversion leaves over (TL4), in rden-ths of a minor unit,
# shown beside it: Sutra and KRON.
provides fx_rest num amount rnum rden
logic    sutra fx_rest apps/blocks/tally/fx_rest.sutra
logic    kron  fx_rest apps/blocks/tally/fx_rest.kron

# A quantity from one unit to another by exact factors (TL2), num/den
# vectors by unit index, the same dimension only: KRON, as the task asks.
provides unit_convert num qty src dst
logic    kron unit_convert apps/blocks/tally/unit.kron

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check ratio_add an=1,1,-1,0,999999999999999999 ad=3,2,3,5,1 bn=1,1,1,0,-999999999999999999 bd=6,3,3,7,1 = 1/2,5/6,0,0,0
check ratio_add an=1,1000000000000000000 ad=3,1 bn=1,0 bd=6,1 = both
check ratio_sub an=1,1,0,-7,999999999999999999 ad=3,2,1,4,1 bn=1,1,1,1,999999999999999999 bd=6,3,3,4,1 = 1/6,1/6,-1/3,-2,0
check ratio_sub an=1,1 ad=3,1 bn=1,-1000000000000000000 bd=6,1 = both
check ratio_mul an=1,2,-3,0,999999999999999999 ad=3,3,4,9,1 bn=3,9,4,5,1 bd=1,4,-3,7,999999999999999999 = 1,3/2,1,0,1
check ratio_mul an=1,1 ad=3,1000000000000000000 bn=3,1 bd=1,1 = both
check ratio_div an=1,2,-3,0,999999999999999999 ad=3,3,4,9,1 bn=1,4,3,5,999999999999999999 bd=3,9,-4,7,1 = 1,3/2,1,0,1
check ratio_div an=1,1 ad=3,1 bn=1,1 bd=6,1000000000000000000 = both
check fx_amount amount=1000 rnum=10873 rden=10000 = 1087
check fx_amount amount=0 rnum=1 rden=1 = 0
check fx_amount amount=999999999999 rnum=999999 rden=999999 = 999999999999
check fx_amount amount=999999999999 rnum=999999 rden=1 = 999998999999000001
check fx_amount amount=1 rnum=1 rden=3 = 0
check fx_amount amount=1000000000000 rnum=1 rden=1 = both
check fx_amount amount=-1 rnum=1 rden=1 = both
check fx_rest amount=1000,0,999999999999,1,100 rnum=10873,1,999999,1,2 rden=10000,1,999999,3,3 = 3000,0,0,1,2
check fx_rest amount=1,1000000000000 rnum=1,1 rden=3,3 = both
check unit_convert qty=1,1,5,3,1,1,1,2 src=4,7,12,20,5,16,0,19 dst=2,3,9,19,4,15,3,18 = 127/5000,25146/15625,45359237/20000,72,12,128,1/1000000,120
check pce_fin.npv cf=-100,110 rate_num=1 rate_den=10 = 0
check pce_fin.npv cf=-100,121 rate_num=1,0 rate_den=10,1 = 10,21
