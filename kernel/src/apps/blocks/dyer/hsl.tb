!
! A colour's hue, saturation or lightness from its red, green and blue
! (dyer_rules.h DY1), in Trebago, one colour a row: part 1 the hue in
! degrees 0..359, 2 the saturation and 3 the lightness in thousandths
! 0..1000, each to the nearest, a half up. With mx and mn the largest and
! smallest channel and d = mx - mn: lightness (200 (mx + mn) + 51) / 102;
! saturation (2000 d + den) / (2 den), den = 255 - |mx + mn - 255|; hue
! (2 y + d) / (2 d) mod 360, y = 360 d + 60 (g - b) when red is largest,
! 120 d + 60 (b - r) when green is, else 240 d + 60 (r - g); a grey (d = 0)
! is hue 0 and saturation 0. Trebago is exact and has no floor, so each
! floor is counted: of k = 1 to its top, those with k times the divisor at
! most the dividend, min(1, max(0, dividend - k divisor + 1)) for integers.
! ok is 0 for a channel outside 0..255 or a part outside 1..3, and the
! answer is divided by it: refused, where hsl.kron answers: held.
trebago rgb_to_hsl
  in  r(n), g(n), b(n), part(n)
  out v(n)
  var ok(n), mx(n), mn(n), d(n), z(n), dd(n), den(n), isr(n), isg(n), isb(n), y(n), hh(n), &
      ss(n), ll(n)
  ok(i) = min(1, max(0, r(i) + 1)) * min(1, max(0, 256 - r(i))) &
        * min(1, max(0, g(i) + 1)) * min(1, max(0, 256 - g(i))) &
        * min(1, max(0, b(i) + 1)) * min(1, max(0, 256 - b(i))) &
        * min(1, max(0, part(i))) * min(1, max(0, 4 - part(i)))
  mx(i) = max(r(i), g(i), b(i))
  mn(i) = min(r(i), g(i), b(i))
  d(i) = mx(i) - mn(i)
  z(i) = max(0, 1 - d(i))
  dd(i) = d(i) + z(i)
  den(i) = 255 - abs(mx(i) + mn(i) - 255) + z(i)
  isr(i) = max(0, 1 + r(i) - mx(i))
  isg(i) = (1 - isr(i)) * max(0, 1 + g(i) - mx(i))
  isb(i) = 1 - isr(i) - isg(i)
  y(i) = isr(i) * (360 * dd(i) + 60 * (g(i) - b(i))) + isg(i) * (120 * dd(i) + 60 * (b(i) - r(i))) &
       + isb(i) * (240 * dd(i) + 60 * (r(i) - g(i)))
  hh(i) = sum(k = 1:420, min(1, max(0, 2 * y(i) + dd(i) - 2 * k * dd(i) + 1)))
  hh(i) = hh(i) - 360 * min(1, max(0, hh(i) - 359))
  ss(i) = sum(k = 1:1000, min(1, max(0, 2000 * d(i) + den(i) - 2 * k * den(i) + 1)))
  ll(i) = sum(k = 1:1000, min(1, max(0, 200 * (mx(i) + mn(i)) + 51 - 102 * k + 1)))
  v(i) = (hh(i) * max(0, 1 - abs(part(i) - 1)) + ss(i) * max(0, 1 - abs(part(i) - 2)) &
       + ll(i) * max(0, 1 - abs(part(i) - 3))) / ok(i)
end
