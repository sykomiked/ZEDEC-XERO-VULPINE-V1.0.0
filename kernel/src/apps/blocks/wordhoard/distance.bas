10 REM THE EDIT DISTANCE OF TWO WORDS OVER CODE POINTS: THE LEAST
11 REM INSERTIONS, DELETIONS AND SUBSTITUTIONS OF ONE CODE POINT EACH.
12 REM EACH WORD IS FOUR NUMBERS OF THREE 21-BIT CODE POINTS, THE FIRST
13 REM HIGHEST; A FIELD OF 0 ENDS THE WORD. A NEGATIVE NUMBER, A FIELD
14 REM PAST 1114111 OR A CODE POINT AFTER THE END IS REFUSED. THE FIELDS
15 REM ARE HELD AS NUMBERS ONLY, SO A SURROGATE IS ANSWERED HERE.
20 DIM A(12), B(12), D(13), G(8), H(3)
30 INPUT P, Q, R, S, T, U, V, W
40 LET G(1) = P
41 LET G(2) = Q
42 LET G(3) = R
43 LET G(4) = S
44 LET G(5) = T
45 LET G(6) = U
46 LET G(7) = V
47 LET G(8) = W
50 LET M = 0
60 LET N = 0
70 LET E = 0
100 FOR K = 1 TO 8
110 LET X = G(K)
120 IF X < 0 THEN 900
130 IF K <> 5 THEN 200
140 LET E = 0
200 LET H(1) = INT(X / 4398046511104)
210 LET Y = X - H(1) * 4398046511104
220 LET H(2) = INT(Y / 2097152)
230 LET H(3) = Y - H(2) * 2097152
240 FOR J = 1 TO 3
250 LET C = H(J)
260 IF C = 0 THEN 340
270 IF E = 1 THEN 900
280 IF C > 1114111 THEN 900
290 IF K > 4 THEN 320
300 LET M = M + 1
305 LET A(M) = C
310 GOTO 350
320 LET N = N + 1
325 LET B(N) = C
330 GOTO 350
340 LET E = 1
350 NEXT J
360 NEXT K
400 FOR J = 0 TO N
410 LET D(J) = J
420 NEXT J
430 FOR I = 1 TO M
440 LET Z = D(0)
450 LET D(0) = I
460 FOR J = 1 TO N
470 LET O = D(J)
480 LET L = Z
490 IF A(I) = B(J) THEN 510
500 LET L = Z + 1
510 IF O + 1 >= L THEN 530
520 LET L = O + 1
530 IF D(J - 1) + 1 >= L THEN 550
540 LET L = D(J - 1) + 1
550 LET D(J) = L
560 LET Z = O
570 NEXT J
580 NEXT I
590 PRINT D(N)
600 GOTO 910
900 PRINT "REFUSED"
910 END
