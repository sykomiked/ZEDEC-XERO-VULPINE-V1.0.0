!
! Water for one bed for one week (dibber_rules.h DR1), in Trebago, one bed
! a row: the bed's area in square decimetres times the week's depth in
! millimetres is that many hundredths of a litre (a square metre under
! one millimetre holds one litre, and a square decimetre is a hundredth
! of a square metre), so the litres are area * depth / 100, an exact
! reduced rational, never rounded (a 3 dm2 bed under 1 mm is 3/100 l).
! area is 0 .. 999999 dm2 (just under a hectare) and depth 0 .. 999 mm a
! week: ok is 1 inside and 0 outside, and the answer is divided by it, so
! anything else is a division by zero, refused, where litres.kron
! answers: held.
trebago bed_water_litres
  in  area(n), depth(n)
  out litres(n)
  var ok(n)
  ok(i) = min(1, max(0, area(i) + 1)) * min(1, max(0, 1000000 - area(i))) &
        * min(1, max(0, depth(i) + 1)) * min(1, max(0, 1000 - depth(i)))
  litres(i) = area(i) * depth(i) / 100 / ok(i)
end
