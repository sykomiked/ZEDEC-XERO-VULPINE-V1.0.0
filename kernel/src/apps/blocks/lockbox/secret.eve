#
# A saved password inside Lockbox's limits (lockbox_rules.h LR3), in Eve,
# each count against its own range: 12 to 1024 bytes, 1 to 4 classes of
# character (lower case, upper case, digits, symbols) and 0 to 1023 bytes
# that repeat the one before them. Counts only, never the password.
eve lockbox
secret_length = 12 .. 1024
secret_classes = 1 .. 4
secret_repeats = 0 .. 1023

secret_limits {
  length: secret_length
  classes: secret_classes
  repeats: secret_repeats
}
