!
! How many peers are in one state (trellis_rules.h TL3), in Trebago: each
! row counts 1 when its state is want (both 1 + state - want and
! 1 + want - state are at least 1), else 0. States are 1 active, 2
! revoked, 3 waiting; bad counts the rows whose state or want is outside
! 1..3 (min(1, max(0, 1 - s)) is 1 exactly when s < 1, min(1, max(0,
! s - 3)) exactly when s > 3), and the sum is divided by 1 - min(1, bad):
! any state that is none is a division by zero, refused, never counted.
trebago peers_in_state
  in  state(n), want(n)
  out count
  var bad(n)
  bad(i) = min(1, max(0, 1 - state(i))) + min(1, max(0, state(i) - 3)) + min(1, max(0, 1 - want(i))) + min(1, max(0, want(i) - 3))
  count = sum(i, max(0, min(1, 1 + state(i) - want(i))) * max(0, min(1, 1 + want(i) - state(i)))) / (1 - min(1, sum(i, bad(i))))
end
