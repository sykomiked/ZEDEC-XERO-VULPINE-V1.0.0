#
# May this version go (cartulary_rules.h CR3), in Eve: its schedule is
# over (left, the days CR2 gives, is 0 or fewer, down to -9999999, the
# least Sutra's s9(7) holds), no hold is on its record (hold 0: a hold
# always wins), and keepsake.keep_ok says what stays is not nothing
# (keepok 1, that entry's answer as a flag). Each is held to its own
# range; prune.kron compares the same three.
eve cartulary
over_days = -9999999 .. 0
no_hold = 0 .. 0
keep_flag = 1 .. 1

version_prune {
  left: over_days
  hold: no_hold
  keepok: keep_flag
}
