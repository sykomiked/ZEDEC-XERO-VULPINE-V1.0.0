10 REM A TOKEN AMOUNT IN ZECKENDORF FORM: BIT K SET WHEN TIER K OF FACE
11 REM F(K+2) HOLDS A TOKEN, GREEDY FROM THE TOP. THE MASK HOLDS THE 63
12 REM TIERS BELOW F(65), SO AN AMOUNT PAST 17167680177564 IS REFUSED.
20 INPUT V
30 IF V < 0 THEN 300
40 IF V > 17167680177564 THEN 300
50 LET A = 1
60 LET B = 2
70 LET K = 0
80 LET P = 1
90 IF B > V THEN 160
100 LET T = A + B
110 LET A = B
120 LET B = T
130 LET K = K + 1
140 LET P = P * 2
150 GOTO 90
160 LET M = 0
170 IF A > V THEN 200
180 LET V = V - A
190 LET M = M + P
200 LET T = B - A
210 LET B = A
220 LET A = T
230 LET K = K - 1
240 IF K < 0 THEN 270
250 LET P = P / 2
260 GOTO 170
270 PRINT M
280 GOTO 310
300 PRINT "REFUSED"
310 END
