!
! A kit's installed size in bytes (toolchest_rules.h TC4), in Trebago: the
! exact sum of the files it puts on disk, each 0..999999999999 bytes. bad
! counts the files outside that range (min(1, max(0, -f)) is 1 exactly when
! f < 0, min(1, max(0, f - 999999999999)) exactly when f is past it), and
! the sum is divided by 1 - min(1, bad): any file outside is a division by
! zero, refused, never added.
trebago installed
  in  filebytes(n)
  out installed
  var bad(n)
  bad(i) = min(1, max(0, 0 - filebytes(i))) + min(1, max(0, filebytes(i) - 999999999999))
  installed = sum(i, filebytes(i)) / (1 - min(1, sum(i, bad(i))))
end
