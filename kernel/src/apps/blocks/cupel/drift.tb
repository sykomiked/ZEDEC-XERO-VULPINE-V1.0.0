!
! One leapfrog step of a position (cupel_rules.h CR3), in Trebago, one
! atom and axis a row: the kick, then the drift with the new velocity,
! x + (v + force * dt) * dt, exact. x is -1000000 .. 1000000 and v, force
! and dt as the kick takes them (kick.tb): ok is 1 inside them all and 0
! outside, and the answer is divided by it, so anything else is a
! division by zero, refused, where drift.kron answers: held.
trebago leapfrog_position
  in  x(n), v(n), force(n), dt(n)
  out xnew(n)
  var ok(n)
  ok(i) = min(1, max(0, x(i) + 1000001)) * min(1, max(0, 1000001 - x(i))) &
        * min(1, max(0, v(i) + 1000001)) * min(1, max(0, 1000001 - v(i))) &
        * min(1, max(0, force(i) + 1000001)) * min(1, max(0, 1000001 - force(i))) &
        * min(1, max(0, dt(i))) * min(1, max(0, 1001 - dt(i)))
  xnew(i) = (x(i) + (v(i) + force(i) * dt(i)) * dt(i)) / ok(i)
end
