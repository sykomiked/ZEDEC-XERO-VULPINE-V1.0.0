!
! Within a carrier's limits as a number to count with (caravan_rules.h
! CR4), in Trebago: 1 when every margin (the carrier's limit minus the
! parcel's measure) is at least 0 and inside its range, mass at most
! 999999999 g, the longest side at most 99999 mm and length plus girth at
! most 499995 mm, else 0. For integers min(1, max(0, m + 1)) is 1 exactly
! when m >= 0, and min(1, max(0, top - m + 1)) exactly when m <= top.
! fits_n.kron reads any margin at or above 0 as inside: a margin past its
! range is held.
trebago fits
  in  massleft(n), lengthleft(n), girthleft(n)
  out fits(n)
  fits(i) = min(1, max(0, massleft(i) + 1)) * min(1, max(0, 999999999 - massleft(i) + 1)) &
          * min(1, max(0, lengthleft(i) + 1)) * min(1, max(0, 99999 - lengthleft(i) + 1)) &
          * min(1, max(0, girthleft(i) + 1)) * min(1, max(0, 499995 - girthleft(i) + 1))
end
