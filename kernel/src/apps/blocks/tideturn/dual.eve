# Dual-signed (tideturn_rules.h TR2), in Eve: the only record that fits is
# both signatures checked and verified, each verify result exactly 1. A
# failed check (0), or a value that is no verify result at all, does not
# fit: not dual-signed, never installable.
eve tideturn
sig_verified = 1 .. 1

dual_signature {
  firstsig: sig_verified
  secondsig: sig_verified
}
