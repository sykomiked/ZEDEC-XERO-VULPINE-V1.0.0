#
# What a debugging session may hold (pawprint_rules.h PR4), in Eve: at
# most 256 breakpoints, and a stack view of at most 64 frames. Each is
# checked against its own range; nothing relates them.
eve pawprint
breakpoint_count = 0 .. 256
frame_count = 0 .. 64

debug_view {
  breakpoints: breakpoint_count
  frames: frame_count
}
