!
! The suite's verdict (whetstone_rules.h WR1), in Trebago: every result's
! four-valued verdict (lpres.h: NEITHER 0, TRUE 1, FALSE 2, BOTH 3)
! conjoined in the kernel's chain order F < N < B < T (lpres_conjoin), so
! the suite is the lowest of its results: FALSE when any result is FALSE,
! else NEITHER when any is NEITHER, else BOTH when any is BOTH, else TRUE.
! BOTH or NEITHER is never TRUE. Trebago has no min over a vector, so
! each kind is counted: [v = k] is max(0, min(1, 1 + v - k)) *
! max(0, min(1, 1 + k - v)) for integers, and f, u and b say whether a
! FALSE, a NEITHER or a BOTH was seen. bad counts a verdict outside 0..3,
! and the answer is divided by 1 - min(1, bad): refused, never read as
! one. verdict.kron ranks every value it is given: held.
trebago suite_verdict
  in  outcome(n)
  out verdict
  var f, u, b, bad
  f = min(1, sum(i, max(0, min(1, outcome(i) - 1)) * max(0, min(1, 3 - outcome(i)))))
  u = min(1, sum(i, max(0, min(1, 1 + outcome(i))) * max(0, min(1, 1 - outcome(i)))))
  b = min(1, sum(i, max(0, min(1, outcome(i) - 2)) * max(0, min(1, 4 - outcome(i)))))
  bad = sum(i, min(1, max(0, 0 - outcome(i))) + min(1, max(0, outcome(i) - 3)))
  verdict = (2 * f + (1 - f) * (1 - u) * (3 * b + (1 - b))) / (1 - min(1, bad))
end
