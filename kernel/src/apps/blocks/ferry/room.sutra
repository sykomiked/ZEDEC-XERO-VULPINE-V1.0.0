#
# Bytes left on the target after the move, in Sutra (ferry_rules.h FR1):
# what it may still write (avail) less the bytes the plan moves (need) and
# the bytes the owner keeps free (spare); below 0 the plan is that many
# bytes short. Each input fits 9(15): a negative or larger one is refused.
record target-room
  avail: 9(15)
  need: 9(15)
  spare: 9(15)
  room: s9(16)
procedure
  compute room = avail - need - spare
  answer room
