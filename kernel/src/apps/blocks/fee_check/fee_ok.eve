#
# The same limits in Eve: a payment of 1 cent to 10,000.00, a fee of at
# most 25.00 (amounts in cents).
eve fee_check
cents = 0 .. 100000000

fee_limits {
  amount: cents 1 .. 1000000
  fee: cents 0 .. 2500
}
