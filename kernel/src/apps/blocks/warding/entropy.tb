        + min(1, max(0, 1 - abs(alphabet(i) - 88))) * 6459 &
        + min(1, max(0, 1 - abs(alphabet(i) - 89))) * 6475 &
        + min(1, max(0, 1 - abs(alphabet(i) - 90))) * 6491 &
        + min(1, max(0, 1 - abs(alphabet(i) - 91))) * 6507 &
        + min(1, max(0, 1 - abs(alphabet(i) - 92))) * 6523 &
        + min(1, max(0, 1 - abs(alphabet(i) - 93))) * 6539 &
        + min(1, max(0, 1 - abs(alphabet(i) - 94))) * 6554 &
        + min(1, max(0, 1 - abs(alphabet(i) - 95))) * 6569 &
        + min(1, max(0, 1 - abs(alphabet(i) - 96))) * 6584 &
        + min(1, max(0, 1 - abs(alphabet(i) - 97))) * 6599
  m4(i) = min(1, max(0, 1 - abs(alphabet(i) - 98))) * 6614 &
        + min(1, max(0, 1 - abs(alphabet(i) - 99))) * 6629 &
        + min(1, max(0, 1 - abs(alphabet(i) - 100))) * 6643 &
        + min(1, max(0, 1 - abs(alphabet(i) - 101))) * 6658 &
        + min(1, max(0, 1 - abs(alphabet(i) - 102))) * 6672 &
        + min(1, max(0, 1 - abs(alphabet(i) - 103))) * 6686 &
        + min(1, max(0, 1 - abs(alphabet(i) - 104))) * 6700 &
        + min(1, max(0, 1 - abs(alphabet(i) - 105))) * 6714 &
        + min(1, max(0, 1 - abs(alphabet(i) - 106))) * 6727 &
        + min(1, max(0, 1 - abs(alphabet(i) - 107))) * 6741 &
        + min(1, max(0, 1 - abs(alphabet(i) - 108))) * 6754 &
        + min(1, max(0, 1 - abs(alphabet(i) - 109))) * 6768 &
        + min(1, max(0, 1 - abs(alphabet(i) - 110))) * 6781 &
        + min(1, max(0, 1 - abs(alphabet(i) - 111))) * 6794 &
        + min(1, max(0, 1 - abs(alphabet(i) - 112))) * 6807 &
        + min(1, max(0, 1 - abs(alphabet(i) - 113))) * 6820 &
        + min(1, max(0, 1 - abs(alphabet(i) - 114))) * 6832 &
        + min(1, max(0, 1 - abs(alphabet(i) - 115))) * 6845 &
        + min(1, max(0, 1 - abs(alphabet(i) - 116))) * 6857 &
        + min(1, max(0, 1 - abs(alphabet(i) - 117))) * 6870 &
        + min(1, max(0, 1 - abs(alphabet(i) - 118))) * 6882 &
        + min(1, max(0, 1 - abs(alphabet(i) - 119))) * 6894 &
        + min(1, max(0, 1 - abs(alphabet(i) - 120))) * 6906 &
        + min(1, max(0, 1 - abs(alphabet(i) - 121))) * 6918 &
        + min(1, max(0, 1 - abs(alphabet(i) - 122))) * 6930 &
        + min(1, max(0, 1 - abs(alphabet(i) - 123))) * 6942 &
        + min(1, max(0, 1 - abs(alphabet(i) - 124))) * 6954 &
        + min(1, max(0, 1 - abs(alphabet(i) - 125))) * 6965 &
        + min(1, max(0, 1 - abs(alphabet(i) - 126))) * 6977 &
        + min(1, max(0, 1 - abs(alphabet(i) - 127))) * 6988 &
        + min(1, max(0, 1 - abs(alphabet(i) - 128))) * 7000 &
        + min(1, max(0, 1 - abs(alphabet(i) - 129))) * 7011
  m5(i) = min(1, max(0, 1 - abs(alphabet(i) - 130))) * 7022 &
        + min(1, max(0, 1 - abs(alphabet(i) - 131))) * 7033 &
        + min(1, max(0, 1 - abs(alphabet(i) - 132))) * 7044 &
        + min(1, max(0, 1 - abs(alphabet(i) - 133))) * 7055 &
        + min(1, max(0, 1 - abs(alphabet(i) - 134))) * 7066 &
        + min(1, max(0, 1 - abs(alphabet(i) - 135))) * 7076 &
        + min(1, max(0, 1 - abs(alphabet(i) - 136))) * 7087 &
        + min(1, max(0, 1 - abs(alphabet(i) - 137))) * 7098 &
        + min(1, max(0, 1 - abs(alphabet(i) - 138))) * 7108 &
        + min(1, max(0, 1 - abs(alphabet(i) - 139))) * 7118 &
        + min(1, max(0, 1 - abs(alphabet(i) - 140))) * 7129 &
        + min(1, max(0, 1 - abs(alphabet(i) - 141))) * 7139 &
        + min(1, max(0, 1 - abs(alphabet(i) - 142))) * 7149 &
        + min(1, max(0, 1 - abs(alphabet(i) - 143))) * 7159 &
        + min(1, max(0, 1 - abs(alphabet(i) - 144))) * 7169 &
        + min(1, max(0, 1 - abs(alphabet(i) - 145))) * 7179 &
        + min(1, max(0, 1 - abs(alphabet(i) - 146))) * 7189 &
        + min(1, max(0, 1 - abs(alphabet(i) - 147))) * 7199 &
        + min(1, max(0, 1 - abs(alphabet(i) - 148))) * 7209 &
        + min(1, max(0, 1 - abs(alphabet(i) - 149))) * 7219 &
        + min(1, max(0, 1 - abs(alphabet(i) - 150))) * 7228 &
        + min(1, max(0, 1 - abs(alphabet(i) - 151))) * 7238 &
        + min(1, max(0, 1 - abs(alphabet(i) - 152))) * 7247 &
        + min(1, max(0, 1 - abs(alphabet(i) - 153))) * 7257 &
        + min(1, max(0, 1 - abs(alphabet(i) - 154))) * 7266 &
        + min(1, max(0, 1 - abs(alphabet(i) - 155))) * 7276 &
        + min(1, max(0, 1 - abs(alphabet(i) - 156))) * 7285 &
        + min(1, max(0, 1 - abs(alphabet(i) - 157))) * 7294 &
        + min(1, max(0, 1 - abs(alphabet(i) - 158))) * 7303 &
        + min(1, max(0, 1 - abs(alphabet(i) - 159))) * 7312 &
        + min(1, max(0, 1 - abs(alphabet(i) - 160))) * 7321 &
        + min(1, max(0, 1 - abs(alphabet(i) - 161))) * 7330
  m6(i) = min(1, max(0, 1 - abs(alphabet(i) - 162))) * 7339 &
        + min(1, max(0, 1 - abs(alphabet(i) - 163))) * 7348 &
        + min(1, max(0, 1 - abs(alphabet(i) - 164))) * 7357 &
        + min(1, max(0, 1 - abs(alphabet(i) - 165))) * 7366 &
        + min(1, max(0, 1 - abs(alphabet(i) - 166))) * 7375 &
        + min(1, max(0, 1 - abs(alphabet(i) - 167))) * 7383 &
        + min(1, max(0, 1 - abs(alphabet(i) - 168))) * 7392 &
        + min(1, max(0, 1 - abs(alphabet(i) - 169))) * 7400 &
        + min(1, max(0, 1 - abs(alphabet(i) - 170))) * 7409 &
        + min(1, max(0, 1 - abs(alphabet(i) - 171))) * 7417 &
        + min(1, max(0, 1 - abs(alphabet(i) - 172))) * 7426 &
        + min(1, max(0, 1 - abs(alphabet(i) - 173))) * 7434 &
        + min(1, max(0, 1 - abs(alphabet(i) - 174))) * 7442 &
        + min(1, max(0, 1 - abs(alphabet(i) - 175))) * 7451 &
        + min(1, max(0, 1 - abs(alphabet(i) - 176))) * 7459 &
        + min(1, max(0, 1 - abs(alphabet(i) - 177))) * 7467 &
        + min(1, max(0, 1 - abs(alphabet(i) - 178))) * 7475 &
        + min(1, max(0, 1 - abs(alphabet(i) - 179))) * 7483 &
        + min(1, max(0, 1 - abs(alphabet(i) - 180))) * 7491 &
        + min(1, max(0, 1 - abs(alphabet(i) - 181))) * 7499 &
        + min(1, max(0, 1 - abs(alphabet(i) - 182))) * 7507 &
        + min(1, max(0, 1 - abs(alphabet(i) - 183))) * 7515 &
        + min(1, max(0, 1 - abs(alphabet(i) - 184))) * 7523 &
        + min(1, max(0, 1 - abs(alphabet(i) - 185))) * 7531 &
        + min(1, max(0, 1 - abs(alphabet(i) - 186))) * 7539 &
        + min(1, max(0, 1 - abs(alphabet(i) - 187))) * 7546 &
        + min(1, max(0, 1 - abs(alphabet(i) - 188))) * 7554 &
        + min(1, max(0, 1 - abs(alphabet(i) - 189))) * 7562 &
        + min(1, max(0, 1 - abs(alphabet(i) - 190))) * 7569 &
        + min(1, max(0, 1 - abs(alphabet(i) - 191))) * 7577 &
        + min(1, max(0, 1 - abs(alphabet(i) - 192))) * 7584 &
        + min(1, max(0, 1 - abs(alphabet(i) - 193))) * 7592
  m7(i) = min(1, max(0, 1 - abs(alphabet(i) - 194))) * 7599 &
        + min(1, max(0, 1 - abs(alphabet(i) - 195))) * 7607 &
        + min(1, max(0, 1 - abs(alphabet(i) - 196))) * 7614 &
        + min(1, max(0, 1 - abs(alphabet(i) - 197))) * 7622 &
        + min(1, max(0, 1 - abs(alphabet(i) - 198))) * 7629 &
        + min(1, max(0, 1 - abs(alphabet(i) - 199))) * 7636 &
        + min(1, max(0, 1 - abs(alphabet(i) - 200))) * 7643 &
        + min(1, max(0, 1 - abs(alphabet(i) - 201))) * 7651 &
        + min(1, max(0, 1 - abs(alphabet(i) - 202))) * 7658 &
        + min(1, max(0, 1 - abs(alphabet(i) - 203))) * 7665 &
        + min(1, max(0, 1 - abs(alphabet(i) - 204))) * 7672 &
        + min(1, max(0, 1 - abs(alphabet(i) - 205))) * 7679 &
        + min(1, max(0, 1 - abs(alphabet(i) - 206))) * 7686 &
        + min(1, max(0, 1 - abs(alphabet(i) - 207))) * 7693 &
        + min(1, max(0, 1 - abs(alphabet(i) - 208))) * 7700 &
        + min(1, max(0, 1 - abs(alphabet(i) - 209))) * 7707 &
        + min(1, max(0, 1 - abs(alphabet(i) - 210))) * 7714 &
        + min(1, max(0, 1 - abs(alphabet(i) - 211))) * 7721 &
        + min(1, max(0, 1 - abs(alphabet(i) - 212))) * 7727 &
        + min(1, max(0, 1 - abs(alphabet(i) - 213))) * 7734 &
        + min(1, max(0, 1 - abs(alphabet(i) - 214))) * 7741 &
        + min(1, max(0, 1 - abs(alphabet(i) - 215))) * 7748 &
        + min(1, max(0, 1 - abs(alphabet(i) - 216))) * 7754 &
        + min(1, max(0, 1 - abs(alphabet(i) - 217))) * 7761 &
        + min(1, max(0, 1 - abs(alphabet(i) - 218))) * 7768 &
        + min(1, max(0, 1 - abs(alphabet(i) - 219))) * 7774 &
        + min(1, max(0, 1 - abs(alphabet(i) - 220))) * 7781 &
        + min(1, max(0, 1 - abs(alphabet(i) - 221))) * 7787 &
        + min(1, max(0, 1 - abs(alphabet(i) - 222))) * 7794 &
        + min(1, max(0, 1 - abs(alphabet(i) - 223))) * 7800 &
        + min(1, max(0, 1 - abs(alphabet(i) - 224))) * 7807 &
        + min(1, max(0, 1 - abs(alphabet(i) - 225))) * 7813
  m8(i) = min(1, max(0, 1 - abs(alphabet(i) - 226))) * 7820 &
        + min(1, max(0, 1 - abs(alphabet(i) - 227))) * 7826 &
        + min(1, max(0, 1 - abs(alphabet(i) - 228))) * 7832 &
        + min(1, max(0, 1 - abs(alphabet(i) - 229))) * 7839 &
        + min(1, max(0, 1 - abs(alphabet(i) - 230))) * 7845 &
        + min(1, max(0, 1 - abs(alphabet(i) - 231))) * 7851 &
