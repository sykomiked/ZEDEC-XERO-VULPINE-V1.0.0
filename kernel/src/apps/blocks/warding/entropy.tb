        + min(1, max(0, 1 - abs(alphabet(i) - 237))) * 7888 &
        + min(1, max(0, 1 - abs(alphabet(i) - 238))) * 7894 &
        + min(1, max(0, 1 - abs(alphabet(i) - 239))) * 7900 &
        + min(1, max(0, 1 - abs(alphabet(i) - 240))) * 7906 &
        + min(1, max(0, 1 - abs(alphabet(i) - 241))) * 7912 &
        + min(1, max(0, 1 - abs(alphabet(i) - 242))) * 7918 &
        + min(1, max(0, 1 - abs(alphabet(i) - 243))) * 7924 &
        + min(1, max(0, 1 - abs(alphabet(i) - 244))) * 7930 &
        + min(1, max(0, 1 - abs(alphabet(i) - 245))) * 7936 &
        + min(1, max(0, 1 - abs(alphabet(i) - 246))) * 7942 &
        + min(1, max(0, 1 - abs(alphabet(i) - 247))) * 7948 &
        + min(1, max(0, 1 - abs(alphabet(i) - 248))) * 7954 &
        + min(1, max(0, 1 - abs(alphabet(i) - 249))) * 7960 &
        + min(1, max(0, 1 - abs(alphabet(i) - 250))) * 7965 &
        + min(1, max(0, 1 - abs(alphabet(i) - 251))) * 7971 &
        + min(1, max(0, 1 - abs(alphabet(i) - 252))) * 7977 &
        + min(1, max(0, 1 - abs(alphabet(i) - 253))) * 7982 &
        + min(1, max(0, 1 - abs(alphabet(i) - 254))) * 7988 &
        + min(1, max(0, 1 - abs(alphabet(i) - 255))) * 7994 &
        + min(1, max(0, 1 - abs(alphabet(i) - 256))) * 8000
  x(i) = chars(i) * (m1(i) + m2(i) + m3(i) + m4(i) + m5(i) + m6(i) + m7(i) + m8(i))
  hi(i) = sum(k = 1:32, min(1, max(0, x(i) - k * 1000000 + 1)))
  lo(i) = sum(k = 1:999, min(1, max(0, x(i) - hi(i) * 1000000 - k * 1000 + 1)))
  bits(i) = (hi(i) * 1000 + lo(i)) * ok(i) / ok(i)
end
