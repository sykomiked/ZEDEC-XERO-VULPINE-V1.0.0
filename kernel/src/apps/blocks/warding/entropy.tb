!
! A key's entropy in whole bits, in Trebago (warding_rules.h WR4), one key
! per row, from two lengths only, never the key's bytes: chars, the key's
! length in symbols, 0..4096, and alphabet, how many symbols it is drawn
! from, 1..256. bits = floor(chars * lg / 1000), lg the integer table
! floor(1000 * log2(alphabet)) (the largest m with 2^m <= alphabet^1000,
! made exactly in integers), the table spelled as eight sums of rows with
! [alphabet = k] = min(1, max(0, 1 - abs(alphabet - k))). Trebago has no
! floor, so the quotient is counted: whole millions of the product first
! (at most 32), then whole thousands of the rest (at most 999), each the
! count of k with x - k * step >= 0, which min(1, max(0, ... + 1)) is for
! integers. ok is 0 for chars or alphabet outside its range, and the bits
! are divided by it: refused. entropy.kron answers any length: past 4096
! symbols the two disagree, held.
trebago entropy
  in  chars(n), alphabet(n)
  out bits(n)
  var ok(n), m1(n), m2(n), m3(n), m4(n), m5(n), m6(n), m7(n), m8(n), x(n), hi(n), lo(n)
  ok(i) = min(1, max(0, chars(i) + 1)) * min(1, max(0, 4096 - chars(i) + 1)) &
        * min(1, max(0, alphabet(i))) * min(1, max(0, 256 - alphabet(i) + 1))
  m1(i) = min(1, max(0, 1 - abs(alphabet(i) - 2))) * 1000 &
        + min(1, max(0, 1 - abs(alphabet(i) - 3))) * 1584 &
        + min(1, max(0, 1 - abs(alphabet(i) - 4))) * 2000 &
        + min(1, max(0, 1 - abs(alphabet(i) - 5))) * 2321 &
        + min(1, max(0, 1 - abs(alphabet(i) - 6))) * 2584 &
        + min(1, max(0, 1 - abs(alphabet(i) - 7))) * 2807 &
        + min(1, max(0, 1 - abs(alphabet(i) - 8))) * 3000 &
        + min(1, max(0, 1 - abs(alphabet(i) - 9))) * 3169 &
        + min(1, max(0, 1 - abs(alphabet(i) - 10))) * 3321 &
        + min(1, max(0, 1 - abs(alphabet(i) - 11))) * 3459 &
        + min(1, max(0, 1 - abs(alphabet(i) - 12))) * 3584 &
        + min(1, max(0, 1 - abs(alphabet(i) - 13))) * 3700 &
        + min(1, max(0, 1 - abs(alphabet(i) - 14))) * 3807 &
        + min(1, max(0, 1 - abs(alphabet(i) - 15))) * 3906 &
        + min(1, max(0, 1 - abs(alphabet(i) - 16))) * 4000 &
        + min(1, max(0, 1 - abs(alphabet(i) - 17))) * 4087 &
        + min(1, max(0, 1 - abs(alphabet(i) - 18))) * 4169 &
        + min(1, max(0, 1 - abs(alphabet(i) - 19))) * 4247 &
        + min(1, max(0, 1 - abs(alphabet(i) - 20))) * 4321 &
        + min(1, max(0, 1 - abs(alphabet(i) - 21))) * 4392 &
        + min(1, max(0, 1 - abs(alphabet(i) - 22))) * 4459 &
        + min(1, max(0, 1 - abs(alphabet(i) - 23))) * 4523 &
        + min(1, max(0, 1 - abs(alphabet(i) - 24))) * 4584 &
        + min(1, max(0, 1 - abs(alphabet(i) - 25))) * 4643 &
        + min(1, max(0, 1 - abs(alphabet(i) - 26))) * 4700 &
        + min(1, max(0, 1 - abs(alphabet(i) - 27))) * 4754 &
        + min(1, max(0, 1 - abs(alphabet(i) - 28))) * 4807 &
        + min(1, max(0, 1 - abs(alphabet(i) - 29))) * 4857 &
        + min(1, max(0, 1 - abs(alphabet(i) - 30))) * 4906 &
        + min(1, max(0, 1 - abs(alphabet(i) - 31))) * 4954 &
        + min(1, max(0, 1 - abs(alphabet(i) - 32))) * 5000 &
        + min(1, max(0, 1 - abs(alphabet(i) - 33))) * 5044
  m2(i) = min(1, max(0, 1 - abs(alphabet(i) - 34))) * 5087 &
        + min(1, max(0, 1 - abs(alphabet(i) - 35))) * 5129 &
        + min(1, max(0, 1 - abs(alphabet(i) - 36))) * 5169 &
        + min(1, max(0, 1 - abs(alphabet(i) - 37))) * 5209 &
        + min(1, max(0, 1 - abs(alphabet(i) - 38))) * 5247 &
        + min(1, max(0, 1 - abs(alphabet(i) - 39))) * 5285 &
        + min(1, max(0, 1 - abs(alphabet(i) - 40))) * 5321 &
        + min(1, max(0, 1 - abs(alphabet(i) - 41))) * 5357 &
        + min(1, max(0, 1 - abs(alphabet(i) - 42))) * 5392 &
        + min(1, max(0, 1 - abs(alphabet(i) - 43))) * 5426 &
        + min(1, max(0, 1 - abs(alphabet(i) - 44))) * 5459 &
        + min(1, max(0, 1 - abs(alphabet(i) - 45))) * 5491 &
        + min(1, max(0, 1 - abs(alphabet(i) - 46))) * 5523 &
        + min(1, max(0, 1 - abs(alphabet(i) - 47))) * 5554 &
        + min(1, max(0, 1 - abs(alphabet(i) - 48))) * 5584 &
        + min(1, max(0, 1 - abs(alphabet(i) - 49))) * 5614 &
        + min(1, max(0, 1 - abs(alphabet(i) - 50))) * 5643 &
        + min(1, max(0, 1 - abs(alphabet(i) - 51))) * 5672 &
        + min(1, max(0, 1 - abs(alphabet(i) - 52))) * 5700 &
        + min(1, max(0, 1 - abs(alphabet(i) - 53))) * 5727 &
        + min(1, max(0, 1 - abs(alphabet(i) - 54))) * 5754 &
        + min(1, max(0, 1 - abs(alphabet(i) - 55))) * 5781 &
        + min(1, max(0, 1 - abs(alphabet(i) - 56))) * 5807 &
        + min(1, max(0, 1 - abs(alphabet(i) - 57))) * 5832 &
        + min(1, max(0, 1 - abs(alphabet(i) - 58))) * 5857 &
        + min(1, max(0, 1 - abs(alphabet(i) - 59))) * 5882 &
        + min(1, max(0, 1 - abs(alphabet(i) - 60))) * 5906 &
        + min(1, max(0, 1 - abs(alphabet(i) - 61))) * 5930 &
        + min(1, max(0, 1 - abs(alphabet(i) - 62))) * 5954 &
        + min(1, max(0, 1 - abs(alphabet(i) - 63))) * 5977 &
        + min(1, max(0, 1 - abs(alphabet(i) - 64))) * 6000 &
        + min(1, max(0, 1 - abs(alphabet(i) - 65))) * 6022
  m3(i) = min(1, max(0, 1 - abs(alphabet(i) - 66))) * 6044 &
        + min(1, max(0, 1 - abs(alphabet(i) - 67))) * 6066 &
        + min(1, max(0, 1 - abs(alphabet(i) - 68))) * 6087 &
        + min(1, max(0, 1 - abs(alphabet(i) - 69))) * 6108 &
        + min(1, max(0, 1 - abs(alphabet(i) - 70))) * 6129 &
        + min(1, max(0, 1 - abs(alphabet(i) - 71))) * 6149 &
        + min(1, max(0, 1 - abs(alphabet(i) - 72))) * 6169 &
        + min(1, max(0, 1 - abs(alphabet(i) - 73))) * 6189 &
        + min(1, max(0, 1 - abs(alphabet(i) - 74))) * 6209 &
        + min(1, max(0, 1 - abs(alphabet(i) - 75))) * 6228 &
        + min(1, max(0, 1 - abs(alphabet(i) - 76))) * 6247 &
