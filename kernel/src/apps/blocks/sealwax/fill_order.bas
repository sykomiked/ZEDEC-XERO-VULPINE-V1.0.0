10 REM THE ORDER TO FILL A FORM IN: THE FIELDS NOT YET FILLED, REQUIRED
11 REM ONES FIRST, EACH GROUP BY ITS NUMBER. BIT K-1 OF R SAYS FIELD K IS
12 REM REQUIRED, OF F THAT IT IS FILLED. 0 WHEN NOTHING IS LEFT. 1 TO 32
13 REM FIELDS; A MASK BELOW ZERO OR PAST THE FIELDS IS REFUSED.
20 INPUT C, R, F
30 IF C < 1 THEN 300
40 IF C > 32 THEN 300
50 LET P = 2 ^ C
60 IF R < 0 THEN 300
70 IF R > P - 1 THEN 300
80 IF F < 0 THEN 300
90 IF F > P - 1 THEN 300
100 LET N = 0
110 LET W = 1
120 FOR K = 1 TO C
130 LET Q = 2 ^ (K - 1)
140 LET B = INT(R / Q) - INT(R / (2 * Q)) * 2
150 LET G = INT(F / Q) - INT(F / (2 * Q)) * 2
160 IF G = 1 THEN 200
170 IF B <> W THEN 200
180 PRINT K
190 LET N = N + 1
200 NEXT K
210 IF W = 0 THEN 240
220 LET W = 0
230 GOTO 120
240 IF N > 0 THEN 310
250 PRINT 0
260 GOTO 310
300 PRINT "REFUSED"
310 END
