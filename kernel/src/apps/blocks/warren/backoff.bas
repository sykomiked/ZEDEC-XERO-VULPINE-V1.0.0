10 REM WAIT IN SECONDS BEFORE EACH RESTART ATTEMPT, DOUBLED AND CAPPED
20 INPUT N, B, M
30 IF N < 1 THEN 200
40 IF N > 32 THEN 200
50 IF B < 1 THEN 200
60 IF B > 3600 THEN 200
70 IF M < 1 THEN 200
80 IF M > 86400 THEN 200
90 LET W = B
100 FOR K = 1 TO N
110 IF W < M THEN 130
120 LET W = M
130 PRINT W
140 LET W = W * 2
150 NEXT K
160 GOTO 210
200 PRINT "REFUSED"
210 END
