10 REM THE DAY OF THE WEEK OF A GREGORIAN DATE, 1 FOR MONDAY TO 7 FOR
11 REM SUNDAY, BY ZELLER'S CONGRUENCE (JANUARY AND FEBRUARY COUNTED AS
12 REM MONTHS 13 AND 14 OF THE YEAR BEFORE). THE DAY MUST BE IN ITS MONTH.
13 REM A NUMBER HERE HOLDS 18 DIGITS, SO A YEAR UP TO 999999999999999999
14 REM IS KEPT; BELOW 1 IS REFUSED.
20 INPUT Y, M, D
30 IF Y < 1 THEN 300
40 IF Y > 999999999999999999 THEN 300
50 IF M < 1 THEN 300
60 IF M > 12 THEN 300
70 LET N = M + INT(M / 8)
80 LET L = 30 + N - INT(N / 2) * 2
90 IF M <> 2 THEN 160
100 LET L = 28
110 IF Y - INT(Y / 4) * 4 <> 0 THEN 160
120 LET L = 29
130 IF Y - INT(Y / 100) * 100 <> 0 THEN 160
140 IF Y - INT(Y / 400) * 400 = 0 THEN 160
150 LET L = 28
160 IF D < 1 THEN 300
170 IF D > L THEN 300
180 LET K = Y
190 IF M > 2 THEN 220
200 LET M = M + 12
210 LET K = K - 1
220 LET H = D + INT(13 * (M + 1) / 5) + K + INT(K / 4) - INT(K / 100) + INT(K / 400)
230 LET H = H - INT(H / 7) * 7
240 LET H = H + 5
250 PRINT H - INT(H / 7) * 7 + 1
260 GOTO 310
300 PRINT "REFUSED"
310 END
