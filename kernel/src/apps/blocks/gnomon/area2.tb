!
! Twice a polygon's signed area by the shoelace formula (gnomon_rules.h
! GR1), in Trebago, exact. The vertices come one to a row, in order round
! the polygon, and the last joins the first: the sum over every side of
! x(i) * y(i + 1) - x(i + 1) * y(i). Counter-clockwise is positive,
! clockwise negative. Every coordinate is -1000000 .. 1000000:
! min(1, max(0, 0 - v - 1000000)) is 1 exactly when v < -1000000 and
! min(1, max(0, v - 1000000)) exactly when v > 1000000. bad counts those,
! and a polygon of fewer than 3 or more than 1024 vertices adds to it too;
! the sum is divided by 1 - min(1, all of them): any one is a division
! by zero, refused, never answered.
trebago polygon_area2
  in  x(n), y(n)
  out twice
  var bad(n)
  bad(i) = min(1, max(0, 0 - x(i) - 1000000)) + min(1, max(0, x(i) - 1000000)) &
         + min(1, max(0, 0 - y(i) - 1000000)) + min(1, max(0, y(i) - 1000000))
  twice = (sum(i = 1:n - 1, x(i) * y(i + 1) - x(i + 1) * y(i)) + x(n) * y(1) - x(1) * y(n)) &
        / (1 - min(1, sum(i, bad(i)) + max(0, 3 - n) + max(0, n - 1024)))
end
