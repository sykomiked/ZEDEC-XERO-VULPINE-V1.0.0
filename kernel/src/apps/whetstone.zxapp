#
# Whetstone, the build and test runner: layer 125 of the matrix (developer
# tools). Runs the targets of a plan and shows the verdict. zxvd has no
# build or test-run method, so a target is a Playground template run with
# play.run (on scratch state, never the books; four-valued verdict), the
# plan is a text file in the Hoard read with files.read, and each try is
# timed by zxvd's own clock (sys.info time_ms). zxvd has no notification
# method either: the model writes the notice text for the view (notify).
# Advisory: nothing here posts, pays or writes; changing a target's limits
# and clearing the kept runs wait for the owner's word. See
# whetstone_model.h WM1-WM5 and whetstone_rules.h WR1-WR8.
#
# Later layers use the verdict, the counts and the time (Swage, Fulgurite,
# Cleave), so every entry is general and registered in CONCEPTS.tsv with
# Whetstone as owner. Composed, not written again: the runs counted by
# verdict are witness.kind_count, and the share of the results that passed
# is assay.pass_share_x100. Colonnade (127) is built before this one, but
# its run limits hold a Playground run to a minute while a Whetstone try
# may take up to an hour (the task's 1..3600 s), so its play_limits_ok is
# not used and the timeout is Whetstone's own (WR5).
#
# Witness pairs are of one kind (zxapp.c run_one B3). Eve answers only
# truths, so the overall verdict is two entries of one meaning: the
# four-valued verdict conjoined in the kernel's chain order (lpres_conjoin,
# F < N < B < T, so BOTH or NEITHER is never TRUE) is a number, in KRON
# and Trebago witnessed; whether it is TRUE is a truth over the counts by
# verdict, in Eve and KRON witnessed. The model's C (whetstone_rules.h) is
# the third witness of each.
#
# Planned (no runtime yet): JCL owns jobs, and a target's retries and
# timeout are a batch job's limits (its TIME and restart): pending on
# test_retry_ok. Racket owns symbolic code, and the verdict is a symbolic
# fold of four truth values: pending on suite_verdict. F# already has a
# runtime in LANGUAGE_FIT.tsv (dotnet, the SDK host only), so a pending
# line is refused for it: none.
zxapp 1
id     whetstone
name   Whetstone
version 1.0.0
slot   125
layer  L1
matrix 125
icon   icons/l1/125-whetstone.svg
budget 233
needs  sys.read
needs  fs.read
needs  notify
model  apps/whetstone_model.c
use    witness 1   # @num.witness_kind_count
use    assay 1     # @num.assay_pass_share_x100

# The suite's verdict (WR1, critical): every result conjoined in the
# kernel's chain order. APL as KRON ranks each verdict and takes the
# least; FORTRAN as Trebago counts each kind; a verdict outside 0..3 is
# held (Trebago refuses, KRON ranks it as FALSE).
provides suite_verdict num outcome
logic    kron    suite_verdict apps/blocks/whetstone/verdict.kron
logic    trebago suite_verdict apps/blocks/whetstone/verdict.tb
pending  Racket suite_verdict

# The suite passed (WR2, critical): WR1's TRUE over the counts by verdict.
# Ada as Eve declares the one record that fits, APL as KRON reads the
# counts; a negative count or one past nine digits is held.
provides suite_passed truth passed failed held unknown
logic    eve  suite_passed apps/blocks/whetstone/passed.eve
logic    kron suite_passed apps/blocks/whetstone/passed.kron

# A run's results counted (WR3, critical): COBOL as Sutra refuses past
# 9(9), APL as KRON adds as it is: held.
provides test_result_sum num passed failed held
logic    sutra test_result_sum apps/blocks/whetstone/results.sutra
logic    kron  test_result_sum apps/blocks/whetstone/results.kron

# The suite's time (WR4), exact: FORTRAN as Trebago.
provides test_ms_total num ms
logic    trebago test_ms_total apps/blocks/whetstone/duration.tb

# Retry limits (WR5): at most 3 retries, 1..3600 s a try. Ada as Eve.
provides test_retry_ok truth retries timeout
logic    eve test_retry_ok apps/blocks/whetstone/retry.eve
pending  JCL test_retry_ok

# The run record (WR6): ^ZXWHET(run) = target ^ verdict ^ passed ^ failed
# ^ held ^ ms. MUMPS as MYRA.
provides test_record_ok truth run target verdict passed failed held ms
logic    myra test_record_ok apps/blocks/whetstone/record.myra

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check suite_verdict outcome=1,1,1 = 1
check suite_verdict outcome=1,3,1 = 3
check suite_verdict outcome=3,0,1 = 0
check suite_verdict outcome=0,2,3,1 = 2
check suite_verdict outcome=1,4 = both
check suite_verdict outcome=1,-1 = both
check suite_passed passed=1,999999999,0,5,5,5 failed=0,0,0,1,0,0 held=0,0,0,0,1,0 unknown=0,0,0,0,0,1 = true,true,false,false,false,false
check suite_passed passed=1,1000000000 failed=0,0 held=0,0 unknown=0,0 = both
check suite_passed passed=1,1 failed=0,-1 held=0,0 unknown=0,0 = both
check test_result_sum passed=0,1,999999999,5,0 failed=0,2,0,6,999999999 held=0,3,0,7,0 = 0,6,999999999,18,999999999
check test_result_sum passed=1,999999999 failed=0,1 held=0,0 = both
check test_result_sum passed=1,-1 failed=0,0 held=0,0 = both
check test_ms_total ms=0,1500,14400000 = 14401500
check test_ms_total ms=0,0 = 0
check test_retry_ok retries=0,3,4,-1,0,0,3 timeout=1,3600,60,60,0,3601,60 = true,true,false,false,false,false,true
check test_record_ok run=0,9999,10000,1,1,1 target=0,999,1,1000,1,1 verdict=1,3,1,1,10,2 passed=0,999999999,1,1,1,1 failed=0,999999999,1,1,1,1 held=0,999999999,1,1,1,1 ms=0,99999999,1,1,1,100000000 = true,true,false,false,false,false
# The runs counted by verdict, and the share of the results that passed
check witness.kind_count kind=1,2,1,3,0 want=1 = 2
check assay.pass_share_x100 passes=0,3,12 runs=4,4,12 = 0,7500,10000
