#
# Broadsheet, the document viewer: layer 42 of the matrix. A PDF in the
# Hoard is opened (files.read, base64), checked before anything else is
# read from it, fitted to the view, annotated and printed (print.status,
# print.submit). Annotations go to a separate file beside the original,
# "<name>.pdf.notes" (files.write), never into it; the PDF itself is never
# written. The owner chooses the printer and the copies, and zxvd prints
# the file as it is, so the annotations are not printed with it (zxvd
# does not convert documents, zxv_print_host.h N5).
#
# A document is well formed when its header is present and every
# cross-reference offset it gives (startxref, each in-use entry of every
# cross-reference table, each /Prev) lies inside the file; a malformed
# file is refused and nothing more is read from it (broadsheet_model.h
# BM2). Finding the offsets in the file's text stays in C: it is text
# work, and no runnable language owns text.
#
# Witness pairs are of one kind, since a witnessed call compares answers
# exactly and a truth entry refuses a number (zxapp.c run_one B3). Eve
# answers truths only (zxapp_eve.c EV2) and WebAssembly numbers only
# (zxapp_wasm.c W2), so the task's "Rust wasm + Eve" is split, as
# Gatehouse, Signpost and Sundial split theirs: Eve and KRON witness
# whether an offset is well formed (well_formed), Rust and KRON why it is
# not (form_fault), one offset a row. Eve checks each field against its own
# range, so the relation of offset to size comes as room, the size less
# the offset. The task's zoom to fit in KRON changes what the owner sees,
# so Sutra is its second witness; the annotation record in MYRA has Eve as
# its witness for the kinds and ranges MYRA's digits do not hold.
#
# Its layer leans on no other layer's code, and nothing built before it
# answers what it needs: typecase.font_ok accepts a font's tables by
# offset + length against a 32 MiB file of 1..256 tables, not a
# document's offsets against zxvd's 256 MiB, and folio's page rules lay
# lines on a page in twips rather than fit a page in a view. So nothing is
# used. The well formed rule, its fault, the zoom to fit and the
# annotation record are general (a picture viewer fits a page too, and any
# file format with offsets is checked the same way), so each is a concept
# with Broadsheet as its owner (CONCEPTS.tsv).
#
# Defaults taken (broadsheet_model.h): the page size is the first
# /MediaBox in the file's first 8 KiB, its fraction dropped, else US
# Letter (612 x 792 points); a point is 4/3 of a pixel (96 pixels an
# inch). zxvd's largest file (256 MiB) bounds every offset, and a read is
# at most 49152 bytes, so the file is read in windows of 8 KiB.
#
# Planned: Perl (text munging and regular expressions) stands for
# well_formed, whose offsets are found by matching the file's text, and
# PostScript (exact page description) for fit_zoom, a page's box placed in
# a view. TeX (typesetting) has no entry here: Broadsheet sets no type, it
# shows pages already set, so TeX is not pending.
zxapp 1
id     broadsheet
name   Broadsheet
version 1.0.0
slot   42
layer  L1
matrix 42
icon   icons/l1/042-broadsheet.svg
budget 233
needs  fs.read
needs  fs.write
needs  print
model  apps/broadsheet_model.c

# One cross-reference offset is well formed (BR1): the header present
# (header 1), the offset 0..268435455 and room (size - offset)
# 1..268435456. Eve and KRON; KRON reads any header above 0 as present and
# holds no upper bound, so a header that is no flag, or an offset past
# zxvd's largest file, is held.
provides well_formed truth header off room
logic    eve  well_formed apps/blocks/broadsheet/well_formed.eve
logic    kron well_formed apps/blocks/broadsheet/well_formed.kron
pending  Perl well_formed

# Why it is not (BR2): 1 no header, 2 outside the file, 0 none. Rust (as
# WebAssembly) and KRON; Rust traps on a header that is no flag or an
# offset past zxvd's largest file, KRON answers: held.
provides form_fault num header off room
logic    wasm form_fault apps/blocks/broadsheet/form_fault.wasm
logic    kron form_fault apps/blocks/broadsheet/form_fault.kron

# The zoom that fits a page in a view (BR3), x100, floored. KRON and Sutra;
# Sutra refuses a side past 9(5), KRON answers: held.
provides fit_zoom num pagew pageh vieww viewh
logic    kron  fit_zoom apps/blocks/broadsheet/fit_zoom.kron
logic    sutra fit_zoom apps/blocks/broadsheet/fit_zoom.sutra
pending  PostScript fit_zoom

# An annotation fits its record ^ZXBROAD (BR4): MYRA holds the digits, Eve
# the kinds and the ranges.
provides note_ok truth note page x y kind stamp
logic    myra note_ok apps/blocks/broadsheet/note.myra
logic    eve  note_ok apps/blocks/broadsheet/note.eve

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check well_formed header=1,1,1,1,0,1,1,1 off=0,268435455,0,4999,0,-1,5000,5001 room=1,1,268435456,1,5000,5001,0,-1 = true,true,true,true,false,false,false,false
check well_formed header=1,2 off=0,0 room=10,10 = both
check well_formed header=1,1 off=0,268435456 room=10,1 = both
check form_fault header=1,1,1,0,0,1,1,1 off=0,268435455,4999,0,-1,-1,5000,5001 room=1,1,1,5000,5001,5001,0,-1 = 0,0,0,1,1,2,2,2
check form_fault header=1,2 off=0,0 room=10,10 = both
check form_fault header=1,1 off=0,0 room=10,268435457 = both
check fit_zoom pagew=816,816,1,99999,816,1056,3 pageh=1056,1056,1,99999,1056,816,7 vieww=816,1600,99999,0,408,99999,2 viewh=1056,900,99999,99999,1056,99999,5 = 10000,8522,999990000,0,5000,946960,6666
check fit_zoom pagew=816,816 pageh=1056,1056 vieww=816,100000 viewh=1056,1056 = both
check note_ok note=1,9999,10000,1,1,1,1,1 page=1,999999,1,1000000,1,1,1,1 x=0,99999,0,0,100000,0,0,0 y=0,99999,0,0,0,0,0,0 kind=1,3,1,1,1,10,2,1 stamp=0,999999999999999,0,0,0,0,1700000000000,1000000000000000 = true,true,false,false,false,false,true,false
check note_ok note=1,1 page=1,1 x=0,0 y=0,0 kind=1,4 stamp=0,0 = both
check note_ok note=1,0 page=1,1 x=0,0 y=0,0 kind=1,1 stamp=0,0 = both
