#
# Cupel, the simulation bench: L2, slot 179. A model (atoms in molecules,
# springs between pairs of them) is a text file in the Hoard (files.read,
# files.write), stepped on the integer engine by the leapfrog method and
# measured as it goes; two models' energies after the same steps are
# compared, and every run is kept in the Hoard as Cupel's record and
# Retort's. Machine facts (arch, cpus, memory) and a run's wall-clock
# seconds come from sys.info. See cupel_model.h CM1-CM8 and cupel_rules.h
# CR1-CR10. Saving a model and recording a run take the owner's word.
#
# Units (a default taken, CR intro): reduced units, as Lennard-Jones runs
# use, every particle's mass the unit, so a force is an acceleration and a
# step divides nothing; positions, velocities and forces are integers in
# 1/scale of a length unit, dt whole ticks. Nothing is a float.
#
# Composed, not written again (four uses of ZXAPP_USES 8; its own 11 logic
# lines and its parts' 32 are 43 of ZXAPP_LOGIC_MAX 128): the
# energy of molecules lo..hi is furrow.range_total over each atom's and
# each spring's energy; an atom on the screen is relief.vertex_screen_x
# and relief.vertex_screen_y, and a model is drawn while relief.mesh_limits_ok
# holds for its atoms (vertices) and pairs (faces); each model's score
# over its runs is retort.model_score_total, a run's limits are
# retort.run_limits_ok (prompt: its note's bytes, fuel: steps times atoms
# and pairs, seconds: the owner's limit) and its contestant record is
# retort.run_record_ok; a lattice face's area is gnomon.triangle_area2
# (twice its half triangle) and every squared length (a velocity's, a
# spring's stretch) is gnomon.side_len_sq, axis pair by axis pair.
#
# matrix: zxapp.c takes 0..144 and slot 179 is no matrix layer; an L2 app
# sits on the layer of its part outermost in MATRIX_ORDER.tsv: Gnomon
# (place 104, layer 107), past Furrow (63), Retort (40) and Relief (25).
#
# Witness pairs are of one kind: the step (pair_force_net,
# leapfrog_velocity, leapfrog_position) is FORTRAN as Trebago and APL as
# KRON, numbers both; the precision bounds are Ada as Eve and APL as KRON,
# truths both. Eve checks each field against its own range only, so the
# bounds are given as the scale and two gaps (steps left, the drift's
# room), worked out by the model (cupel_precision_gaps). The model's C
# (cupel_rules.h) is each pair's third witness.
#
# Later layers take the step, the bounds and the lattice with "use cupel
# 1", so each is registered in CONCEPTS.tsv with Cupel as owner. Kept in
# C: text (a model's lines, notes), zxvd's answers, the springs' forces
# (CR8, floored) and the four-valued join of two models' energies
# (lpres_kjoin, CR9).
#
# Planned (no runtime yet): Simula 67 owns simulation with classes, and a
# step of a position is the simulation here: pending on
# leapfrog_position. Python has a runtime (python in LANGUAGE_FIT.tsv),
# so it is not pending; it owns scripting and AI, and Cupel has no entry
# of either kind.
zxapp 1
id     cupel
name   Cupel
version 1.0.0
slot   179
layer  L2
matrix 107
icon   icons/l2/179-cupel.svg
budget 233
needs  fs.read
needs  fs.write
needs  sys.read
model  apps/cupel_model.c
use    furrow 1   # @num.furrow_range_total
use    relief 1   # @num.relief_vertex_screen_x @num.relief_vertex_screen_y @logic.relief_mesh_limits_ok
use    retort 1   # @num.retort_model_score_total @logic.retort_run_limits_ok @logic.retort_run_record_ok
use    gnomon 1   # @num.gnomon_triangle_area2 @num.gnomon_side_len_sq
# what it exports, so apps built from it can use them too (C1)
provides furrow.range_total num pos lo hi cell
provides relief.vertex_screen_x num x z cos sin scale focal
provides relief.vertex_screen_y num x y z cos sin scale focal
provides relief.mesh_limits_ok truth vertices faces
provides retort.model_score_total num model want score
provides retort.run_limits_ok truth prompt fuel seconds
provides retort.run_record_ok truth run model kind prompt fuel ms score uj
provides gnomon.triangle_area2 num ax ay bx by cx cy
provides gnomon.side_len_sq num ax ay bx by

# The net force on one atom from the pair table (CR1, critical): FORTRAN
# as Trebago and APL as KRON; a force past 10^6 is held (Trebago refuses
# the table, KRON adds it).
provides pair_force_net num want p q force
logic    trebago pair_force_net apps/blocks/cupel/force.tb
logic    kron    pair_force_net apps/blocks/cupel/force.kron

# One integer leapfrog step (CR2, CR3, critical): the kick (the half-step
# velocity) and the drift (the new position). FORTRAN as Trebago and APL
# as KRON; outside Trebago's domain it refuses, KRON answers: held.
provides leapfrog_velocity num v force dt
logic    trebago leapfrog_velocity apps/blocks/cupel/kick.tb
logic    kron    leapfrog_velocity apps/blocks/cupel/kick.kron
provides leapfrog_position num x v force dt
logic    trebago leapfrog_position apps/blocks/cupel/drift.tb
logic    kron    leapfrog_position apps/blocks/cupel/drift.kron
pending  Simula_67 leapfrog_position

# Precision bounds (CR4, critical): the scale, the steps left and the
# drift's room. Ada as Eve declares each range, APL as KRON compares; past
# a range it is held (Eve FALSE, KRON TRUE). A run that fails them halts.
provides sim_precision_ok truth scale stepgap driftgap
logic    eve  sim_precision_ok apps/blocks/cupel/bounds.eve
logic    kron sim_precision_ok apps/blocks/cupel/bounds.kron

# Lattice arrays (CR5): a periodic cubic lattice's site, APL as KRON.
provides lattice_site_index num ix iy iz side
logic    kron lattice_site_index apps/blocks/cupel/lattice.kron

# The model tree (CR6) and a run's record (CR7), MUMPS as MYRA.
provides sim_tree_node_ok truth model molecule atom element x y z
logic    myra sim_tree_node_ok apps/blocks/cupel/tree.myra
provides sim_run_record_ok truth run model steps energy drift halted
logic    myra sim_run_record_ok apps/blocks/cupel/run.myra

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check pair_force_net want=1 p=1,2,1,3 q=2,1,3,1 force=10,-4,7,5 = 16
check pair_force_net want=2 p=1,2,3,4 q=2,3,2,5 force=1000000,-1000000,999999,8 = -2999999
check pair_force_net want=1 p=1,2 q=2,1 force=1000001,0 = both
check leapfrog_velocity v=0,5,-1000000,1000000,7 force=0,-3,1000000,-1000000,2 dt=1,10,1000,1000,1 = 0,-25,999000000,-999000000,9
check leapfrog_velocity v=0,1000001 force=0,0 dt=1,1 = both
check leapfrog_velocity v=1,1 force=1,1 dt=1,0 = both
check leapfrog_position x=0,100,-1000000,1000000,5 v=0,10,0,0,-3 force=0,-1,1000000,-1000000,1 dt=1,2,1000,1000,1 = 0,116,999999000000,-999999000000,3
check leapfrog_position x=0,1000001 v=0,0 force=0,0 dt=1,1 = both
check sim_precision_ok scale=1,1000000,0,1000,1000,1000 stepgap=0,1000000,5,-1,5,5 driftgap=0,9999999999999999,5,5,-1,0 = true,true,false,false,false,true
check sim_precision_ok scale=1000,1000001 stepgap=1,1 driftgap=1,1 = both
check sim_precision_ok scale=1000,1000 stepgap=1,1000001 driftgap=1,1 = both
check lattice_site_index ix=0,1,-1,7,8,3,0,0 iy=0,0,0,7,0,2,-9,0 iz=0,0,0,7,0,1,-1,0 side=8,8,8,8,8,4,4,1 = 0,64,448,511,0,57,15,0
check sim_tree_node_ok model=1,99,100,1,1,1,1 molecule=1,9999,1,10000,1,1,1 atom=0,999,0,0,1000,0,0 element=1,118,1,1,1,1000,1 x=0,9999999,0,0,0,0,10000000 y=0,-9999999,0,0,0,0,0 z=0,1000000,0,0,0,0,0 = true,true,false,false,false,false,false
check sim_run_record_ok run=0,999,1000,1,1,1,1,1 model=1,99,1,100,1,1,1,1 steps=0,9999999,0,0,10000000,0,0,0 energy=0,999999999999999999,0,0,0,1000000000000000000,0,0 drift=0,999999999999999999,0,0,0,0,1000000000000000000,0 halted=0,1,0,0,0,0,0,10 = true,true,false,false,false,false,false,false
# Molecules' energy, an atom on the screen, and a model's size to draw
check furrow.range_total pos=1,2,3,4,5 lo=2,2,2,2,2 hi=4,4,4,4,4 cell=10,20,30,40,50 = 90
check furrow.range_total pos=1,1,1 lo=1,1,1 hi=1,1,1 cell=9223372036854775807,1,-1 = both
check relief.vertex_screen_x x=1000,1000,-1,100000,0 z=0,1000,0,100000,-100000 cos=4096,0,4096,4096,4096 sin=0,4096,0,4096,0 scale=100,100,50,1000,100 focal=1000,2000,1000,1000000,100001 = 1000,2000,-1,2000000,0
check relief.vertex_screen_x x=1000,100001 z=0,0 cos=4096,4096 sin=0,0 scale=100,100 focal=1000,1000 = both
check relief.vertex_screen_y x=1000,1000,-1,100000,0 y=-1000,500,-1,100000,7 z=0,1000,0,100000,-100000 cos=4096,0,4096,4096,4096 sin=0,4096,0,4096,0 scale=100,100,50,1000,100 focal=1000,2000,1000,1000000,100001 = -1000,1000,-1,1000000,700007
check relief.vertex_screen_y x=0,0 y=10,10 z=0,0 cos=4096,4096 sin=0,0 scale=100,1001 focal=1000,1000 = both
check relief.mesh_limits_ok vertices=4,512,3,513,4,4 faces=4,1020,4,4,3,1021 = true,true,false,false,false,false
# Each model's score over its runs, a run's limits and its contestant record
check retort.model_score_total model=1,2,1,3,1 want=1 score=50,70,100,0,0 = 150
check retort.model_score_total model=1,2 want=1 score=50,101 = both
check retort.run_limits_ok prompt=1,4095,0,4096,100,100,100,100 fuel=1,999999999999999999,1,1,0,1000000000000000000,5,5 seconds=1,3600,1,1,1,1,0,3601 = true,true,false,false,false,false,false,false
check retort.run_record_ok run=0,999,1000,1,1,1,1,1 model=0,99,0,100,0,0,0,7 kind=0,2,0,0,10,0,0,1 prompt=0,4095,0,0,0,10000,0,12 fuel=0,999999999999999999,0,0,0,0,0,5 ms=0,9999999,0,0,0,0,10000000,120 score=0,100,0,0,0,0,0,-1 uj=0,999999999999999999,0,0,0,0,0,3 = true,true,false,false,false,false,false,true
# A lattice face's area (twice its half triangle) and a squared length
check gnomon.triangle_area2 ax=0,0,0,-1000000,5 ay=0,0,0,-1000000,5 bx=1,0,2,1000000,5 by=0,1,2,-1000000,5 cx=0,1,4,1000000,5 cy=1,0,4,1000000,5 = 1,-1,0,4000000000000,0
check gnomon.triangle_area2 ax=0,1000001 ay=0,0 bx=1,0 by=0,0 cx=0,0 cy=1,1 = both
check gnomon.side_len_sq ax=0,0,-1000000,7 ay=0,0,-1000000,7 bx=3,0,1000000,7 by=4,0,1000000,7 = 25,0,8000000000000,0
check gnomon.side_len_sq ax=0,0 ay=0,-1000001 bx=3,0 by=4,0 = both
