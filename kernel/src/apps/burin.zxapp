#
# Burin, vector drawing and engraving-style art: layer 54 of the matrix.
# A drawing is stroked paths (lines and cubic curves) on a page, shaded
# with hatch lines the way an engraver shades, kept as a text file in the
# Hoard (files.read, files.write) and printed as a one-page PDF
# (print.submit). Lengths are hundredths of a point (burin_rules.h).
#
# Its layer leans on no other layer's code yet, and nothing nearer the
# core fits: flint.cells counts whole cells across at most 65535 pixels
# (a hatch span runs to 9999999 and its lines sit strictly inside it, one
# fewer than the cells), hollow.tile_cell floors a split of at most 16384
# pixels into 64 parts where a hatch spacing is an exact fraction, and no
# block draws curves. So its entries are general rules owned here
# (CONCEPTS.tsv), for any later layer that draws, plots or cuts:
#
#   bezier_at          one coordinate of a cubic curve at step / steps, by
#                      de Casteljau in fixed point, floored (BR1). C++ (as
#                      WebAssembly) and KRON are witnessed: the C++ refuses
#                      a point, step or step count outside its domain with
#                      -1000001, where KRON still answers: held.
#   hatch_lines        how many hatch lines a span takes at a spacing,
#                      strictly inside it (BR2): Trebago counts the floor,
#                      KRON floors; Trebago refuses a span or gap outside
#                      its domain, KRON answers: held.
#   hatch_gap          the exact spacing for a count of lines set evenly
#                      (BR3), span / (lines + 1): Trebago and KRON, both
#                      exact rationals; Trebago refuses a count outside
#                      1..9999 (a count of 0 is the whole span in KRON):
#                      held.
#   path_limits_ok     what a path may be (BR4): points, page and stroke,
#                      each against its own range, so Eve alone.
#   drawing_record_ok  a path's record in MYRA (^ZXBURIN, BR5).
#
# The task names Logo (twin Kiteling) for geometry, joined to another
# language's line. It is not used: Lingua's Logo refuses readword and
# readlist (zl_logo.c), so a Logo program cannot read an entry's arguments
# (zxapp_lingua.c L1), and a Logo block could only print constants. The
# geometry stays in C++ and KRON until Logo reads its inputs.
#
# Planned: APT owns numerical-control tool paths, and the flattened curve
# is what an engraving tool follows, so it waits on bezier_at. LabVIEW
# owns dataflow and signal work; Burin has no entry of that kind.
zxapp 1
id     burin
name   Burin
version 1.0.0
slot   54
layer  L1
matrix 54
icon   icons/l1/054-burin.svg
budget 233
needs  fs.read
needs  fs.write
needs  print
model  apps/burin_model.c

provides bezier_at num pa pb pc pd step steps
logic    wasm bezier_at apps/blocks/burin/bezier.wasm
logic    kron bezier_at apps/blocks/burin/bezier.kron
pending  APT bezier_at

provides hatch_lines num span gap
logic    trebago hatch_lines apps/blocks/burin/hatch_lines.tb
logic    kron    hatch_lines apps/blocks/burin/hatch_lines.kron

provides hatch_gap num span lines
logic    trebago hatch_gap apps/blocks/burin/hatch_gap.tb
logic    kron    hatch_gap apps/blocks/burin/hatch_gap.kron

provides path_limits_ok truth points width height stroke
logic    eve path_limits_ok apps/blocks/burin/path.eve

provides drawing_record_ok truth path points stroke mtime
logic    myra drawing_record_ok apps/blocks/burin/record.myra

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check bezier_at pa=0,0,0,-1000000,0,0 pb=100,0,0,1000000,0,0 pc=200,0,0,1000000,100,0 pd=300,1,-1,1000000,100,1000000 step=1,1,1,0,1,1024 steps=3,2,2,1024,2,1024 = 100,0,-1,-1000000,50,1000000
check bezier_at pa=0,2000000 pb=0,0 pc=0,0 pd=0,0 step=1,1 steps=2,2 = both
check bezier_at pa=0,0 pb=0,0 pc=0,0 pd=8,8 step=1,1 steps=2,2000 = both
check hatch_lines span=0,1,100,99,101,9999999 gap=10,10,20,20,20,1 = 0,0,4,4,5,9999998
check hatch_lines span=100,-5 gap=20,20 = both
check hatch_lines span=100,10000000 gap=20,20 = both
check hatch_gap span=100,0,7,9999999 lines=4,1,2,9999 = 20,0,7/3,9999999/10000
check hatch_gap span=100,100 lines=4,0 = both
check path_limits_ok points=2,769,1,770,2,2,2,2,2 width=1,1000000,1,1,0,1000001,1,1,1 height=1,1000000,1,1,1,1,0,1,1 stroke=1,10000,1,1,1,1,1,0,10001 = true,true,false,false,false,false,false,false,false
check drawing_record_ok path=999999999,1000000000,0,0,0 points=999,1,1000,1,1 stroke=99999,1,1,100000,1 mtime=999999999999,1,1,1,1000000000000 = true,false,false,false,false
