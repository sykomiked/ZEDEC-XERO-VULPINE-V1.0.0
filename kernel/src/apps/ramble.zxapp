#
# Ramble, the Web4 viewer: layer 25 of the matrix. The owner's envelope
# feed (web4.open, web4.feed), a signed envelope's bytes and their check
# (web4.envelope, web4.verify), content by its CID (web4.cid, aipi.get),
# agent cards (web4.card_verify), and the envelopes Chiglet holds for the
# owner's consent (web4.consent). What an account would hold after a held
# envelope's money left it is read from the books (ledger.balance).
#
# Advisory and owner-confirmed: Ramble never grants or denies consent by
# itself. web4.consent is called only on the owner's confirmed word, and a
# grant with money is the owner's act; a grant covers its own envelope's
# scope and amount and nothing more (ramble_model.h RM3). zxvd has no
# notification method, so the notice of a held envelope is only composed
# (RM6); it has no method that fetches a page over HTTP, delivers an
# envelope to another companion, or gives back a grant's expiry, and none
# is invented.
#
# Built on what is nearer the core: the CID string check is Seedbank's
# cid_byte, the same rule (prefix "b", 59 bytes, base32 lower case, as byte
# codes; Rust as WebAssembly and KRON witnessed), used as it is; the
# balance after a held envelope's amount is Reckoner's statement_close,
# with the amount as the one debit. Caravan, which the task also names,
# keeps parcels, carriers and shipments: Ramble moves no parcel, so none of
# its entries is used.
#
# Two later layers lean on this one, so both of its own entries are general
# rules registered in CONCEPTS.tsv with Ramble as owner: whether a granted
# consent covers an action, and an envelope's index record.
#
# Witness pairs are of one kind: consent_covers is a truth over three
# margins, each checked against its own range, which is what Eve holds;
# Sutra witnesses it, refusing a margin past its picture where Eve answers
# no: held. The envelope index is MYRA's alone, as the task asks.
#
# Kept in C, since no runnable language owns it: base32 and base58 text of
# a CID (RM4), hex, and reading zxvd's answers.
#
# Planned languages: Gleam (messaging, types) stands for the envelope's
# typed record, pending below. Dart (view) has a runtime outside the
# kernel; Ramble's view is not built here, so it decides nothing of that
# kind and has no Dart entry. Occam (concurrency) has no entry of its kind
# here: Ramble runs nothing in parallel. No pending line for either.
zxapp 1
id     ramble
name   Ramble
version 1.0.0
slot   25
layer  L1
matrix 25
icon   icons/l1/025-ramble.svg
budget 233
needs  net
needs  ledger.read
needs  notify
model  apps/ramble_model.c
use    seedbank 1   # @num.seedbank_cid_byte
use    reckoner 1   # @num.reckoner_statement_close

# A granted consent covers an action (RR1): no scope missing, the amount
# within the ceiling, not expired and no longer than zxvd grants. Eve's
# ranges, witnessed by Sutra; a margin past Sutra's picture is held.
provides consent_covers truth scopegap ceilingleft secondsleft
logic    eve   consent_covers apps/blocks/ramble/consent.eve
logic    sutra consent_covers apps/blocks/ramble/consent.sutra

# One envelope of the feed makes a ^ZXRAMBLE record (RR2), in MYRA.
provides envelope_record_ok truth id kind status amount stamp
logic    myra envelope_record_ok apps/blocks/ramble/envelope.myra
# Gleam (typed messaging) owns an envelope's typed record; it does not run
# yet, so MYRA stands in.
pending  Gleam envelope_record_ok

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check consent_covers scopegap=0,0,1,0,0,0,0,2 ceilingleft=0,999999999999999999,0,-1,0,0,5,0 secondsleft=1,86400,600,600,0,86401,-5,600 = true,true,false,false,false,false,false,false
check consent_covers scopegap=0,0 ceilingleft=0,1000000000000000000 secondsleft=600,600 = both
check consent_covers scopegap=0,0 ceilingleft=0,0 secondsleft=600,100000 = both
check consent_covers scopegap=0,10 ceilingleft=0,0 secondsleft=600,600 = both
check envelope_record_ok id=1,4294967295,9999999999,10000000000,1,1,1 kind=0,3,9,0,10,0,0 status=1,2,0,0,0,0,0 amount=0,999999999999999999,-5,0,0,1000000000000000000,0 stamp=0,253402300799,999999999999,0,0,0,1000000000000 = true,true,true,false,false,false,false
# The CID check, Seedbank's: the prefix, a letter, a digit, past the digits, a short text
check seedbank.cid_byte pos=0,1,58,7,0 code=98,97,55,56,98 len=59,59,59,59,58 = 1,1,1,0,0
check seedbank.cid_byte pos=1,1 code=97,256 len=59,59 = both
# A held envelope's 2500 minor units out of a balance of 10000
check reckoner.statement_close opening=10000,100 credits=0,0 debits=2500,2500 = 7500,-2400
