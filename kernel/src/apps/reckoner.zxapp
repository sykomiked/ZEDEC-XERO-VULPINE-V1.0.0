#
# Reckoner, statements and tax reports: layer 83 of the matrix. Period
# statements and tax estimates from the books (ledger.accounts,
# ledger.entries, ledger.check), rendered as camt.053 (iso20022.render),
# with the jurisdiction the books keep (jurisdiction.get), saved through
# the Banker (files.write) and printed (print.submit). Money is integer
# minor units, never a float; anything that does not fit is refused.
#
# Advisory only. A tax figure is an estimate over bands the owner gives,
# not tax advice; a person files, Reckoner never does. Nothing is rendered,
# saved or printed until the period is closed and the books hold
# (report_ok), and a saved report never replaces an earlier one.
#
# zxvd's journal (ledger.entries) carries no dates, so a period is a range
# of entry ids the owner sets and closes; a dated journal, a period close
# kept by the books, and a tax table per country (jurisdiction.get answers
# the country and the reporting standard, not bands) are missing from zxvd
# (reckoner_model.h), not invented.
#
# Coffer (73) is built before this one: the net of a period and the
# opening balance are coffer.holdings (the exact sum of signed minor
# units), and every closing is checked against coffer.balance. Three later
# layers lean on this one (Ramble 25 among them), so each entry is a
# general rule registered in CONCEPTS.tsv with Reckoner as its
# owner: a statement's closing from its two directions, the tax in one
# band of a banded table, and whether a period may be reported.
#
# Witness pairs are of one kind: the statement and the band tax are
# numbers, in Sutra and Trebago (Sutra refuses past its pictures, Trebago
# answers to 64 bits: held); report_ok is a truth over two flags each
# checked against its own range, which is what Eve holds, alone, as the
# task asks.
zxapp 1
id     reckoner
name   Reckoner
version 1.0.0
slot   83
layer  L1
matrix 83
icon   icons/l1/083-reckoner.svg
budget 233
needs  ledger.read
needs  fs.write
needs  print
model  apps/reckoner_model.c
use    coffer 1   # @num.coffer_holdings @num.coffer_balance

# One account's statement for a period (RR1): closing = opening + credits
# - debits, one account per row, credits and debits never below 0.
provides statement_close num opening credits debits
logic    sutra   statement_close apps/blocks/reckoner/statement.sutra
logic    trebago statement_close apps/blocks/reckoner/statement.tb
# RPG (report generation from fixed records) owns the period statement;
# it does not run yet, so Sutra and Trebago stand in.
pending  RPG statement_close

# The tax in one band of a banded table (RR2): floor(max(0, min(income,
# hi) - lo) * rate / 10000), rate in hundredths of a percent, one band per
# row; the model adds the bands into the estimate.
provides band_tax num income lo hi rate
logic    sutra   band_tax apps/blocks/reckoner/band.sutra
logic    trebago band_tax apps/blocks/reckoner/band.tb

# A period may be reported (RR3): closed by the owner and the books hold.
provides report_ok truth closed books
logic    eve report_ok apps/blocks/reckoner/report.eve
# Eiffel (design by contract) and Solidity (contract rules) own this
# precondition; neither runs yet, so Eve stands in.
pending  Eiffel report_ok
pending  Solidity report_ok

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check statement_close opening=0,100,-500,999999999999999999 credits=0,250,0,0 debits=0,50,100,999999999999999999 = 0,300,-600,0
check statement_close opening=0,0 credits=0,1000000000000000000 debits=0,0 = both
check band_tax income=0,50000,150000,10001,99999999999999,150000 lo=10000,10000,10000,0,0,200000 hi=100000,100000,100000,100000,99999999999999,300000 rate=2000,2000,2000,3333,10000,3000 = 0,8000,18000,3333,99999999999999,0
check band_tax income=1,100000000000000 lo=0,0 hi=1,100000000000000 rate=10000,10000 = both
check report_ok closed=1,1,0,0,2 books=1,0,1,0,1 = true,false,false,false,false
check coffer.holdings balance=100,-30 = 70
check coffer.balance before=0,100 moved=5,-100 = 5,0
