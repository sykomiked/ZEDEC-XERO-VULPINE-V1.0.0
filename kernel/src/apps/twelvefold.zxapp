#
# Twelvefold, the paraconsistent logic workbench: layer 132 of the matrix.
# Write formulas over TRUE, FALSE, BOTH and NEITHER, see their tables, how
# many assignments give each value and the 64-state hexagram tag
# (lpres_hex.h), ask whether a conclusion follows from premises, try the
# engines' Playground templates (play.catalogue, play.run) and keep formula
# sets in the Hoard (files.read, files.write). twelvefold_model.h TF1-TF7.
#
# Evaluation stays C: every connective is the kernel's own lpres_negate,
# lpres_conjoin and lpres_disjoin (kernel/src/lpres, the chain F < N < B <
# T, so BOTH with NEITHER is never TRUE), called, never re-derived, and
# never written again in a block. The blocks work over the value codes C
# produced, in the kernel's numbering: NEITHER 0, TRUE 1, FALSE 2, BOTH 3.
#
# Reuse, nearer the core: how many assignments give each value is
# witness.kind_count (count_by_kind), Witness's KRON and Trebago pair, used
# as it is; the same count of the assignments that break a consequence
# (kept answers FALSE, code 2) says whether the conclusion follows.
#
#   lp_entail_kept  one assignment keeps the consequence: the premises'
#                   conjunction is not designated (NEITHER, FALSE) or the
#                   conclusion is (TRUE, BOTH). The conclusion follows when
#                   no assignment breaks it. The task asks for Eve and KRON;
#                   Eve checks each field against its own range only
#                   (zxapp_eve.c EV2), and "not designated or designated"
#                   is a relation across two fields over codes {0,2} and
#                   {1,3}, which no pair of ranges holds. So it is
#                   witnessed in Sutra and KRON, and Eve keeps the limits.
#                   Sutra refuses a code outside 0..3, KRON answers it:
#                   held (BOTH).
#   lp_limits_ok    a formula inside the workbench's limits: at most 6
#                   variables and at most 16 connectives deep, in Eve as
#                   the task asks, witnessed by KRON (the same ranges).
#
# 2 later layers lean on this one (Tidewatch's console and Graft), so both
# entries are general and owned here (CONCEPTS.tsv: lp_designation_kept,
# lp_formula_limits).
#
# Planned languages: Clojure (symbolic) is the best fit for the consequence
# rule (pending below). Lua (scripting) and Raku (parse, text) own work
# that stays C here, the Playground's scripts run by zxvd and the formula
# parser, with no entry of their kind: no pending line.
zxapp 1
id     twelvefold
name   Twelvefold
version 1.0.0
slot   132
layer  L1
matrix 132
icon   icons/l1/132-twelvefold.svg
budget 233
needs  fs.read
needs  fs.write
model  apps/twelvefold_model.c
use    witness 1   # @num.witness_kind_count

# One assignment keeps a four-valued consequence: Sutra and KRON.
provides lp_entail_kept truth premise conclusion
logic    sutra lp_entail_kept apps/blocks/twelvefold/kept.sutra
logic    kron  lp_entail_kept apps/blocks/twelvefold/kept.kron
pending  Clojure lp_entail_kept

# A formula inside the limits: Eve and KRON.
provides lp_limits_ok truth vars depth
logic    eve  lp_limits_ok apps/blocks/twelvefold/limits.eve
logic    kron lp_limits_ok apps/blocks/twelvefold/limits.kron

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check lp_entail_kept premise=0,0,1,1,1,1,2,3,3,3 conclusion=0,2,0,1,2,3,0,0,2,3 = true,true,false,true,false,true,true,false,false,true
check lp_entail_kept premise=1,4 conclusion=1,1 = both
check lp_entail_kept premise=1,-1 conclusion=1,0 = both
check lp_limits_ok vars=0,6,7,-1,3,3,3 depth=0,16,0,0,17,-1,8 = true,true,false,false,false,false,true
# agree: lp_limits_ok Eve and KRON check the same two ranges, field by field, so every integer input answers the same in both
check witness.kind_count kind=1,3,2,1,0,1 want=1 = 3
check witness.kind_count kind=1,2 want=1,1 = both
