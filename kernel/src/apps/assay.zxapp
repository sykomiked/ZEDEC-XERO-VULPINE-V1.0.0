#
# Assay, agent testing and scores: layer 72 of the matrix (AI and the
# swarm). It puts the owner's test suite to the swarm and scores what
# comes back, each result four-valued: an asked prompt (swarm.ask, under
# zxvd's tokens-per-cycle budget gate) graded against the text it must
# and must not contain; a Playground template run on scratch state, never
# the books (play.run), graded by its own verdict; and each agent's
# standing in the swarm's audit (swarm.state: its witness trit, TRUE
# agrees, FALSE the cycle does not add up, contested BOTH, missing
# NEITHER). zxvd's swarm.ask asks the companion and takes no agent, so the
# asked prompts and the templates score the companion, and each agent is
# scored by its audit (assay_model.h AM1). A call zxvd refuses (the budget
# gate) is a refusal, counted apart. The run log stays in the C model, a
# bounded ring (AM5).
#
# A score is advisory: it never changes an agent's budget, standing or
# market share. Assay calls no method that could; it only reads and asks.
#
# 4 later layers lean on this one, so its entries are general rules owned
# here (CONCEPTS.tsv): a pass share, meeting a test bar, and a rank by
# score. Nothing nearer the core fits: used_share.used_x100 is a capacity
# in use, and Talisman's reach_x100 holds a value at its threshold (10000)
# where a pass count past its runs is no count and is refused here.
#
# Witness pairs are of one kind (zxapp.c run_one B3): Trebago and KRON
# witness pass_share_x100, Eve and KRON meets_bar (Eve answers truths and
# checks each field against its own range, so the bar comes as margins);
# the model's C (assay_rules.h) is the third witness of both. The rank is
# KRON alone, as the task puts it. A run's four counts are decided by the
# shared block pce_prob (verdict, its C), and two runs are joined by its
# join (AY5).
#
# Planned (no runtime yet): Mojo owns numeric kernels for models, and the
# pass share is Assay's numeric work over agents: pending. S owns
# statistics, and the rank over the score vector is Assay's statistic:
# pending. Racket owns making small languages and parsing, Occam channels
# and parallel processes: Assay parses nothing (a grade is a plain text
# match, in C) and runs one test at a time, so neither has an entry of its
# kind and neither has a pending line.
#
# Defaults taken (assay_model.h AM3): a bar of 8000 (80.00%), at most 0
# refusals and at least 1 run; thresholds decide 1/2 and conflict 1/4.
zxapp 1
id     assay
name   Assay
version 1.0.0
slot   72
layer  L1
matrix 72
icon   icons/l1/072-assay.svg
budget 233
needs  swarm
needs  ai.ask
needs  sys.read
model  apps/assay_model.c
use    pce_prob 1   # @prob.join, and its verdict

# A subject's pass share (AY1): floor(10000 * passes / runs). Trebago
# refuses passes past runs, a negative or runs outside 1..999999999; KRON
# divides as it is: held.
provides pass_share_x100 num passes runs
logic    trebago pass_share_x100 apps/blocks/assay/share.tb
logic    kron    pass_share_x100 apps/blocks/assay/share.kron
pending  Mojo pass_share_x100

# Meets the bar (AY2): the pass, refusal and run margins inside their
# ranges. Eve declares the ranges, KRON reads any margin at or above 0 as
# met: a margin past its range is held.
provides meets_bar truth passroom refusalroom runroom
logic    eve  meets_bar apps/blocks/assay/bar.eve
logic    kron meets_bar apps/blocks/assay/bar.kron

# Each subject's place among the scores, best first (AY3).
provides score_rank num score
logic    kron score_rank apps/blocks/assay/rank.kron
pending  S score_rank

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check pass_share_x100 passes=0,1,2,999999999,0,3 runs=1,3,3,999999999,999999999,3 = 0,3333,6666,10000,0,10000
check pass_share_x100 passes=1,4 runs=3,3 = both
check pass_share_x100 passes=1,-1 runs=3,3 = both
check pass_share_x100 passes=1,1 runs=3,1000000000 = both
check meets_bar passroom=0,10000,-1,0,0,5 refusalroom=0,999999999,0,-1,0,5 runroom=0,999999999,0,0,-1,5 = true,true,false,false,false,true
check meets_bar passroom=0,10001 refusalroom=0,0 runroom=0,0 = both
check meets_bar passroom=0,0 refusalroom=0,1000000000 runroom=0,0 = both
check score_rank score=10000,5000,5000,0,7500 = 1,3,3,5,2
check score_rank score=0,0,0 = 1,1,1
# A run's verdict (AY4) under decide 1/2 and conflict 1/4: three passes of
# four, one of four, no results; then two runs joined (AY5): a pass and a fail
check pce_prob.verdict m=3,1,0,0 th=1,2,1,4 = true
check pce_prob.verdict m=1,3,0,0 th=1,2,1,4 = false
check pce_prob.verdict m=0,0,0,0 th=1,2,1,4 = neither
check pce_prob.join a=1,0,0,0 b=0,1,0,0 = 0,0,1,0
