#
# Tidewatch, the activity monitor. zxvd's CPU share is worked out in Sutra
# and KRON; memory in use comes from the used_share block, which Almanac
# uses too; the graph's scale (the peak) is KRON.
zxapp 1
id     tidewatch
name   Tidewatch
version 1.0.0
slot   15
layer  L1
matrix 15
icon   icons/l1/015-tidewatch.svg
budget 55
needs  sys.read
model  apps/tidewatch_model.c
use    used_share 1   # @num.used_x100

provides cpu_x100 num cpu ms
logic    sutra cpu_x100 apps/blocks/tidewatch/cpu.sutra
logic    kron  cpu_x100 apps/blocks/tidewatch/cpu.kron

provides peak num share
logic    kron peak apps/blocks/tidewatch/peak.kron

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check cpu_x100 cpu=999,0,12345 ms=1000,5,100 = 9,0,1234
check cpu_x100 cpu=1000000000000 ms=1 = both
check peak share=-5,3,7 = 7
check peak share=-5 = 0
check used_share.used_x100 total=1,1,3 left=0,1,2 = 10000,0,3333
check used_share.used_x100 total=100 left=101 = both
