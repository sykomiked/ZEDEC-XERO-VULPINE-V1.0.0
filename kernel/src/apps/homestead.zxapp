#
# Homestead, the owner's home devices and scenes: layer 94 of the matrix.
# Lights, plugs, blinds, locks, heaters and ovens, each with its range and
# setpoint, scenes that set several at once, and each device's energy in
# watt-hours. Advisory and owner-confirmed: a lock, a heater or an oven
# changes only with the owner's approval, and an AI's suggestion is held
# for the owner, never run (homestead_model.h HM6, HM7).
#
# zxvd has no home-device method (devmesh.* is the owner's computers and
# phones, not their lights and locks), and none is invented: a command the
# rules allow is kept as the device's setpoint in the owner's file, for a
# device bridge to carry out once zxvd has one. A device may name the ZXV
# node that bridges it on the local network (its NodeID); net.peers says
# whether that node is reachable now. zxvd has no notification method
# either, so the model only composes each notice's text. The devices,
# scenes and readings are one text file in the Banker, read with
# files.read and written with files.write, so the app also needs fs.read
# and fs.write beyond the task's net, peers and notify: without them it
# could keep nothing.
#
# No other layer leans on this one yet; the general rules are still
# registered in CONCEPTS.tsv with Homestead as owner, since any device or
# appliance layer needs them (a device command allowed, the same as a
# number to count with, one key's exact total over readings). Warren
# (built before) owns the owner's approval: warren.approval_ok is the
# "approved" of HR1, never written again. Stillwater (144) is built after
# this layer: its quiet hours are not used.
#
#   device_cmd_ok      setpoint inside the device's range, no owner
#                      approval owed (locks, heaters and ovens need it) and
#                      not an AI's suggestion (HR2). The task names Eve and
#                      Forth; Eve answers only truths (zxapp_eve.c EV2) and
#                      Lingua's Forth only printed numbers (zxapp_lingua.c
#                      L2), and a witnessed pair answers one kind, so the
#                      rule is split as Gatehouse and Signpost split theirs:
#                      Eve and KRON witness the truth, Forth and KRON the
#                      same rule as a number (device_cmd_n). Eve checks
#                      each field against its own range, so the setpoint
#                      comes as its two margins and the approval as what is
#                      still owed (guarded - approved).
#   device_cmd_n       HR3, Forth (twin Cairndrake) and KRON. Forth reads
#                      its input from the stack and Lingua's Forth has no
#                      DEPTH, so it takes one command per call: each check
#                      line is one row.
#   device_energy      one device's exact energy over the readings (HR4),
#                      Trebago from the first reading, KRON from the last.
#   home_device_ok     a device's record, ^ZXHOME, in MYRA, witnessed by
#                      Eve's kinds and ranges (HR5).
#   home_scene_ok      a scene step's record, ^ZXSCENE, in MYRA (HR6).
#
# Logo (twin Kiteling) is not used: Lingua's Logo refuses readword and
# readlist (zl_logo.c), so a Logo program cannot read an entry's arguments
# (zxapp_lingua.c L1), and Homestead draws no geometry.
zxapp 1
id     homestead
name   Homestead
version 1.0.0
slot   94
layer  L1
matrix 94
icon   icons/l1/094-homestead.svg
budget 233
needs  net
needs  peers
needs  notify
needs  fs.read
needs  fs.write
model  apps/homestead_model.c
use    warren 1   # @logic.warren_approval_ok

# A command is allowed (HR2): Eve declares the ranges, KRON compares.
provides device_cmd_ok truth above below owed ai
logic    eve  device_cmd_ok apps/blocks/homestead/command.eve
logic    kron device_cmd_ok apps/blocks/homestead/command.kron

# The same rule as a number (HR3): Forth, twin Cairndrake; the line names
# the runtime "forth", since the Alexandria index numbers runtimes, not
# twins. IEC 61131-3 Structured Text owns control logic and Zig explicit
# systems code (as wasm): a device-side interlock is both, so both wait on
# this entry until they have a runtime.
provides device_cmd_n num above below owed ai
logic    forth device_cmd_n apps/blocks/homestead/command_n.fs
logic    kron  device_cmd_n apps/blocks/homestead/command_n.kron
pending  IEC_61131-3_Structured_Text device_cmd_n
pending  Zig device_cmd_n

# One device's energy in watt-hours (HR4), exact.
provides device_energy num device want wh
logic    trebago device_energy apps/blocks/homestead/energy.tb
logic    kron    device_energy apps/blocks/homestead/energy.kron

# A device's record (HR5): MYRA holds the digits, Eve the kinds and ranges.
provides home_device_ok truth device kind lo hi setpoint
logic    myra home_device_ok apps/blocks/homestead/device.myra
logic    eve  home_device_ok apps/blocks/homestead/device.eve

# A scene step's record (HR6), in MYRA.
provides home_scene_ok truth scene device setpoint
logic    myra home_scene_ok apps/blocks/homestead/scene.myra

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check device_cmd_ok above=0,199998,-1,5,5,5,0,0 below=0,199998,5,-1,5,5,0,0 owed=0,-1,0,0,1,0,-1,0 ai=0,0,0,0,0,1,0,0 = true,true,false,false,false,false,true,true
check device_cmd_ok above=5,199999 below=5,5 owed=0,0 ai=0,0 = both
check device_cmd_ok above=5,5 below=5,5 owed=0,-2 ai=0,0 = both
check device_cmd_n above=0 below=0 owed=0 ai=0 = 1
check device_cmd_n above=199998 below=199998 owed=-1 ai=0 = 1
check device_cmd_n above=-1 below=5 owed=0 ai=0 = 0
check device_cmd_n above=5 below=5 owed=1 ai=0 = 0
check device_cmd_n above=5 below=5 owed=0 ai=1 = 0
check device_cmd_n above=199999 below=5 owed=0 ai=0 = both
check device_cmd_n above=5 below=5 owed=0 ai=-1 = both
check device_energy device=1,2,1,3,1 want=1 wh=100,7,250,9,0 = 350
check device_energy device=4,4 want=9 wh=5,6 = 0
check device_energy device=1,1,1 want=1 wh=9223372036854775807,1,-1 = both
check home_device_ok device=1,9999,10000,7,7,7 kind=1,6,1,10,4,4 lo=0,-99999,0,0,0,0 hi=100,99999,1,1,1,1 setpoint=50,0,1,1,1,100000 = true,true,false,false,true,false
check home_device_ok device=7,7 kind=4,7 lo=0,0 hi=1,1 setpoint=1,1 = both
check home_scene_ok scene=1,999,1000,5 device=1,9999,1,10000 setpoint=0,-99999,1,1 = true,true,false,false
check warren.approval_ok owner=1,1,0 approved=1,0,1 = true,false,false
