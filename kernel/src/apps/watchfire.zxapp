#
# Watchfire, emergency contacts and a medical ID: layer 143 of the matrix.
# The medical ID and the contacts are shown on the lock screen, as the
# person typed them. On the person's own request, and only after a cancel
# window that is never skipped, Watchfire rings the contacts (call.start,
# signalling only) and tells the ones the owner chose where the machine is
# (place.ask, place.here). Contacts' phones come from phone.list.
#
# Life-safety: advisory and human-approved. Watchfire never calls
# emergency services or anyone by itself, is not a medical device and
# infers nothing clinical: the medical ID is text kept as typed
# (watchfire_model.h WM1). zxvd has no lock-screen method, no method that
# delivers a message or a location to a contact's device, and no
# notification method; the model composes the card, the location lines
# and the notices for the view, and none is invented.
#
# No other layer leans on this one and its layer leans on none, but two of
# its rules are general (CONCEPTS.tsv, Watchfire as owner): whether a
# location may be shared with one contact, and the seconds of a cancel
# window left before an action. Nothing nearer the core fits them:
# gatehouse.use_ok is an app's capability (asked, granted, not revoked),
# not a contact's share, and halloo.quiet_left counts the minutes of a
# daily window, not seconds since a start. Warren (built before) owns the
# owner's approval: warren.approval_ok is the person's word that starts an
# emergency (WM2), never written again. Stillwater (144) is built after
# this layer: its rules are not used.
#
# Witness pairs are of one kind (zxapp.c run_one B3). The task's cancel
# window in Eve and KRON relates fields (the time waited against the
# window), which Eve cannot (it checks each field against its own range),
# so the count is split out as Halloo's quiet_left is: cancel_left (the
# seconds still to wait) is Sutra and KRON, and the ring rule takes its
# answer as a field and is Eve and KRON (sos_ring_ok). The model's C
# (watchfire_rules.h) is the third witness of each.
#
#   place_share_ok  WF1, Eve and KRON. A flag of 2 fits KRON's yes and
#                   not Eve's record: held.
#   cancel_left     WF2, Sutra and KRON. Sutra's 9(9) refuses a
#                   negative wait and 9(2) a window past 99, KRON
#                   answers: held.
#   sos_ring_ok     WF3, Eve and KRON: the window 10..60 s, none of it
#                   left, not cancelled. A left or cancelled below 0
#                   fits KRON's "none" and not Eve's: held.
#   medical_id_ok   WF4, a medical ID field's record, ^ZXWFMED, MYRA.
#   sos_contact_ok  WF5, a contact's record, ^ZXWFCON, MYRA.
#
# Default taken: a cancel window of 30 s until the owner sets one (the task
# gives the range, not the default). Sharing is off until the owner opts in
# and confirms.
#
# Planned languages: Swift and Python already have runtimes, so they are
# not pending. OCaml owns types and parse: no entry here is a typed
# transform or a parser (the file is read back in C, WM6), so it is not
# pending.
zxapp 1
id     watchfire
name   Watchfire
version 1.0.0
slot   143
layer  L1
matrix 143
icon   icons/l1/143-watchfire.svg
budget 233
needs  location
needs  peers
needs  notify
needs  fs.read
needs  fs.write
model  apps/watchfire_model.c
use    warren 1   # @logic.warren_approval_ok

# Share where the machine is with this contact (WF1), Eve and KRON.
provides place_share_ok truth started optin listed placeok
logic    eve  place_share_ok apps/blocks/watchfire/place.eve
logic    kron place_share_ok apps/blocks/watchfire/place.kron

# Seconds of the cancel window still to run (WF2), Sutra and KRON.
provides cancel_left num window waited
logic    sutra cancel_left apps/blocks/watchfire/cancel.sutra
logic    kron  cancel_left apps/blocks/watchfire/cancel.kron

# May Watchfire ring the contacts now (WF3), Eve and KRON.
provides sos_ring_ok truth window left cancelled
logic    eve  sos_ring_ok apps/blocks/watchfire/ring.eve
logic    kron sos_ring_ok apps/blocks/watchfire/ring.kron

# A medical ID field's record (WF4), in MYRA.
provides medical_id_ok truth field bytes stamp
logic    myra medical_id_ok apps/blocks/watchfire/medical.myra

# An emergency contact's record (WF5), in MYRA.
provides sos_contact_ok truth seq peer bytes stamp
logic    myra sos_contact_ok apps/blocks/watchfire/contact.myra

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check place_share_ok started=1,0,1,1,1,1 optin=1,1,0,1,1,0 listed=1,1,1,0,1,0 placeok=1,1,1,1,0,0 = true,false,false,false,false,false
check place_share_ok started=1,2 optin=1,1 listed=1,1 placeok=1,1 = both
check place_share_ok started=1,1 optin=1,1 listed=1,1 placeok=1,3 = both
check cancel_left window=30,30,30,30,10,60,0,99 waited=0,29,30,1000,5,0,0,0 = 30,1,0,0,5,60,0,99
check cancel_left window=30,30 waited=0,-1 = both
check cancel_left window=30,100 waited=0,0 = both
check sos_ring_ok window=10,60,30,9,61,30,30,0 left=0,0,0,0,0,1,0,0 cancelled=0,0,0,0,0,0,1,0 = true,true,true,false,false,false,false,false
check sos_ring_ok window=30,30 left=0,-1 cancelled=0,0 = both
check sos_ring_ok window=30,30 left=0,0 cancelled=0,-1 = both
check medical_id_ok field=1,6,9,10,1,1 bytes=0,255,999,1,1000,1 stamp=1700000000000,999999999999999,0,0,0,1000000000000000 = true,true,true,false,false,false
check sos_contact_ok seq=1,9,99,100,1,1,1 peer=7,4294967295,9999999999,7,10000000000,7,7 bytes=1,47,99,1,1,100,1 stamp=1700000000000,0,999999999999999,0,0,0,1000000000000000 = true,true,true,false,false,false,false
check warren.approval_ok owner=1,1,0 approved=1,0,1 = true,false,false
