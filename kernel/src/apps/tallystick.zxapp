#
# Tallystick, invoices and receipts: layer 78 of the matrix. Invoices
# drafted line by line and numbered when issued, payments against them
# recorded in the owner's books (ledger.post, through Coffer) and read back
# (ledger.entries), a receipt when an invoice is paid in full, statements
# of a customer's account rendered as camt.053 (iso20022.render, through
# Reckoner), each saved through the Banker (files.write) and printed
# (print.submit); the sequence's last number is kept in a file of the
# Hoard (files.read, files.write). Money is integer minor units, never a
# float; anything that does not fit is refused, never rounded or cut.
#
# Advisory and owner-confirmed: a payment is only checked and held until
# the owner confirms it (tallystick_model.h TS3), and an issued invoice
# is never changed.
#
# Built from earlier layers: a line's net is vintner.sale_value (qty *
# price), the invoice's total coffer.holdings (the exact sum of its
# lines), what is still owed and the margin paid - total coffer.balance, a
# payment a transfer coffer.transfer_ok allows, the register of numbers
# one chain witness.chain_ok checks, and a statement Reckoner's
# (reckoner.statement_close, reckoner.report_ok: a closed period, the books
# checked). Murmuration (61), which the layer's code leans on, weighs
# agents' swarm shares; an invoice has none, so it is not used. One later
# layer leans on this one, so each entry is a general rule registered in
# CONCEPTS.tsv with Tallystick as its owner: a taxed line's total, paid in
# full, and the next number of a document sequence.
#
# Witness pairs are of one kind: the taxed line is a number, in Sutra and
# Trebago (Sutra refuses past its pictures, Trebago answers: held); paid
# in full is a truth whose fields Eve checks each against its own range,
# so the model gives it the margin paid - total, and Sutra answers the
# same condition (a margin past 18 digits: Sutra refuses, Eve says FALSE:
# held). The sequence is a fixed business record, in Sutra alone.
#
# zxvd has no invoice message to render (iso20022.render takes pacs.008
# and camt.053 only), so an invoice or receipt is text, and no document
# counter of its own, so the register is a file; neither is invented.
zxapp 1
id     tallystick
name   Tallystick
version 1.0.0
slot   78
layer  L1
matrix 78
icon   icons/l1/078-tallystick.svg
budget 233
needs  ledger.read
needs  ledger.post
needs  fs.read
needs  fs.write
needs  print
model  apps/tallystick_model.c
use    coffer 1     # @num.coffer_holdings @num.coffer_balance @logic.coffer_transfer_ok
use    witness 1    # @logic.witness_chain_ok
use    vintner 1    # @num.vintner_sale_value
use    reckoner 1   # @num.reckoner_statement_close @logic.reckoner_report_ok

# One line of an invoice with its tax (TR1): qty * price, the tax at
# taxn / taxd rounded half up to a whole minor unit, and their sum.
provides taxed_line_total num qty price taxn taxd
logic    sutra   taxed_line_total apps/blocks/tallystick/line.sutra
logic    trebago taxed_line_total apps/blocks/tallystick/line.tb

# Paid in full (TR2): the total 0 .. 2^53 - 1 and over = paid - total
# 0 .. 18 digits.
provides paid_in_full truth total over
logic    eve   paid_in_full apps/blocks/tallystick/paid.eve
logic    sutra paid_in_full apps/blocks/tallystick/paid.sutra
# Eiffel (contracts) and Solidity (contract rules) own this rule; neither
# runs yet, so Eve and Sutra stand in. Python, also planned, already runs
# and owns scripting and AI pipelines; no entry here is of that kind, so
# it has no line.
pending  Eiffel paid_in_full
pending  Solidity paid_in_full

# The next number of an invoice or receipt (TR3): last + 1, nine digits,
# refused past them.
provides next_doc_number num last
logic    sutra next_doc_number apps/blocks/tallystick/number.sutra

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check taxed_line_total qty=0,1,3,999999,2,1 price=0,1000,1999,9999999,5,1 taxn=0,1,2,1,1,1 taxd=1,10,25,1,4,2 = 0,1100,6477,19999978000002,13,2
check taxed_line_total qty=1,1000000 price=1,1 taxn=0,0 taxd=1,1 = both
check taxed_line_total qty=1,1 price=1,10000000 taxn=0,0 taxd=1,1 = both
check paid_in_full total=100,100,0,9007199254740991,100,9007199254740992 over=0,5,0,999999999999999999,-1,0 = true,true,true,true,false,false
check paid_in_full total=100,100 over=0,1000000000000000000 = both
check next_doc_number last=0,1,41,999999998 = 1,2,42,999999999
check coffer.holdings balance=1100,6477,13 = 7590
check witness.chain_ok seq=1,2,3 prev=0,1,2 last=0,1,2 = true,true,true
