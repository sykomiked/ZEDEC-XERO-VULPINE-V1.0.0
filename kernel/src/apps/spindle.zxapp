#
# Spindle, the console. The screen and the calls are C; what a call may
# carry (params and the reply kept) is Eve.
zxapp 1
id     spindle
name   Spindle
version 1.0.0
slot   22
layer  L1
matrix 22
icon   icons/l1/022-spindle.svg
budget 233
needs  sys.read
needs  ai.ask
view   zui/views/spindle.c
model  apps/spindle_model.c

provides call_ok truth params reply
logic    eve call_ok apps/blocks/spindle/params.eve

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check call_ok params=0,4096,4097,10 reply=0,8192,0,8193 = true,true,false,false
