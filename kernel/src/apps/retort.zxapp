#
# Retort, run and compare models: layer 70 of the matrix (AI and the
# swarm). Contestants answer the same work and are compared on what they
# score, how fast they answer and the energy each answer takes: the model
# in the slot (model.info), asked through the swarm (swarm.ask); a
# Playground template run on scratch state, never the books (play.run);
# and a published function run in the Z-Wasm sandbox under its fuel
# (aipi.execute). After every run the power ledger's last interval
# (power.status total_uj) is that run's energy. Grades are the owner's for
# an asked answer; a template's verdict and a function's expected result
# grade the others. Retort advises: it changes no settings, spends no
# money and runs nothing outside its limits (retort_model.h RM1-RM6).
#
# 1 later layer leans on this one, so its entries are general rules owned
# here (CONCEPTS.tsv): a contestant's score total, the fastest and slowest
# latency fold, the limits on one run, the energy per answer and a run's
# record. Of the layers the task names, Coffer (73) and Ninefold (80) are
# built before this one, but Retort decides nothing about money or
# capital, so neither is used. Each contestant's share of all the points
# given is banker.share (share_of_whole), used as it is.
#
# Witness pairs are of one kind (zxapp.c run_one B3): Trebago and KRON
# witness model_score_total, KRON and Rust (wasm) the two latency folds;
# the model's C (retort_rules.h) is the third witness of each. The task
# puts the run limits in Eve, the energy per answer in Trebago and the
# run record in MYRA, one language each.
#
# Planned (no runtime yet): Mojo owns numeric kernels for models, and the
# score total is Retort's numeric work over models: pending. Occam owns
# channels and parallel processes and Simula 67 simulation with classes:
# Retort runs one contestant at a time and simulates nothing (play.run
# does, inside zxvd), so neither has an entry of its kind and neither has
# a pending line.
#
# Defaults taken (retort_rules.h RT3): zxvd sets no wall-clock limit on a
# run, so a run's seconds are 1..3600 (an hour); a prompt is 1..4095 bytes,
# swarm.ask's own limit (zxvd's), not zxm's 4000-byte ask helper.
zxapp 1
id     retort
name   Retort
version 1.0.0
slot   70
layer  L1
matrix 70
icon   icons/l1/070-retort.svg
budget 233
needs  ai.ask
needs  swarm
needs  sys.read
model  apps/retort_model.c
use    banker 1   # @num.banker_share

# A contestant's score total (RT1): its graded answers' points, each
# 0..100, exact. Trebago refuses a score outside; KRON adds it: held.
provides model_score_total num model want score
logic    trebago model_score_total apps/blocks/retort/score.tb
logic    kron    model_score_total apps/blocks/retort/score.kron
pending  Mojo model_score_total

# The fastest and the slowest run so far (RT2), one fold step each, every
# latency 0..3600000 ms. The wasm module traps outside; KRON answers: held.
provides latency_fastest_ms num fastest ms
logic    wasm latency_fastest_ms apps/blocks/retort/fastest.wasm
logic    kron latency_fastest_ms apps/blocks/retort/fastest.kron
provides latency_slowest_ms num slowest ms
logic    wasm latency_slowest_ms apps/blocks/retort/slowest.wasm
logic    kron latency_slowest_ms apps/blocks/retort/slowest.kron

# The owner's limits on one run (RT3): prompt bytes, fuel, seconds.
provides run_limits_ok truth prompt fuel seconds
logic    eve run_limits_ok apps/blocks/retort/limits.eve

# The exact energy one answer took (RT4), microjoules as a fraction.
provides energy_per_answer_uj num uj answers
logic    trebago energy_per_answer_uj apps/blocks/retort/energy.tb

# A run fits its record (RT5): ^ZXRETORT's digits.
provides run_record_ok truth run model kind prompt fuel ms score uj
logic    myra run_record_ok apps/blocks/retort/run.myra

# Its own proof (zxapp.h K1): each entry at its edges, and where its languages disagree
check model_score_total model=1,2,1,3,1 want=1 score=50,70,100,0,0 = 150
check model_score_total model=4,4 want=9 score=5,6 = 0
check model_score_total model=1,2 want=1 score=50,101 = both
check model_score_total model=1,2 want=1 score=-1,5 = both
check latency_fastest_ms fastest=3600000,500,0,3600000,7 ms=120,700,0,3600000,6 = 120,500,0,3600000,6
check latency_fastest_ms fastest=10,10 ms=5,3600001 = both
check latency_fastest_ms fastest=10,-1 ms=5,5 = both
check latency_slowest_ms slowest=0,500,0,3600000,7 ms=120,700,0,3600000,6 = 120,700,0,3600000,7
check latency_slowest_ms slowest=10,10 ms=5,3600001 = both
check latency_slowest_ms slowest=10,-1 ms=5,5 = both
check run_limits_ok prompt=1,4095,0,4096,100,100,100,100 fuel=1,999999999999999999,1,1,0,1000000000000000000,5,5 seconds=1,3600,1,1,1,1,0,3601 = true,true,false,false,false,false,false,false
check energy_per_answer_uj uj=1000,10,7,0,999999999999999999 answers=4,3,7,1,1 = 250,10/3,1,0,999999999999999999
check run_record_ok run=0,999,1000,1,1,1,1,1 model=0,99,0,100,0,0,0,7 kind=0,2,0,0,10,0,0,1 prompt=0,4095,0,0,0,10000,0,12 fuel=0,999999999999999999,0,0,0,0,0,5 ms=0,9999999,0,0,0,0,10000000,120 score=0,100,0,0,0,0,0,-1 uj=0,999999999999999999,0,0,0,0,0,3 = true,true,false,false,false,false,false,true
# Each contestant's share of all the points given (RT6): 150 and 300 of 450
check banker.share size=150,300,0 total=450 = 3333,6666,0
