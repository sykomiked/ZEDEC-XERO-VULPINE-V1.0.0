/* zl_langs.def — every Lingua language, one line each, in id order:
 *   ZL_LANG_X(id, number, name, twin, front-end, extensions, runtime)
 * id: ZL_LANG_<id>; number: stable (it is written into .zlir files), dense
 * from 1; name: exactly as catalogue.tsv names it; twin: the dragon name of
 * its AI twin; front-end: zl_<front-end>.c defines
 * zl_<front-end>_compile (LISP and Scheme share one); extensions: what
 * zxlang accepts, space-separated; runtime: the name an app manifest writes
 * (zxapp.h), the id in lower case except FORTRAN 77, whose "fortran" is the
 * Trebago pillar's. A front-end that is still a placeholder
 * refuses every program with ZL_E_UNSUPPORTED. Include with ZL_LANG_X
 * defined; this file undefines nothing. */
ZL_LANG_X(FORTRAN, 1, "FORTRAN", "Reckonwyrm", fortran, ".f .for .f77 .F", "fortran77") /* FORTRAN 77 fixed form, INTEGER subset (1957 lineage) */
ZL_LANG_X(BASIC, 2, "BASIC", "Hatchling", basic, ".bas .BAS", "basic") /* ECMA-55 Minimal BASIC, integer subset (1964 lineage) */
ZL_LANG_X(FORTH, 3, "Forth", "Cairndrake", forth, ".fs .fth .4th", "forth") /* Forth-2012 core subset (1970 lineage) */
ZL_LANG_X(PASCAL, 4, "Pascal", "Tutordrake", pascal, ".pas .p", "pascal") /* ISO 7185 Pascal, integer subset (1970) */
ZL_LANG_X(ALGOL60, 5, "ALGOL 60", "Rootwyrm", algol, ".alg .a60", "algol60") /* Revised Report ALGOL 60, integer subset (1960) */
ZL_LANG_X(LISP, 6, "LISP", "Coilwyrm", lisp, ".lisp .lsp", "lisp") /* LISP core subset in Common Lisp spelling (1958 lineage) */
ZL_LANG_X(SCHEME, 7, "Scheme", "Spiraldrake", lisp, ".scm .ss", "scheme") /* R7RS small core subset (1975 lineage) */
ZL_LANG_X(LOGO, 8, "Logo", "Kiteling", logo, ".lg .logo", "logo") /* UCBLogo core subset, integers (1967 lineage) */
ZL_LANG_X(MOJO, 9, "Mojo", "Forgewyrm", mojo, ".mojo", "mojo") /* front-end to build: see LINGUA_SPEC.md */
