(* Oberon-07 features of the Lingua subset: CONST, 0-based arrays,
   procedures with value and VAR parameters, a function's closing RETURN,
   IF/ELSIF, WHILE with ELSIF arms, REPEAT, FOR with BY (its limit is
   evaluated every time round), CASE with ranges, INC and DEC, DIV and MOD
   that round down, & OR ~. (* Comments nest. *) *)
MODULE Features;
IMPORT Out;

CONST
  N = 8;
  Step = 3;

VAR
  a: ARRAY N OF INTEGER;
  i, j, total, limit: INTEGER;
  done: BOOLEAN;

PROCEDURE Fill(VAR count: INTEGER);
VAR
  k: INTEGER;
BEGIN
  count := 0;
  k := 0;
  REPEAT
    a[k] := k * k - 2 * k;
    INC(count);
    INC(k)
  UNTIL k = N
END Fill;

PROCEDURE Kind(n: INTEGER): INTEGER;
VAR
  r: INTEGER;
BEGIN
  CASE n MOD 7 OF
    0: r := 0
  | 1..3: r := 1
  | 4, 6: r := 2
  | 5: r := 3
  END
  RETURN r
END Kind;

PROCEDURE Gcd(x, y: INTEGER): INTEGER;
BEGIN
  WHILE x > y DO
    DEC(x, y)
  ELSIF y > x DO
    DEC(y, x)
  END
  RETURN x
END Gcd;

BEGIN
  Fill(total);
  FOR i := N - 1 TO 0 BY -Step DO
    Out.Int(a[i], 4)
  END;
  Out.Ln;
  Out.String("count ");
  Out.Int(total, 0);
  Out.String(", gcd ");
  Out.Int(Gcd(84, 36), 0);
  Out.Ln;
  limit := 4;
  j := 0;
  FOR i := 1 TO limit DO
    INC(j);
    IF i = 2 THEN
      limit := 6
    END
  END;
  Out.Int(i, 0);
  Out.Int(j, 3);
  Out.Ln;
  total := 0;
  i := 0;
  WHILE i < 20 DO
    INC(i, 3);
    IF ODD(i) THEN
      DEC(total, Kind(i))
    ELSIF i MOD 4 = 0 THEN
      INC(total, 10 * Kind(i))
    ELSE
      INC(total, Kind(i))
    END
  END;
  Out.Int(i, 0);
  Out.Int(total, 4);
  Out.Ln;
  Out.Int(-7 DIV 2, 3);
  Out.Int((-7) DIV 2, 3);
  Out.Int((-7) MOD 2, 3);
  Out.Int(7 DIV 2, 3);
  Out.Int(ABS(-9), 3);
  Out.Int(2147483647, 12);
  Out.Ln;
  done := (total # 0) & ~(i < 0) OR FALSE;
  IF done THEN
    Out.String("done")
  END;
  Out.Ln
END Features.
