;;; Admitted forms, one or two uses each
(defvar *count* 0)
(defparameter *base* 10)
(defun fact (n) (if (< n 2) 1 (* n (fact (- n 1)))))
(defun sum-to (n acc) (if (= n 0) acc (sum-to (- n 1) (+ acc n))))
(defun evenp2 (n) (if (zerop n) t (oddp2 (1- n))))
(defun oddp2 (n) (if (zerop n) nil (evenp2 (1- n))))
(print (fact 20))
(print (sum-to 100000 0))
(print (evenp2 10))
(print (list 1 2 'foo (cons 3 4) nil t))
(prin1 "hi \"there\"")
(princ " plain")
(terpri)
(format t "~a + ~d = ~s~%" 1 2 (+ 1 2))
(format t "list ~a~~~%" '(a (b . c) d))
(let ((x 1) (y 2)) (print (+ x y)))
(let* ((x 1) (y (+ x 1))) (print (* x y)))
(setq *count* (+ *count* 5))
(print *count*)
(incf *count*)
(incf *count* 10)
(decf *count* 2)
(print *count*)
(dotimes (i 3) (print i))
(print (dotimes (i 4 (* i 10))))
(print (do ((i 0 (+ i 1)) (acc nil (cons i acc))) ((= i 4) acc)))
(print (cond ((> 1 2) 'a) ((< 1 2) 'b) (t 'c)))
(print (cond ((> 1 2) 'a)))
(print (cond (5)))
(print (when (> 2 1) 'yes))
(print (unless (> 2 1) 'yes))
(print (and 1 2 3))
(print (and 1 nil 3))
(print (or nil nil 7))
(print (or))
(print (and))
(print (not nil))
(print (null '(1)))
(print (list (floor 7 2) (floor -7 2) (truncate -7 2) (ceiling 7 2) (mod -7 2) (rem -7 2)))
(print (list (abs -5) (min 3 1 2) (max 3 1 2) (1+ 5) (1- 5) (expt 2 10) (/ 12 4)))
(print (list (= 1 1 1) (< 1 2 3) (< 1 3 2) (>= 3 3 1) (/= 1 2)))
(print (list (zerop 0) (plusp 1) (minusp 1) (evenp 4) (oddp 4) (numberp 'a) (symbolp 'a) (symbolp nil) (consp '(1)) (atom 1) (listp nil)))
(print (list (eq 'a 'a) (eql 3 3) (equal '(1 (2 3)) '(1 (2 3))) (equal '(1 2) '(1 3))))
(print (list (car '(1 2 3)) (cdr '(1 2 3)) (cadr '(1 2 3)) (cddr '(1 2 3)) (caddr '(1 2 3)) (car nil)))
(print (list (first '(1 2)) (rest '(1 2)) (second '(1 2)) (third '(1 2 3))))
(print (list (length '(1 2 3)) (append '(1 2) '(3 4)) (append) (append '(1) '(2) '(3)) (reverse '(1 2 3))))
(print (member 2 '(1 2 3)))
(print (assoc 'b '((a . 1) (b . 2))))
(print (assoc 'z '((a . 1))))
(defvar *l* (list 1 2 3))
(print (rplaca *l* 9))
(print (rplacd *l* '(8)))
(push 0 *l*)
(print *l*)
(print (pop *l*))
(print *l*)
(labels ((sq (x) (* x x)) (cube (x) (* x (sq x)))) (print (cube 3)))
(setf *base* 3)
(print *base*)
(print (let ((v nil) w) (list v w)))
(print 'done)
