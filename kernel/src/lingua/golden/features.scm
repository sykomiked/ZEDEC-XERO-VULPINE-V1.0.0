;;; Admitted forms, one or two uses each
(define count 0)
(define (fact n) (if (< n 2) 1 (* n (fact (- n 1)))))
(define sum-to (lambda (n acc) (if (= n 0) acc (sum-to (- n 1) (+ acc n)))))
(define (ev? n) (if (zero? n) #t (od? (- n 1))))
(define (od? n) (if (zero? n) #f (ev? (- n 1))))
(define (show x) (display x) (newline))
(show (fact 20))
(show (sum-to 100000 0))
(show (ev? 10))
(show (list 1 2 'foo (cons 3 4) '() #t #f))
(write "hi \"there\"\n")
(display " plain")
(newline)
(let ((x 1) (y 2)) (show (+ x y)))
(let* ((x 1) (y (+ x 1))) (show (* x y)))
(set! count (+ count 5))
(show count)
(show (let loop ((i 0) (acc '())) (if (= i 5) acc (loop (+ i 1) (cons i acc)))))
(show (do ((i 0 (+ i 1)) (acc '() (cons i acc))) ((= i 4) acc)))
(do ((i 0 (+ i 1))) ((= i 3)) (show i))
(show (cond ((> 1 2) 'a) ((< 1 2) 'b) (else 'c)))
(show (and 1 2 3))
(show (and 1 #f 3))
(show (or #f #f 7))
(show (or))
(show (and))
(show (not #f))
(show (not '()))
(show (null? '()))
(show (list (quotient -7 2) (remainder -7 2) (modulo -7 2) (floor-quotient -7 2) (floor-remainder -7 2) (truncate-quotient 7 -2) (truncate-remainder 7 -2)))
(show (list (abs -5) (min 3 1 2) (max 3 1 2) (expt 2 10) (/ 12 4)))
(show (list (= 1 1 1) (< 1 2 3) (< 1 3 2) (>= 3 3 1)))
(show (list (zero? 0) (positive? 1) (negative? 1) (even? 4) (odd? 4) (number? 'a) (symbol? 'a) (symbol? '()) (pair? '(1)) (integer? 3)))
(show (list (eq? 'a 'a) (eqv? 3 3) (equal? '(1 (2 3)) '(1 (2 3))) (equal? '(1 2) '(1 3))))
(show (list (car '(1 2 3)) (cdr '(1 2 3)) (cadr '(1 2 3)) (cddr '(1 2 3)) (caddr '(1 2 3))))
(show (list (length '(1 2 3)) (append '(1 2) '(3 4)) (append) (append '(1) '(2) '(3)) (reverse '(1 2 3))))
(show (memq 'c '(a b c d)))
(show (member '(1) '((0) (1) (2))))
(show (assq 'b '((a . 1) (b . 2))))
(show (assoc '(k) '(((k) . 5))))
(show (assv 'z '((a . 1))))
(define l (list 1 2 3))
(set-car! l 9)
(set-cdr! (cdr l) '(7))
(show l)
(define (outer n)
  (define k 10)
  (define (inner m) (+ m k n))
  (inner 1))
(show (outer 5))
(when (> 2 1) (show 'yes))
(unless (> 2 1) (show 'no))
(show 'Done)
