(define (ev? n) (if (zero? n) #t (od? (sub1 n))))
(define (od? n) (if (zero? n) #f (ev? (sub1 n))))
(define (count-down n)
  (unless (< n 1)
    (display n)
    (display " ")
    (count-down (- n 1))))

