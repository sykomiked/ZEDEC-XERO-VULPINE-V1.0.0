10 REM THE SAME THREE ALGORITHMS AS COLLATZ.F AND COLLATZ.FS
20 FOR N = 1 TO 12
30 LET K = N
40 LET S = 0
50 IF K = 1 THEN 110
60 IF INT(K/2)*2 = K THEN 90
70 LET K = 3*K + 1
80 GOTO 100
90 LET K = K/2
100 LET S = S + 1
105 GOTO 50
110 PRINT N; S
120 NEXT N
130 LET A = 1071
140 LET B = 462
150 IF B = 0 THEN 200
160 LET T = A - INT(A/B)*B
170 LET A = B
180 LET B = T
190 GOTO 150
200 PRINT "GCD"; A
210 LET F = 0
220 LET G = 1
230 FOR I = 1 TO 15
240 PRINT F
250 LET T = F + G
260 LET F = G
270 LET G = T
280 NEXT I
290 END
