#else
// the products: 4 rows a workgroup, 32 threads a row, tiles of ZV_T tokens.
// pc.u: 0 rows (this dispatch), 1 nb, 2 astride, 3 B, 4 rowbytes, 5 ystride
// (rows of the whole product), 6 row0 (this dispatch's first row in y).
// Bindings: 0 weights (from row0), 1 a (int16), 2 shifts, 3 sums, 4 y.
#    define ZV_TILED (((ZK - 100) / 3) == 1)
#    define ZV_QT    (((ZK - 100) % 3) == 0 ? 12u : ((ZK - 100) % 3) == 1 ? 14u : 8u)
#    if ZV_TILED
#        define ZV_T 8u
#    else
#        define ZV_T 1u
#    endif
layout(local_size_x = 128) in;
shared zl red[ZV_T * 128u]; // in the ZV_I32 build, pairs of 32-bit words
void main()
{
    zu lid = gl_LocalInvocationID.x, sg = lid >> 5, lane = lid & 31u;
    zu r = gl_WorkGroupID.x * 4u + sg;
    zu rows = pc.u[0], nb = pc.u[1], as = pc.u[2], B = pc.u[3], sb = as / 32u;
    zu t0 = gl_WorkGroupID.y * ZV_T, nt = min(ZV_T, B - t0);
    bool live = r < rows;
    zl acc[ZV_T];
    for (zu t = 0u; t < ZV_T; t++) acc[t] = l_i(0);
    if (live) {
        uint row = r * pc.u[4];
        for (zu b = lane; b < nb; b += 32u)
            for (zu t = 0u; t < ZV_T; t++)
                if (t < nt) {
                    zu tok = t0 + t;
                    acc[t] = l_add(acc[t], zm_sub(ZV_QT, row, b, 2u * (tok * as + b * 32u),
                                                  zi(ld8_2(tok * sb + b)),
                                                  ld32_3(4u * (tok * sb + b))));
                }
    }
    for (zu t = 0u; t < ZV_T; t++) red[t * 128u + lid] = acc[t];
    barrier();
    if (live && lane < nt) {
        zl s = l_i(0);
        for (zu l = 0u; l < 32u; l++) s = l_add(s, red[lane * 128u + sg * 32u + l]);
        st32_4(4u * ((t0 + lane) * pc.u[5] + pc.u[6] + r), uint(zm_round(s)));
    }
}
#endif
