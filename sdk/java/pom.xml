<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.zedec</groupId>
  <artifactId>zxv</artifactId>
  <version>1.6.0</version>
  <packaging>jar</packaging>

  <name>ZXV SDK for the JVM</name>
  <description>Java (and Kotlin/Scala) bindings for libzxv, the ZXV platform C ABI, built on the
    Foreign Function and Memory API.</description>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>22</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <!-- Where the C library was built. Tests load it explicitly from here. -->
    <zxv.native.dir>${project.basedir}/../libzxv/build</zxv.native.dir>
    <zxv.lib.file>libzxv.so</zxv.lib.file>
    <zxv.library>${zxv.native.dir}/${zxv.lib.file}</zxv.library>
    <zxv.fixtures>${project.basedir}/../conformance/fixtures</zxv.fixtures>
    <zxv.vectors>${project.basedir}/../conformance/vectors.json</zxv.vectors>
    <!-- Platform folder used when bundling the native library into the jar. -->
    <zxv.native.platform>linux-x86_64</zxv.native.platform>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>22</release>
          <compilerArgs>
            <arg>-Xlint:all,-restricted,-try</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- Tests run on the class path, so native access is granted to ALL-UNNAMED. -->
          <useModulePath>false</useModulePath>
          <argLine>--enable-native-access=ALL-UNNAMED -Dzxv.library=${zxv.library}</argLine>
          <systemPropertyVariables>
            <zxv.fixtures>${zxv.fixtures}</zxv.fixtures>
            <zxv.vectors>${zxv.vectors}</zxv.vectors>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Platform folder names match NativeLoader.platform(). -->
    <profile>
      <id>linux-aarch64</id>
      <activation><os><family>unix</family><name>Linux</name><arch>aarch64</arch></os></activation>
      <properties><zxv.native.platform>linux-aarch64</zxv.native.platform></properties>
    </profile>
    <profile>
      <id>macos-aarch64</id>
      <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
      <properties>
        <zxv.lib.file>libzxv.dylib</zxv.lib.file>
        <zxv.native.platform>macos-aarch64</zxv.native.platform>
      </properties>
    </profile>
    <profile>
      <id>macos-x86_64</id>
      <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
      <properties>
        <zxv.lib.file>libzxv.dylib</zxv.lib.file>
        <zxv.native.platform>macos-x86_64</zxv.native.platform>
      </properties>
    </profile>
    <!-- Bundle the locally built libzxv into the jar under /native/<os>-<arch>/
         when it exists, so the jar works without ZXV_LIBRARY_PATH. -->
    <profile>
      <id>bundle-native</id>
      <activation>
        <file>
          <exists>${basedir}/../libzxv/build</exists>
        </file>
      </activation>
      <build>
        <resources>
          <resource>
            <directory>${zxv.native.dir}</directory>
            <includes>
              <include>${zxv.lib.file}</include>
            </includes>
            <targetPath>native/${zxv.native.platform}</targetPath>
          </resource>
        </resources>
      </build>
    </profile>
  </profiles>
</project>
