# payment.sutra - the PAYMENT-REC copybook (payment.cpy) in Sutra.
record payment-rec
  pay-ref: x(16)
  pay-amount: s9(13)v99 comp-3     # exact: 13 digits, 2 implied decimals
  pay-ccy: x(3)
  pay-from: 9(9) comp
  pay-to: 9(9) comp
  pay-value-date: 9(8)
  pay-fee: s9(5)v99                # zoned decimal, sign overpunched
  pay-status: x
  filler: x(4)
