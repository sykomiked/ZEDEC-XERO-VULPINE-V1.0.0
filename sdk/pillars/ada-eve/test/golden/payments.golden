#
# payments.golden - the example in both forms: one digest, the canonical
# encoding of a filled-in payment byte for byte, exact puts and refusals.
layout ../../examples/payments.ads
same ../../examples/payments.eve
same payments_spelled.ads
differ payments_other.eve
digest 2c3a553116257c1d64a240a9d44ce63bbc61ccabd2a03b0595006af5ba945b46
type payment
size 74
get value_date 19000101
get state fresh
get amount 0.00
check
put ref INV-2024-0001
put amount 1234.56
put ccy NGN
put from 1
put to 4294967295
put value_date 20240131
put fee_charge -2.5
put breakdown(1) 1000
put breakdown(4) 3/4
put state posted
get ref "INV-2024-0001   "
get amount 1234.56
rat amount 30864/25
get ccy ngn
get fee_charge -2.50
get breakdown(4) 0.75
check
bytes 494e562d323032342d30303031202020000000000001e2400000000001ffffffff0134d703ffffff0600000000000186a000000000000000000000000000000000000000000000004b01
put-fail amount 0.001 ZE_E_FIT
put-fail amount 1/3 ZE_E_FIT
put-fail amount 10000000000000.00 ZE_E_FIT
put-fail fee_charge 1000 ZE_E_FIT
put-fail state refused ZE_E_FIT
put-fail ccy EUR ZE_E_FIT
put-fail from -1 ZE_E_FIT
put-fail value_date 18991231 ZE_E_FIT
put-fail ref INV-2024-00000001 ZE_E_FIT
put-fail breakdown(5) 1 ZXV_E_RANGE
put-fail breakdown(0) 1 ZXV_E_RANGE
put-fail amount 1e3 ZXV_E_FORMAT
put-fail nothing 1 ZXV_E_NOT_FOUND
get-fail breakdown ZXV_E_ARG
# a byte the type cannot hold: state = 2 (refused) is outside fresh .. posted
load 494e562d323032342d30303031202020000000000001e2400000000001ffffffff0134d703ffffff0600000000000186a000000000000000000000000000000000000000000000004b02
check-fail ZE_E_DATA
# and a currency position past usd
load 494e562d323032342d30303031202020000000000001e2400500000001ffffffff0134d703ffffff0600000000000186a000000000000000000000000000000000000000000000004b01
check-fail ZE_E_DATA
