#
# limits.golden - every width at both ends of its range.
layout limits.ads
same limits.eve
type edges
# 8 + 1 + 1 + 2 + 2 + 4 + 4 + 8 + 1
size 31
get h 7
put w -9223372036854775808
put a 255
put b -128
put c 65535
put d -32768
put e 4294967295
put f -2147483648
put g 4294967296
bytes 8000000000000000ff80ffff8000ffffffff80000000000000010000000007
get w -9223372036854775808
put w 9223372036854775807
get w 9223372036854775807
put-fail w 9223372036854775808 ZE_E_FIT
put-fail w -9223372036854775809 ZE_E_FIT
put-fail a 256 ZE_E_FIT
put-fail b -129 ZE_E_FIT
put-fail c -1 ZE_E_FIT
put-fail d 32768 ZE_E_FIT
put-fail e 4294967296 ZE_E_FIT
put-fail f 2147483648 ZE_E_FIT
put-fail g 4294967297 ZE_E_FIT
put-fail h 8 ZE_E_FIT
put-fail a 1.5 ZE_E_FIT
put a 2.000
get a 2
check
