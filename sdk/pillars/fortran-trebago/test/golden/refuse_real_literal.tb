! refuse_real_literal.tb - must be refused at the marked place.
trebago refuse_real_literal
  in  x(n)
  out s
  ! the next statement is refused
  s = sum(i, 1.0d0 * x(i))
end
!> refuse TB_E_SYNTAX 8:14
