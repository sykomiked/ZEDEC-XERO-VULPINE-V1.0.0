! divide.tb - exact quotients, and division by an exact zero.
trebago divide
  in  x(n), y(n)
  out r(n)
  r(i) = x(i) / y(i)
end
!> case ok
!> in x = 1, 2, -3
!> in y = 3, -4, 9/2
!> expect r = 1/3, -1/2, -2/3
!> case y(2) = 0
!> in x = 1, 2, 3
!> in y = 1, 0, 1
!> refuse TB_E_DIVZERO 8:15
