! triangular.tb - explicit ranges: lower-triangular products and a sum
! whose range is empty for i = 1.
trebago triangular
  in  a(n, n), x(n)
  out lx(n), below(n)
  lx(i) = sum(j = 1:i, a(i, j) * x(j))
  below(i) = sum(j = 1:i - 1, x(j))
end
!> in a(3,3) = 1, 2, 3, 4, 5, 6, 7, 8, 9
!> in x = 1, 1/2, 1/4
!> expect lx = 1, 9/2, 33/4
!> expect below = 0, 1, 3/2
