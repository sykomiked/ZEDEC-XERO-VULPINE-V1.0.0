! refuse_fractional_power.tb - must be refused at the marked place.
trebago refuse_fractional_power
  in  x(n)
  out s
  ! the next statement is refused
  s = sum(i, x(i) ** 0.5)
end
!> refuse TB_E_SYNTAX 8:22
