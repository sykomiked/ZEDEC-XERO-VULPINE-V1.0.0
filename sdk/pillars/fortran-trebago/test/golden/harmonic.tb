! harmonic.tb - prefix sums of 1/i. Denominators grow like lcm(1..n):
! H(46) still fits int64/int64, H(47) does not and is refused.
trebago harmonic
  in  x(n)          ! only its extent is used
  out h(n)
  h(i) = scan(1 / i)
end
!> case n=6
!> in x = 0, 0, 0, 0, 0, 0
!> expect h = 1, 3/2, 11/6, 25/12, 137/60, 49/20
!> case n=46: the last one that fits
