!
! scale.tb - scaling, axpy and Fortran array-assignment semantics: the
! right-hand side is evaluated for every element before any is stored, so
! r(i) = r(n - i + 1) reverses r.
trebago scale
  in    x(n), alpha
  inout r(n)
  out   y(n), w(n)
  y(i) = alpha * x(i)
  w(i) = y(i) + x(i) / 2 - 1/4
  r(i) = r(n - i + 1)
end
!> case scale
!> in x = 1, -2, 3/7
!> in alpha = 7/3
!> in r = 1, 2, 3
!> expect y = 7/3, -14/3, 1
!> expect w = 31/12, -71/12, 27/28
!> expect r = 3, 2, 1
!> case alpha too large: the product does not fit
!> in x = 1, 9223372036854775807, 1
!> in alpha = 2
!> in r = 0, 0, 0
!> refuse ZXV_E_RANGE 11:16
