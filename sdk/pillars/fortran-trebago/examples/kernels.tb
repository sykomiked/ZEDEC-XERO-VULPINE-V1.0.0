! kernels.tb - the five kernels side by side: sum, dot product, scale
! (axpy), prefix sum and matrix-vector product, plus a Hilbert matrix
! built from its indices.
trebago kernels
  in    x(n), y(n), alpha
  inout z(n)
  out   total, dot, prefix(n), h(n, n), hx(n)
  const third = 1/3

  total = sum(i, x(i))
  dot = sum(i, x(i) * y(i))
  z(i) = alpha * x(i) + z(i)          ! axpy: z = alpha*x + z
  prefix(i) = scan(x(i) * third)      ! running sum of x/3
  h(i, j) = 1 / (i + j - 1)           ! the Hilbert matrix, exactly
  hx(i) = sum(j, h(i, j) * x(j))
end
!> in x = 1, 2, 3
!> in y = 1/2, 1/4, 1/8
!> in alpha = -2/3
!> in z = 1, 1, 1
!> expect total = 6
!> expect dot = 11/8
!> expect z = 1/3, -1/3, -1
!> expect prefix = 1/3, 1, 2
!> expect h = 1, 1/2, 1/3, 1/2, 1/3, 1/4, 1/3, 1/4, 1/5
!> expect hx = 3, 23/12, 43/30
