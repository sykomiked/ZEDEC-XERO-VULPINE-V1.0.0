! dot.tb - the exact dot product. A Fortran program would write
!     s = dot_product(x, y)        ! REAL: rounded at every step
trebago dot
  in  x(n), y(n)
  out s
  s = sum(i, x(i) * y(i))
end
!> in x = 1, 1/2, 1/3
!> in y = 1/3, 1/2, 1
!> expect s = 11/12
