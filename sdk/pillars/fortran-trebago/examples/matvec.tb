! matvec.tb - y = A x over exact rationals; A is column-major, as Fortran
! stores it.   do i = 1, m: y(i) = sum(a(i, :) * x(:))
trebago matvec
  in  a(m, n), x(n)
  out y(m)
  y(i) = sum(j, a(i, j) * x(j))
end
!> in a(2,2) = 1, 1/2, 1/2, 1/3
!> in x = 1, 1
!> expect y = 3/2, 5/6
