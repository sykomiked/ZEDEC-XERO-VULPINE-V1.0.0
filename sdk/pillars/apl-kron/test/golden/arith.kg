# Scalar arithmetic: exact, reduced, and refused when it does not fit.
# Expected values are Python expressions over fractions (tools/gen_golden.py).

=== tenth
apl: 0.1+0.2
k: 0.1+0.2
py: F(3, 10)

=== ten-tenths
apl: +/10⍴0.1
k: +/10#0.1
py: F(1)

=== third
apl: 1r3+1r6
k: 1r3+1r6
py: F(1, 2)

=== negative-literals
apl: ¯1r3×¯3 6 ¯9
k: -1r3*-3 6 -9
py: vec(1, -2, 3)

=== k-minus-is-a-function-after-a-name
k: x:5; x-1
py: F(4)

=== k-strand-negative
k: 3 -1
apl: 3 ¯1
py: vec(3, -1)

=== apl-minus-is-a-function
apl: 3 -1
py: F(2)

=== divide
apl: 1 2 3÷4
k: 1 2 3%4
py: vec(F(1, 4), F(1, 2), F(3, 4))

=== recip
apl: ÷1 ¯2 3r7
canon: (recip (vec 1 -2 3r7))
py: vec(1, F(-1, 2), F(7, 3))

=== divide-by-zero
apl: 1 2 3÷1 0 1
k: 1 2 3%1 0 1
refuse: KR_E_DIVZERO

=== recip-zero
apl: ÷0
refuse: KR_E_DIVZERO

=== zero-literal-denominator
apl: 1r0
refuse: KR_E_DIVZERO

=== max-int-plus-one
apl: 9223372036854775807+1
k: 9223372036854775807+1
refuse: ZXV_E_RANGE

=== max-int-minus-one
apl: 9223372036854775807-1
k: 9223372036854775807-1
py: F(I64 - 1)

=== literal-too-large
apl: 9223372036854775808
refuse: ZXV_E_RANGE

=== square-overflow
apl: 3037000500×3037000500
k: 3037000500*3037000500
refuse: ZXV_E_RANGE

=== square-fits
apl: 3037000499×3037000499
k: 3037000499*3037000499
py: F(3037000499 * 3037000499)

=== denominator-overflow
apl: 1r3037000500×1r3037000500
refuse: ZXV_E_RANGE

=== cancel-then-fit
apl: (9223372036854775807÷2)×2
k: (9223372036854775807%2)*2
py: F(I64)

=== power
apl: 2*10 ¯3 0
py: vec(1024, F(1, 8), 1)

=== power-rational
apl: 2r3*3
py: F(8, 27)

=== power-overflow
apl: 2*63
refuse: ZXV_E_RANGE

=== power-62
apl: 2*62
py: F(2**62)

=== power-negative-base
apl: ¯2*63
refuse: ZXV_E_RANGE

=== power-one
apl: 1*9223372036854775807
py: F(1)

=== power-minus-one
apl: ¯1*9223372036854775807
py: F(-1)

=== power-zero-negative
apl: 0*¯1
refuse: KR_E_DIVZERO

=== power-fractional
apl: 4*1r2
refuse: KR_E_DOMAIN

=== residue
apl: 3|7 ¯7 0 7r2
canon: (res 3 (vec 7 -7 0 7r2))
py: vec(1, 2, 0, F(1, 2))

=== residue-negative-modulus
apl: ¯3|7 ¯7
py: vec(-2, -1)

=== residue-zero
apl: 0|5 ¯1r2
py: vec(5, F(-1, 2))

=== residue-rational-modulus
apl: 1r3|1r2 ¯1r2
py: vec(F(1, 6), F(1, 6))

=== floor-ceiling
apl: (⌊7r2 ¯7r2 3),⌈7r2 ¯7r2 3
k: (_7r2 -7r2 3),ceil 7r2 -7r2 3
py: vec(3, -4, 3, 4, -3, 3)

=== signum-abs
apl: (×¯5 0 2r9),|¯5 0 2r9
canon: (cat (sgn (vec -5 0 2r9)) (abs (vec -5 0 2r9)))
py: vec(-1, 0, 1, 5, 0, F(2, 9))

=== negate-max
apl: -9223372036854775807
k: -(9223372036854775807)
py: F(-I64)

=== max-min
apl: 3 ¯1 1r2⌈2 0 1r3
k: 3 -1 1r2|2 0 1r3
py: vec(3, 0, F(1, 2))

=== min
apl: 3 ¯1 1r2⌊2 0 1r3
k: 3 -1 1r2&2 0 1r3
py: vec(2, -1, F(1, 3))

=== scalar-extension
apl: 10×1 2 3
k: 10*1 2 3
py: vec(10, 20, 30)

=== length-mismatch
apl: 1 2 3+1 2
k: 1 2 3+1 2
refuse: KR_E_LENGTH

=== rank-mismatch
apl: (2 2⍴1)+1 2
k: (2 2#1)+1 2
refuse: KR_E_RANK

=== identity-plus
apl: +1r2
py: F(1, 2)

=== decimal-exact
apl: 12.75-0.05
py: F(1270, 100)

=== exponent-refused
apl: 1e3
k: 1e3
refuse: KR_E_SYNTAX
