# fees.zc — the contract for sdk/kits/z-wasm/examples/plugins/rational_plugin.c.
# Amounts are integer minor units (cents, kobo, ...); bps is basis points.

# fee(amount, bps): proposes amount * bps / 10000 exactly. The host can only
# post whole cents, so the proposal must be a multiple of 1/100 of a minor
# unit at most (den|100), and the call returns 0 (ZXV_OK).
fn fee(amount: int[0..10^12], bps: int[0..10000]) -> int[0..0]
    proposes rat[0..10^12] den|100 max 1;

# run(n): the telescoping sum n/(n+1); returns a four-valued verdict.
fn run(n: int[1..1000]) -> int[0..3] proposes rat[0..1] max 1;

# checksum(n): pure integer work, no proposals.
fn checksum(n: int[0..10^6]) -> int;
