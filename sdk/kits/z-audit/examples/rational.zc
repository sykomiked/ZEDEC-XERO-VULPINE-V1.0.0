# rational.zc — the contract z-audit checks sdk/kits/z-wasm's rational
# example plugin (and its float example plugin) against. The same
# declarations as sdk/kits/z-contract/examples/fees.zc.

fn fee(amount: int[0..10^12], bps: int[0..10000]) -> int[0..0]
    proposes rat[0..10^12] den|100 max 1;

fn run(n: int[1..1000]) -> int[0..3] proposes rat[0..1] max 1;

fn checksum(n: int[0..10^6]) -> int;

# float_plugin.wasm exports average_percent; it is declared so that the
# float plugin fails on its floats, not on a missing declaration.
fn average_percent(total: int, count: int[1..*]) -> int;
