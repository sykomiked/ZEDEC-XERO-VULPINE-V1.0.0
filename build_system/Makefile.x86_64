# Makefile.x86_64 — ZEDEC pqOS x86-64 kernel build
#
# Builds a multiboot2 x86-64 kernel image using gcc/binutils.
# Intended for use inside the Dockerfile.x86_64 container, or on any
# host with an x86_64-elf or native x86_64 toolchain.

CROSS_PREFIX := x86_64-elf-

# Use the x86_64-elf cross toolchain if available; otherwise the host toolchain.
# This must override any inherited environment CC/OBJCOPY (e.g. build-essential
# containers set CC=cc), but a command-line override still takes precedence.
CC      := $(if $(shell which $(CROSS_PREFIX)gcc 2>/dev/null),$(CROSS_PREFIX)gcc,gcc)
LD      := $(if $(shell which $(CROSS_PREFIX)ld 2>/dev/null),$(CROSS_PREFIX)ld,ld)
OBJCOPY := $(if $(shell which $(CROSS_PREFIX)objcopy 2>/dev/null),$(CROSS_PREFIX)objcopy,objcopy)

CFLAGS  := -std=c11 -Wall -Wextra -O2 -ffreestanding -fno-math-errno -nostdlib \
           -fno-stack-protector -fno-pie -no-pie -fno-builtin \
           -ffunction-sections -fdata-sections -fcf-protection=none \
           -Dmemset=fs_memset -Dmemcpy=fs_memcpy -Dstrlen=fs_strlen \
           -Dstrcmp=fs_strcmp -Dstrcpy=fs_strcpy \
           -Dmalloc=fs_malloc -Dcalloc=fs_calloc -Dmemcmp=fs_memcmp \
           -Dpow=fs_pow -Dlog=fs_log \
           -include kernel/include/freestanding.h \
           -Ikernel/arch/arm64 -Ikernel/arch/x86_64 -Ikernel/boot \
           -Ikernel/compat -Ikernel/include -Ikernel/include/freestanding_stubs \
           -Ikernel/src -Ikernel/src/e8 -Ikernel/src/mixmat -Ikernel/src/modbind -Ikernel/src/abacus -Ikernel/src/ai_layer \
           -Ikernel/src/alloc -Ikernel/src/appkit -Ikernel/src/art_studio \
           -Ikernel/src/ascent -Ikernel/src/audiogenomics_pro -Ikernel/src/axiom_matrix \
           -Ikernel/src/battering_ram -Ikernel/src/bios -Ikernel/src/bootfeat \
           -Ikernel/src/bridge -Ikernel/src/broker -Ikernel/src/cards \
           -Ikernel/src/cellular_multikernel -Ikernel/src/chiglet -Ikernel/src/choice \
           -Ikernel/src/chronicle -Ikernel/src/community_chest -Ikernel/src/concord \
           -Ikernel/src/constellation -Ikernel/src/count_house -Ikernel/src/crit168 \
           -Ikernel/src/crown -Ikernel/src/crypto_wallet -Ikernel/src/decent \
           -Ikernel/src/denconnect -Ikernel/src/deploy -Ikernel/src/desktop \
           -Ikernel/src/dual_space -Ikernel/src/dualtrack -Ikernel/src/edp_risk \
           -Ikernel/src/event_sched -Ikernel/src/event_space -Ikernel/src/event_transport \
           -Ikernel/src/finance -Ikernel/src/finance_markets -Ikernel/src/font \
           -Ikernel/src/fractal -Ikernel/src/fusion -Ikernel/src/games \
           -Ikernel/src/gematria -Ikernel/src/hardware -Ikernel/src/hdcm \
           -Ikernel/src/holodeck -Ikernel/src/holographic -Ikernel/src/hypercube \
           -Ikernel/src/icon -Ikernel/src/identity -Ikernel/src/immigration \
           -Ikernel/src/interspace -Ikernel/src/ipfs -Ikernel/src/iphase \
           -Ikernel/src/iso20022 -Ikernel/src/lattice -Ikernel/src/license \
           -Ikernel/src/lightningrod -Ikernel/src/loader -Ikernel/src/logistics \
           -Ikernel/src/lpres -Ikernel/src/mage -Ikernel/src/mesh_net \
           -Ikernel/src/mesh_token -Ikernel/src/ministry -Ikernel/src/mlkem \
           -Ikernel/src/net -Ikernel/src/nlb -Ikernel/src/onepolicy \
           -Ikernel/src/orbital_compat -Ikernel/src/orbital_elevator -Ikernel/src/oseq \
           -Ikernel/src/phase_coord -Ikernel/src/pirate_apps -Ikernel/src/pirate_fleet \
           -Ikernel/src/plnp -Ikernel/src/porter_house -Ikernel/src/predictive \
           -Ikernel/src/prism_break -Ikernel/src/pterm -Ikernel/src/pungent \
           -Ikernel/src/quantum -Ikernel/src/rational -Ikernel/src/reality \
           -Ikernel/src/recon -Ikernel/src/refinery -Ikernel/src/reputation \
           -Ikernel/src/rmag -Ikernel/src/robin_debanks -Ikernel/src/shimmer \
           -Ikernel/src/situation -Ikernel/src/smap -Ikernel/src/social_spaces \
           -Ikernel/src/sovereign_node -Ikernel/src/subterm -Ikernel/src/superpos \
           -Ikernel/src/surplus -Ikernel/src/synthesis -Ikernel/src/telemetry \
           -Ikernel/src/theme -Ikernel/src/tls -Ikernel/src/trispace \
           -Ikernel/src/update -Ikernel/src/vbe -Ikernel/src/vena \
           -Ikernel/src/vino -Ikernel/src/vino_stores -Ikernel/src/virtio \
           -Ikernel/src/voice -Ikernel/src/wyrmgate -Ikernel/src/wyverneye \
           -Ikernel/src/xedit -Ikernel/src/yantra -Ikernel/src/zcapital \
           -Ikernel/src/zxvfs
LDFLAGS := -T kernel/arch/x86_64/linker64.ld -nostdlib -static
LIBGCC  := $(shell $(CC) -print-libgcc-file-name)

