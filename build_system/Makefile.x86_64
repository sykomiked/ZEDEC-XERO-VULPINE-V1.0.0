OBJDIR := build/x86_64
OBJS   := $(OBJDIR)/kernel/arch/x86_64/boot.o \
          $(OBJDIR)/kernel/arch/x86_64/ring3_asm.o \
          $(patsubst %.c,$(OBJDIR)/%.o,$(SRCS))

# Directories created ONCE at parse time, before any recipe runs, so no two -j
# jobs can race for the same parent. The `@mkdir -p $(dir $@)` calls in the
# rules below are kept as a backstop; with the tree already present they never
# do work, and they were the one -j hazard in this file.
OBJDIRS := $(sort $(dir $(OBJS)))
$(shell mkdir -p $(OBJDIRS))

# Header dependencies (-MMD -MP in CFLAGS). Out-of-tree objects PERSIST between
# builds -- that is the point of them -- which makes a stale .o carrying an old
# struct layout possible. Makefile.arm64 records what that costs: a shell struct
# grew two fields, kernel_main.o kept the old size, and writes landed in
# adjacent memory. This file had OBJDIR without header deps, so it carried that
# exposure alone until 2026-08-11.
DEPS := $(OBJS:.o=.d)
-include $(DEPS)

all: kernel_x86_64.bin

$(OBJDIR)/kernel/arch/x86_64/boot.o: kernel/arch/x86_64/boot.asm
	@mkdir -p $(dir $@)
	nasm -f elf64 $< -o $@

$(OBJDIR)/kernel/arch/x86_64/ring3_asm.o: kernel/arch/x86_64/ring3_asm.S
	@mkdir -p $(dir $@)
	$(CC) -ffreestanding -fno-pie -c $< -o $@

$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

# Banner gate: a boot banner is a claim about `nm`, not about the Makefile.
# This build discards unreferenced sections -- CFLAGS passes
# -ffunction-sections -fdata-sections and LDFLAGS above passes
# -Wl,--gc-sections -- so a module can be in SRCS (this Makefile's list; the
# arm64 one calls its KERNEL_SRCS), compile, link, pass its tests and still be
# ABSENT from the binary. That sentence was here before the flag was, and was
# false for x86_64 until 2026-08-10; see the LDFLAGS comment for what the stale
# claim cost. Runs inside the link rule so no unchecked ELF can exist.
# VERIFY_BANNERS=0 bypasses -- for inspecting a broken link, never for shipping.
VERIFY_BANNERS ?= 1

kernel_x86_64.elf: $(OBJS)
	$(CC) $(LDFLAGS) -o $@ $^ $(LIBGCC)
	@if [ "$(VERIFY_BANNERS)" = "1" ]; then \
		build_system/verify_banners.sh $@ || { \
			echo ""; \
			echo "*** BUILD FAILED: a boot banner announces a subsystem that is"; \
			echo "*** not in $@. Either remove the banner or give the module a"; \
			echo "*** real caller -- being in SRCS is not enough under"; \
			echo "*** --gc-sections. See build_system/verify_banners.sh."; \
			rm -f $@; \
			exit 1; \
		}; \
	else \
		echo "  [WARN] banner verification BYPASSED (VERIFY_BANNERS=0)"; \
	fi

kernel_x86_64.bin: kernel_x86_64.elf
	$(OBJCOPY) -O binary $< $@

clean:
	rm -rf $(OBJDIR) kernel_x86_64.elf kernel_x86_64.bin BOOTX64.EFI kernel/arch/x86_64/efi_*.o kernel/arch/x86_64/efi_stub.elf

boot: kernel_x86_64.bin
	qemu-system-x86_64 -kernel kernel_x86_64.bin -m 256M -nographic -serial mon:stdio

# ---- BOOTX64.EFI: self-contained UEFI app that embeds the flat kernel ----
# UEFI hands off in long mode; the kernel is Multiboot1 (32-bit PM at _entry32),
# so efi_trampoline.S drops long mode -> 32-bit PM before jumping in. Relocs are
# stripped, so the C stub is compiled -fpie (rip-relative) with hidden symbols;
# ms_abi is set on efi_main + every UEFI call (Microsoft x64 ABI). The blob is
# .incbin'd, so kernel_x86_64.bin must exist first.
EFI_APP_X64 = BOOTX64.EFI
EFI_X64_OBJS = kernel/arch/x86_64/efi_header.o kernel/arch/x86_64/efi_stub.o \
               kernel/arch/x86_64/efi_trampoline.o kernel/arch/x86_64/efi_kernel_blob.o
EFI_STUB_CFLAGS = -O2 -ffreestanding -fpie -fvisibility=hidden \
                  -mno-red-zone -mgeneral-regs-only -fno-stack-protector -fno-asynchronous-unwind-tables
$(EFI_APP_X64): kernel_x86_64.bin kernel/arch/x86_64/efi_stub.c kernel/arch/x86_64/efi_header.S \
                kernel/arch/x86_64/efi_trampoline.S kernel/arch/x86_64/efi_kernel_blob.S build_system/efi_stub.ld
	$(CC) $(EFI_STUB_CFLAGS) -c -o kernel/arch/x86_64/efi_stub.o kernel/arch/x86_64/efi_stub.c
	$(CC) -c -o kernel/arch/x86_64/efi_header.o kernel/arch/x86_64/efi_header.S
	$(CC) -c -o kernel/arch/x86_64/efi_trampoline.o kernel/arch/x86_64/efi_trampoline.S
	$(CC) -c -o kernel/arch/x86_64/efi_kernel_blob.o kernel/arch/x86_64/efi_kernel_blob.S
	@# The code MUST be position-independent (no .reloc section is emitted, and UEFI
	@# relocates the image). Verify the compiled stub/trampoline use only PC-relative
	@# addressing — any absolute (R_X86_64_32/32S/64) or GOT reloc in code would break
	@# once UEFI loads us at a base other than the link address.
	@if objdump -r kernel/arch/x86_64/efi_stub.o kernel/arch/x86_64/efi_trampoline.o \
	     | grep -qE "R_X86_64_(32|32S|64|GOT|GOTPCREL)"; then \
	   echo "  [EFI][x64] ERROR: non-PC-relative addressing in stub code — not position-independent"; \
	   objdump -r kernel/arch/x86_64/efi_stub.o kernel/arch/x86_64/efi_trampoline.o | grep -E "R_X86_64_(32|32S|64|GOT|GOTPCREL)"; exit 1; fi
	$(LD) -T build_system/efi_stub.ld -o kernel/arch/x86_64/efi_stub.elf $(EFI_X64_OBJS)
	@END=$$(nm kernel/arch/x86_64/efi_stub.elf | awk '/ __image_end$$/{print "0x"$$1}'); \
	 $(OBJCOPY) -O binary --pad-to=$$END kernel/arch/x86_64/efi_stub.elf $(EFI_APP_X64); \
	 echo "  [EFI][x64] $(EFI_APP_X64) padded to SizeOfImage $$END"

efi: $(EFI_APP_X64)

.PHONY: all clean boot

# ---- THE DERIVED PHASE TABLE ------------------------------------------------
# Generated, never committed. build_system/gen_phase_table.sh computes one
# #define per declared module -- its l13 phase, taken from its DRC layer, and
# where verify_layers.sh's layer_of() is silent, from the floor its own local
# includes impose. kernel/include/zxv_decl.h includes the result and ZXV_DECLARE
# pastes ZXV_PHASE_OF_<module> into the module record, so no phase is ever typed
# and a new module gets one the moment it is declared.
#
# GENERATED AT PARSE TIME, ON PURPOSE, NOT AS A RULE. Every object in this build
# includes this header, so as a rule it would have to be a prerequisite of ~300
# targets; miss one and a -j build races a compile against the generator and
# fails intermittently -- the single worst failure mode to debug. A parse-time
# $(shell ...) has run to completion before make has decided what to build at
# all, so no ordering exists to get wrong. It costs ~0.3s and it re-derives on
# every invocation, which is what keeps the table from going stale.
#
# The census goes to $(OBJDIR)/gen/phase_census.txt: a build that silently
# generated the wrong number of phases would be exactly the invisible drift this
# whole mechanism exists to remove.
ZXV_GENDIR    := $(OBJDIR)/gen
ZXV_PHASE_HDR := $(ZXV_GENDIR)/zxv_phase_table.h
$(shell mkdir -p $(ZXV_GENDIR) && sh $(CURDIR)/build_system/gen_phase_table.sh $(CURDIR)/$(ZXV_PHASE_HDR) 2> $(CURDIR)/$(ZXV_GENDIR)/phase_census.txt)
CFLAGS += -I$(ZXV_GENDIR)
