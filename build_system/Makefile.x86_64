# Makefile.x86_64 — ZEDEC pqOS x86-64 kernel build
#
# Builds a multiboot2 x86-64 kernel image using gcc/binutils.
# Intended for use inside the Dockerfile.x86_64 container, or on any
# host with an x86_64-elf or native x86_64 toolchain.

CROSS_PREFIX := x86_64-elf-

# Use the x86_64-elf cross toolchain if available; otherwise the host toolchain.
# This must override any inherited environment CC/OBJCOPY (e.g. build-essential
# containers set CC=cc), but a command-line override still takes precedence.
CC      := $(if $(shell which $(CROSS_PREFIX)gcc 2>/dev/null),$(CROSS_PREFIX)gcc,gcc)
LD      := $(if $(shell which $(CROSS_PREFIX)ld 2>/dev/null),$(CROSS_PREFIX)ld,ld)
OBJCOPY := $(if $(shell which $(CROSS_PREFIX)objcopy 2>/dev/null),$(CROSS_PREFIX)objcopy,objcopy)

# PARALLEL BY DEFAULT, ASKED OF THE HARDWARE, NOT HARDCODED. This file has had
# out-of-tree objects since it was written, so it was already the one arch that
# COULD have built alongside another -- but with no -j anywhere on the main
# path, it still used one core of twelve. Measured against GNU Make 4.3 on the
# build box: `MAKEFLAGS += -j` takes effect from inside a makefile, `JOBS=1`
# serialises, a command-line `-jN` overrides.
NPROC := $(shell nproc 2>/dev/null || echo 4)
JOBS  ?= $(NPROC)
MAKEFLAGS += -j$(JOBS)

CFLAGS  := -std=c11 -Wall -Wextra -O2 -ffreestanding -fno-math-errno -nostdlib \
           -fno-stack-protector -fno-pie -no-pie -fno-builtin \
           -ffunction-sections -fdata-sections -fcf-protection=none \
           -MMD -MP \
           -Dmemset=fs_memset -Dmemcpy=fs_memcpy -Dstrlen=fs_strlen \
           -Dstrcmp=fs_strcmp -Dstrcpy=fs_strcpy \
           -Dmalloc=fs_malloc -Dcalloc=fs_calloc -Dmemcmp=fs_memcmp \
           -Dpow=fs_pow -Dlog=fs_log \
           -include kernel/include/freestanding.h \
           -Ikernel/arch/arm64 -Ikernel/arch/x86_64 -Ikernel/boot \
           -Ikernel/compat -Ikernel/include -Ikernel/include/freestanding_stubs \
           -Ikernel/src -Ikernel/src/e8 -Ikernel/src/mixmat -Ikernel/src/mbcomp -Ikernel/src/modbind -Ikernel/src/abacus -Ikernel/src/ai_layer \
           -Ikernel/src/alloc -Ikernel/src/appkit -Ikernel/src/art_studio \
           -Ikernel/src/ascent -Ikernel/src/audiogenomics_pro -Ikernel/src/axiom_matrix \
           -Ikernel/src/battering_ram -Ikernel/src/bios -Ikernel/src/bootfeat \
           -Ikernel/src/bridge -Ikernel/src/broker -Ikernel/src/cards \
           -Ikernel/src/cellular_multikernel -Ikernel/src/chiglet -Ikernel/src/choice \
           -Ikernel/src/chronicle -Ikernel/src/community_chest -Ikernel/src/concord \
           -Ikernel/src/constellation -Ikernel/src/count_house -Ikernel/src/crit168 \
           -Ikernel/src/crown -Ikernel/src/crypto_wallet -Ikernel/src/decent \
           -Ikernel/src/denconnect -Ikernel/src/deploy -Ikernel/src/dharma \
           -Ikernel/src/display -Ikernel/src/desktop \
           -Ikernel/src/dual_space -Ikernel/src/dualtrack -Ikernel/src/edp_risk \
           -Ikernel/src/event_sched -Ikernel/src/event_space -Ikernel/src/event_transport \
           -Ikernel/src/finance -Ikernel/src/finance_markets -Ikernel/src/font \
           -Ikernel/src/fractal -Ikernel/src/fusion -Ikernel/src/games \
           -Ikernel/src/gematria -Ikernel/src/hardware -Ikernel/src/hdcm \
           -Ikernel/src/holodeck -Ikernel/src/holographic -Ikernel/src/hypercube \
           -Ikernel/src/icon -Ikernel/src/identity -Ikernel/src/immigration \
           -Ikernel/src/interspace -Ikernel/src/ipfs -Ikernel/src/iphase \
           -Ikernel/src/iso20022 -Ikernel/src/lattice -Ikernel/src/license \
           -Ikernel/src/lightningrod -Ikernel/src/loader -Ikernel/src/logistics \
           -Ikernel/src/lpres -Ikernel/src/mage -Ikernel/src/mesh_net \
           -Ikernel/src/mesh_token -Ikernel/src/ministry -Ikernel/src/mlkem \
           -Ikernel/src/net -Ikernel/src/nlb -Ikernel/src/onepolicy \
           -Ikernel/src/orbital_compat -Ikernel/src/orbital_elevator -Ikernel/src/oseq \
           -Ikernel/src/phase_coord -Ikernel/src/pirate_apps -Ikernel/src/pirate_fleet \
           -Ikernel/src/plnp -Ikernel/src/porter_house -Ikernel/src/predictive \
           -Ikernel/src/prism_break -Ikernel/src/pterm -Ikernel/src/pungent \
           -Ikernel/src/quantum -Ikernel/src/rational -Ikernel/src/reality \
           -Ikernel/src/recon -Ikernel/src/refinery -Ikernel/src/reputation \
           -Ikernel/src/rmag -Ikernel/src/robin_debanks -Ikernel/src/sephirot \
           -Ikernel/src/shimmer \
           -Ikernel/src/situation -Ikernel/src/smap -Ikernel/src/social_spaces \
           -Ikernel/src/sovereign_node -Ikernel/src/subterm -Ikernel/src/superpos \
           -Ikernel/src/surplus -Ikernel/src/synthesis -Ikernel/src/telemetry \
           -Ikernel/src/theme -Ikernel/src/tls -Ikernel/src/trispace \
           -Ikernel/src/update -Ikernel/src/vbe -Ikernel/src/zab -Ikernel/src/syscall -Ikernel/src/invproof -Ikernel/src/codec -Ikernel/src/megarom -Ikernel/src/bombsquad -Ikernel/src/video -Ikernel/src/tolvovina -Ikernel/src/vena \
           -Ikernel/src/vino -Ikernel/src/vino_stores -Ikernel/src/virtio \
           -Ikernel/src/voice -Ikernel/src/wyrmgate -Ikernel/src/wyverneye \
           -Ikernel/src/xedit -Ikernel/src/yantra -Ikernel/src/zcapital \
           -Ikernel/src/zxvfs
# --gc-sections, ADDED 2026-08-10, and it is a MEASUREMENT fix before it is a
# size fix. CFLAGS above has carried -ffunction-sections -fdata-sections since
# this file was written, but the link never passed --gc-sections, so nothing was
# ever discarded. The consequence was not a bigger binary -- it was a LIE in the
# only number anyone reads: `nm kernel_x86_64.elf | awk '$$2 ~ /^[TtWi]$$/'`
# counted 2888 text symbols against arm64's 1190, and that was quoted as x86_64
# having more working code. It had the same code plus everything unreachable.
# A symbol count only means "reachable" if the linker was asked to drop what is
# not, so every cross-arch comparison made before this line was meaningless.
#
# MEASURED on the build box 2026-08-10, same tree, same objects, only the link
# changed:  BEFORE 2888 text symbols -> AFTER 298.  2579 symbols across 141 of
# kernel/src's directories were unreachable (emu 249, net 123,
# audiogenomics_pro 114, robin_debanks 67, ... mlkem 30, oseq 20, modbind 20).
# The two boot logs are BYTE-IDENTICAL apart from the qemu pid in the timeout
# line, and both reach [BOOT_OK] -- which is the proof the collection was safe:
# nothing that was executing stopped executing. So the honest reading of x86_64
# is ~10% reachable, WORSE than arm64's ~29%, not better. Those dropped modules
# are staged building blocks, not dead code; they come back the moment something
# calls them, and that is the whole point of being able to see the difference.
#
# The comment further down (the banner gate) and verify_banners.sh's failure
# text both already asserted --gc-sections was in force here. Rather than soften
# two true-in-spirit warnings into "x86_64 is the arch where being in SRCS IS
# enough", the flag was added so the assertions became true.
#
# WHY THE ENTRY GRAPH SURVIVES IT: ENTRY(_start) in linker64.ld roots the NASM
# section .text.boot, which is one section (nasm gets no -ffunction-sections)
# and physically contains the multiboot1 header, the identity page tables,
# gdt64 and _entry32/_entry64 -- so the header cannot be collected away from
# under the loader. linker64.ld already wraps .rodata.zxv_decl in KEEP(), which
# its own comment says was written for exactly this day.
#
# NO GC_ROOTS LIST HERE, deliberately. Makefile.arm64 keeps a $(GC_ROOTS) hook
# and holds it EMPTY, on the rule that retention must never be able to
# impersonate use: -u on a staged module makes `nm` say "present" whether or not
# any call chain reaches it, which is the one thing verify_banners.sh exists to
# detect. Staged modules are expected to disappear from this ELF until something
# calls them. That is the correct reading, not a regression.
LDFLAGS := -T kernel/arch/x86_64/linker64.ld -nostdlib -static \
           -Wl,--gc-sections -Wl,--build-id=none
LIBGCC  := $(shell $(CC) -print-libgcc-file-name)

