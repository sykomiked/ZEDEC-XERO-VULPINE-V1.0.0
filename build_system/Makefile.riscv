KERNEL_OBJS = $(patsubst %.c,$(OBJDIR)/%.o,$(KERNEL_SRCS))

# PARALLEL-SAFE DIRECTORY CREATION. The usual `@mkdir -p $(dir $@)` inside a
# pattern rule is the classic -j hazard, so the whole directory set is created
# ONCE here at parse time, before a single recipe runs and therefore before any
# two jobs can race for the same parent. The in-rule mkdir below is kept as a
# backstop for anything not in this list; with the directories already present
# it never does work.
OBJDIRS := $(sort $(dir $(RISCV_ARCH_OBJS) $(KERNEL_OBJS)))
$(shell mkdir -p $(OBJDIRS))

# Header dependencies (-MMD -MP). NEWLY REQUIRED, not cosmetic: until now every
# build began with `find kernel -name '*.o' -delete`, because in-tree objects
# from another arch had to be swept anyway, and a full rebuild hides missing
# header deps. Out-of-tree objects PERSIST across builds, which is the point --
# and that makes a stale .o carrying an old struct layout newly possible here.
# Makefile.arm64's comment records what that costs: a shell struct grew two
# fields, kernel_main.o kept the old size, and writes landed in adjacent memory.
DEPS = $(RISCV_ARCH_OBJS:.o=.d) $(KERNEL_OBJS:.o=.d)
-include $(DEPS)

TARGET = kernel_riscv.elf
TARGET_BIN = kernel_riscv.bin

.PHONY: all clean run

all: $(TARGET) $(TARGET_BIN)

# Banner gate: a boot banner is a claim about `nm`, not about the Makefile.
# This build discards unreferenced sections -- CFLAGS passes
# -ffunction-sections -fdata-sections and LDFLAGS above passes -Wl,--gc-sections
# -- so a module can be in KERNEL_SRCS, compile, link, pass its tests and still
# be ABSENT from the binary. That sentence stood here while both flags were
# missing, from this file's creation until 2026-08-11; see the LDFLAGS comment.
# Runs inside the link rule so no unchecked ELF can exist.
# VERIFY_BANNERS=0 bypasses -- for inspecting a broken link, never for shipping.
VERIFY_BANNERS ?= 1

$(TARGET): $(RISCV_ARCH_OBJS) $(KERNEL_OBJS)
	$(CC) $(LDFLAGS) -o $@ $^ $(LIBGCC)
	@if [ "$(VERIFY_BANNERS)" = "1" ]; then \
		build_system/verify_banners.sh $@ || { \
			echo ""; \
			echo "*** BUILD FAILED: a boot banner announces a subsystem that is"; \
			echo "*** not in $@. Either remove the banner or give the module a"; \
			echo "*** real caller -- being in KERNEL_SRCS is not enough under"; \
			echo "*** --gc-sections. See build_system/verify_banners.sh."; \
			rm -f $@; \
			exit 1; \
		}; \
	else \
		echo "  [WARN] banner verification BYPASSED (VERIFY_BANNERS=0)"; \
	fi

$(TARGET_BIN): $(TARGET)
	$(OBJCOPY) -O binary $< $@

# ONE pattern rule now covers kernel/arch/riscv/*.c, kernel/src/**/*.c,
# kernel/compat/*.c and kernel/freestanding.c. The last two previously fell
# through to make's BUILT-IN %.o: %.c rule -- which is not the same recipe, and
# on this Makefile silently dropped -nostdinc and the -I list's ordering
# guarantees. Naming every input explicitly removes that quiet second path.
$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

# boot.s is ASSEMBLY and must not get an implicit .c prerequisite, so it is an
# explicit rule (explicit beats pattern in GNU make).
$(OBJDIR)/kernel/arch/riscv/boot.o: kernel/arch/riscv/boot.s
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

run: $(TARGET)
	qemu-system-riscv64 -M virt -cpu rv64 -m 256M \
		-kernel $(TARGET) -nographic -serial mon:stdio

clean:
	rm -rf $(OBJDIR) $(TARGET) $(TARGET_BIN)

# ---- THE DERIVED PHASE TABLE ------------------------------------------------
# Generated, never committed. build_system/gen_phase_table.sh computes one
# #define per declared module -- its l13 phase, taken from its DRC layer, and
# where verify_layers.sh's layer_of() is silent, from the floor its own local
# includes impose. kernel/include/zxv_decl.h includes the result and ZXV_DECLARE
# pastes ZXV_PHASE_OF_<module> into the module record, so no phase is ever typed
# and a new module gets one the moment it is declared.
#
# GENERATED AT PARSE TIME, ON PURPOSE, NOT AS A RULE. Every object in this build
# includes this header, so as a rule it would have to be a prerequisite of ~300
# targets; miss one and a -j build races a compile against the generator and
# fails intermittently -- the single worst failure mode to debug. A parse-time
# $(shell ...) has run to completion before make has decided what to build at
# all, so no ordering exists to get wrong. It costs ~0.3s and it re-derives on
# every invocation, which is what keeps the table from going stale.
#
# The census goes to $(OBJDIR)/gen/phase_census.txt: a build that silently
# generated the wrong number of phases would be exactly the invisible drift this
# whole mechanism exists to remove.
ZXV_GENDIR    := $(OBJDIR)/gen
ZXV_PHASE_HDR := $(ZXV_GENDIR)/zxv_phase_table.h
$(shell mkdir -p $(ZXV_GENDIR) && sh $(CURDIR)/build_system/gen_phase_table.sh $(CURDIR)/$(ZXV_PHASE_HDR) 2> $(CURDIR)/$(ZXV_GENDIR)/phase_census.txt)
CFLAGS += -I$(ZXV_GENDIR)
