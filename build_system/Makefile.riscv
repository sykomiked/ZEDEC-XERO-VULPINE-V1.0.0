# Makefile.riscv — RISC-V 64-bit build for VOVINA SHAKINA kernel
#
# Cross-compiles the ZEDEC pqOS kernel for RISC-V 64 (QEMU virt).
#
# Author: H.M. Michael-Laurence: Curzi (c)
# License: SEL-3.3

CROSS_COMPILE ?= riscv64-linux-gnu-
CC = $(CROSS_COMPILE)gcc
LD = $(CROSS_COMPILE)ld
OBJCOPY = $(CROSS_COMPILE)objcopy

# ---------------------------------------------------------------------------
# PARALLEL BY DEFAULT. ASK THE HARDWARE, DO NOT HARDCODE.
# `nproc` is read at parse time; the fallback of 4 exists only for a host where
# nproc is absent. Measured on the build box: 12.
#
# WHY THIS IS DEFAULTED AND NOT LEFT TO THE CALLER. -j$(nproc) appeared in two
# helper scripts and NEVER in the main build path, so every build this project
# ever ran used one core of twelve -- and building one arch at a time is what
# let four Makefiles drift apart unseen. Parallelism here is a CORRECTNESS
# instrument before it is a speed one: five arches built side by side is what
# makes a divergence visible in the same terminal.
#
# Verified against GNU Make 4.3 on the box: `MAKEFLAGS += -j` does take effect
# from inside a makefile (6 x 2s jobs finished in 2.0s), `JOBS=1` serialises it
# (12.0s), and a command-line `-j2` overrides it (6.0s). Both escape hatches are
# real, so a bisect or a log-ordering question is one variable away.
NPROC := $(shell nproc 2>/dev/null || echo 4)
JOBS  ?= $(NPROC)
MAKEFLAGS += -j$(JOBS)

# OUT-OF-TREE OBJECTS. Every arch writes under its own build/<arch>/ mirror of
# the source path, so all five Makefiles can run AT THE SAME TIME. Before this,
# arm64/riscv/riscv32 wrote kernel/src/x/y.o via $(SRCS:.c=.o) and arm32 via a
# bare `%.o: %.c`, so the four clobbered each other and a stale foreign-arch .o
# surfaced as "file format not recognized". That collision is the entire reason
# ~/zxv/.buildlock exists.
OBJDIR := build/riscv

CFLAGS = -Wall -Wextra -O2 -ffreestanding -fno-math-errno -nostdlib -nostdinc \
         -fno-stack-protector -fno-pie -no-pie \
         -ffunction-sections -fdata-sections \
         -MMD -MP \
         -include kernel/include/freestanding.h \
         -isystem $(shell $(CC) -print-file-name=include) \
         -march=rv64imafd_zicsr -mabi=lp64d \
         -Dmemset=fs_memset -Dmemcpy=fs_memcpy -Dstrlen=fs_strlen -Dstrcmp=fs_strcmp -Dstrcpy=fs_strcpy -Dmalloc=fs_malloc -Dcalloc=fs_calloc -Dmemcmp=fs_memcmp -Dpow=fs_pow -Dlog=fs_log \
         -DRAMFB_FWCFG_BASE=0x10100000UL \
         -mcmodel=medany \
         -Ikernel/arch/arm64 -Ikernel/arch/riscv -Ikernel/boot -Ikernel/compat \
         -Ikernel/include -Ikernel/include/freestanding_stubs -Ikernel/src -Ikernel/src/e8 -Ikernel/src/mixmat -Ikernel/src/mbcomp -Ikernel/src/modbind -Ikernel/src/abacus \
         -Ikernel/src/ai_layer -Ikernel/src/alloc -Ikernel/src/appkit -Ikernel/src/art_studio \
         -Ikernel/src/ascent -Ikernel/src/audiogenomics_pro -Ikernel/src/axiom_matrix -Ikernel/src/battering_ram \
         -Ikernel/src/bios -Ikernel/src/bootfeat -Ikernel/src/bridge -Ikernel/src/broker \
         -Ikernel/src/cards -Ikernel/src/cellular_multikernel -Ikernel/src/chiglet -Ikernel/src/choice \
         -Ikernel/src/chronicle -Ikernel/src/community_chest -Ikernel/src/concord -Ikernel/src/constellation \
         -Ikernel/src/count_house -Ikernel/src/crit168 -Ikernel/src/crown -Ikernel/src/crypto_wallet \
         -Ikernel/src/decent -Ikernel/src/denconnect -Ikernel/src/deploy -Ikernel/src/display -Ikernel/src/desktop \
         -Ikernel/src/dual_space -Ikernel/src/dualtrack -Ikernel/src/edp_risk -Ikernel/src/event_sched \
         -Ikernel/src/event_space -Ikernel/src/event_transport -Ikernel/src/finance -Ikernel/src/finance_markets \
         -Ikernel/src/font -Ikernel/src/fractal -Ikernel/src/fusion -Ikernel/src/games \
         -Ikernel/src/gematria -Ikernel/src/hardware -Ikernel/src/hdcm -Ikernel/src/holodeck \
         -Ikernel/src/holographic -Ikernel/src/hypercube -Ikernel/src/icon -Ikernel/src/identity \
         -Ikernel/src/immigration -Ikernel/src/interspace -Ikernel/src/ipfs -Ikernel/src/iphase \
         -Ikernel/src/iso20022 -Ikernel/src/lattice -Ikernel/src/license -Ikernel/src/lightningrod \
         -Ikernel/src/loader -Ikernel/src/logistics -Ikernel/src/lpres -Ikernel/src/mage \
         -Ikernel/src/mesh_net -Ikernel/src/mesh_token -Ikernel/src/ministry -Ikernel/src/mlkem \
         -Ikernel/src/net -Ikernel/src/nlb -Ikernel/src/onepolicy -Ikernel/src/orbital_compat \
         -Ikernel/src/orbital_elevator -Ikernel/src/oseq -Ikernel/src/phase_coord -Ikernel/src/pirate_apps \
         -Ikernel/src/pirate_fleet -Ikernel/src/plnp -Ikernel/src/porter_house -Ikernel/src/predictive \
         -Ikernel/src/prism_break -Ikernel/src/pterm -Ikernel/src/pungent -Ikernel/src/quantum \
         -Ikernel/src/rational -Ikernel/src/reality -Ikernel/src/recon -Ikernel/src/refinery \
         -Ikernel/src/reputation -Ikernel/src/rmag -Ikernel/src/robin_debanks -Ikernel/src/shimmer \
         -Ikernel/src/situation -Ikernel/src/smap -Ikernel/src/social_spaces -Ikernel/src/sovereign_node \
         -Ikernel/src/subterm -Ikernel/src/superpos -Ikernel/src/surplus -Ikernel/src/synthesis \
         -Ikernel/src/telemetry -Ikernel/src/theme -Ikernel/src/tls -Ikernel/src/trispace \
         -Ikernel/src/update -Ikernel/src/vbe -Ikernel/src/zab -Ikernel/src/syscall -Ikernel/src/invproof -Ikernel/src/codec -Ikernel/src/megarom -Ikernel/src/bombsquad -Ikernel/src/video -Ikernel/src/tolvovina -Ikernel/src/vena -Ikernel/src/vino \
         -Ikernel/src/vino_stores -Ikernel/src/virtio -Ikernel/src/voice -Ikernel/src/wyrmgate \
         -Ikernel/src/wyverneye -Ikernel/src/xedit -Ikernel/src/yantra -Ikernel/src/zcapital \
         -Ikernel/src/zxvfs

# --gc-sections, ADDED 2026-08-11. Until this line, this file's banner-gate
# comment and verify_banners.sh's failure text BOTH asserted that this build
# "discards unreferenced sections (--gc-sections)" while the link passed no such
# flag and CFLAGS carried no -ffunction-sections either. Nothing was ever
# discarded, so every `nm kernel_riscv.elf` count meant "the .o was linked in",
# never "something reaches it" -- and those counts were quoted next to arm64's,
# which DO mean reached. Two arches, two different meanings, one column.
#
# Both halves were required here, unlike x86_64 where CFLAGS was already right
# and only the link flag was missing: -ffunction-sections -fdata-sections is
# added above so the linker has per-function/per-object sections to collect.
#
# The linker script was written for this day. kernel/arch/riscv/linker.ld
# already carries ENTRY(_start) -- which roots *(.text.boot) from boot.s, one
# section since the assembler gets no -ffunction-sections -- and already wraps
# .rodata.zxv_decl in KEEP(), its own comment saying KEEP is "inert without
# --gc-sections ... written anyway, so adding it later cannot silently empty the
# graph". It also already names .sdata/.sbss/.srodata, whose -fdata-sections
# forms (.sbss.<name> etc.) the existing *(.s*.*) wildcards match, so no global
# escapes the boot.s clear_bss walk over [__bss_start, __bss_end).
#
# MEASURED (see the build report): text symbols BEFORE -> AFTER, with the two
# boot logs byte-identical and both reaching [BOOT_OK]. Identical output is the
# proof the collection was safe: nothing that was executing stopped executing.
# The symbols that vanish are STAGED MODULES, not dead code -- they return the
# moment something calls them, and being able to see that difference is the
# entire point.
#
# NO GC ROOTS HERE, deliberately, on Makefile.arm64's rule: -u on a staged
# module makes `nm` report "present" whether or not any call chain reaches it,
# which is precisely the confusion verify_banners.sh exists to detect.
#
# --build-id=none IS PASSED NOW, matching arm64 and x86_64. It used to be omitted
# on the reasoning that OpenSBI "reads the real entry from the ELF header ... so
# the +0x24 offset the build-id note introduces is carried for us". That premise
# was FALSIFIED 2026-08-11: QEMU 11.0.2 transfers control to the LOAD BASE
# (0x80200000), not the ELF entry (0x80200024), so the hart executed the
# allocated .note.gnu.build-id as instructions and died silently right after the
# OpenSBI banner -- riscv64/riscv32 simply did not boot on a modern QEMU, while
# QEMU 6.2 on the build box booted the identical ELF to [BOOT_OK].
# Proof of cause: patching `j _start` over the note at 0x80200000 made the SAME
# unmodified kernel reach [BOOT_OK] under QEMU 11.
# Yes, this shifts every address in the image by 0x24 -- that is the point:
# _start lands ON the load base, so entry-vs-base can no longer disagree. The
# linker script also /DISCARD/s the note as a belt-and-braces backstop.
LDFLAGS = -T kernel/arch/riscv/linker.ld -nostdlib -static \
          -Wl,--build-id=none -Wl,--gc-sections
LIBGCC = $(shell $(CC) -print-libgcc-file-name)

RISCV_ARCH_OBJS = \
    $(OBJDIR)/kernel/arch/riscv/boot.o \
    $(OBJDIR)/kernel/arch/riscv/uart_ns16550.o \
    $(OBJDIR)/kernel/arch/riscv/plic.o \
    $(OBJDIR)/kernel/arch/riscv/riscv_timer.o \
    $(OBJDIR)/kernel/arch/riscv/riscv_mmu.o \
    $(OBJDIR)/kernel/arch/riscv/kernel_main_riscv.o

