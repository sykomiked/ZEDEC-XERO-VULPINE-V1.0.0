KERNEL_OBJS = $(patsubst %.c,$(OBJDIR)/%.o,$(KERNEL_SRCS))

# Directories created ONCE at parse time, before any recipe runs, so no two -j
# jobs can race for the same parent. The in-rule mkdir is a backstop only.
OBJDIRS := $(sort $(dir $(RISCV_ARCH_OBJS) $(KERNEL_OBJS)))
$(shell mkdir -p $(OBJDIRS))

# Header dependencies. Newly required now that objects survive between builds:
# the old `find kernel -name '*.o' -delete` ritual was a full rebuild in
# disguise, and a full rebuild hides missing header deps. See Makefile.riscv.
DEPS = $(RISCV_ARCH_OBJS:.o=.d) $(KERNEL_OBJS:.o=.d)
-include $(DEPS)

TARGET = kernel_riscv32.elf
TARGET_BIN = kernel_riscv32.bin

.PHONY: all clean run firmware sbi-check

all: $(TARGET) $(TARGET_BIN)

# ---------------------------------------------------------------------------
# SBI FIRMWARE. qemu-system-riscv32 -M virt loads an SBI firmware BEFORE it
# loads our ELF. If the host has none, QEMU exits 1 after 97 bytes of
#   "Unable to load the RISC-V firmware ..."
# and the kernel never executes a single instruction. That abort was previously
# recorded as "riscv32 DEAD"; it is a host provisioning gap, not a kernel fault.
#
# build_system/riscv32_sbi.sh hardcodes nothing: it asks QEMU for the filename
# it wants and the directories it searches, verifies any candidate really is
# ELF32/RISC-V, and builds OpenSBI with PLATFORM_RISCV_XLEN=32 if the host has
# a source tree but no binary.
#   make -f build_system/Makefile.riscv32 sbi-check   # is the default resolvable?
#   make -f build_system/Makefile.riscv32 firmware    # make it resolvable
# ---------------------------------------------------------------------------
QEMU_MEM ?= 512

sbi-check:
	@build_system/riscv32_sbi.sh check

firmware:
	@build_system/riscv32_sbi.sh install >/dev/null

# Banner gate: a boot banner is a claim about `nm`, not about the Makefile.
# This build discards unreferenced sections -- CFLAGS passes -ffunction-sections
# -fdata-sections and LDFLAGS above passes -Wl,--gc-sections -- so a module can
# be in KERNEL_SRCS, compile, link, pass its tests and still be ABSENT from the
# binary. That sentence stood here while both flags were missing, from this
# file's creation until 2026-08-11; see the LDFLAGS comment.
# Runs inside the link rule so no unchecked ELF can exist.
# VERIFY_BANNERS=0 bypasses -- for inspecting a broken link, never for shipping.
VERIFY_BANNERS ?= 1

$(TARGET): $(RISCV_ARCH_OBJS) $(KERNEL_OBJS)
	$(CC) $(LDFLAGS) -o $@ $^ $(LIBGCC)
	@if [ "$(VERIFY_BANNERS)" = "1" ]; then \
		build_system/verify_banners.sh $@ || { \
			echo ""; \
			echo "*** BUILD FAILED: a boot banner announces a subsystem that is"; \
			echo "*** not in $@. Either remove the banner or give the module a"; \
			echo "*** real caller -- being in KERNEL_SRCS is not enough under"; \
			echo "*** --gc-sections. See build_system/verify_banners.sh."; \
			rm -f $@; \
			exit 1; \
		}; \
	else \
		echo "  [WARN] banner verification BYPASSED (VERIFY_BANNERS=0)"; \
	fi

$(TARGET_BIN): $(TARGET)
	$(OBJCOPY) -O binary $< $@

# ONE pattern rule covers kernel/arch/riscv/*.c, kernel/src/**/*.c,
# kernel/compat/*.c and kernel/freestanding.c. The last two previously fell
# through to make's BUILT-IN %.o: %.c rule -- a different recipe that dropped
# -nostdinc and the -I ordering. That quiet second path is now gone.
$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

# Assembly: explicit rule so no implicit .c prerequisite is inferred.
$(OBJDIR)/kernel/arch/riscv/boot_rv32.o: kernel/arch/riscv/boot_rv32.s
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

# No -cpu: the virt machine's own default rv32 core already carries IMAFDC,
# which is what -march=rv32imafd_zicsr -mabi=ilp32d needs. Naming a core here
# would pin the build to one QEMU's idea of a CPU list.
# -bios is passed ONLY when QEMU's default does not resolve; the helper prints
# an empty path when no flag is needed, so this matches the documented bare
# command on a properly provisioned host.
run: $(TARGET)
	@fw=$$(build_system/riscv32_sbi.sh path) || exit 1; \
	if [ -n "$$fw" ]; then \
		echo "  [SBI] using $$fw"; \
		exec qemu-system-riscv32 -M virt -m $(QEMU_MEM) -bios "$$fw" \
			-kernel $(TARGET) -nographic -serial mon:stdio; \
	else \
		exec qemu-system-riscv32 -M virt -m $(QEMU_MEM) \
			-kernel $(TARGET) -nographic -serial mon:stdio; \
	fi

clean:
	rm -rf $(OBJDIR) $(TARGET) $(TARGET_BIN)

# ---- THE DERIVED PHASE TABLE ------------------------------------------------
# Generated, never committed. build_system/gen_phase_table.sh computes one
# #define per declared module -- its l13 phase, taken from its DRC layer, and
# where verify_layers.sh's layer_of() is silent, from the floor its own local
# includes impose. kernel/include/zxv_decl.h includes the result and ZXV_DECLARE
# pastes ZXV_PHASE_OF_<module> into the module record, so no phase is ever typed
# and a new module gets one the moment it is declared.
#
# GENERATED AT PARSE TIME, ON PURPOSE, NOT AS A RULE. Every object in this build
# includes this header, so as a rule it would have to be a prerequisite of ~300
# targets; miss one and a -j build races a compile against the generator and
# fails intermittently -- the single worst failure mode to debug. A parse-time
# $(shell ...) has run to completion before make has decided what to build at
# all, so no ordering exists to get wrong. It costs ~0.3s and it re-derives on
# every invocation, which is what keeps the table from going stale.
#
# The census goes to $(OBJDIR)/gen/phase_census.txt: a build that silently
# generated the wrong number of phases would be exactly the invisible drift this
# whole mechanism exists to remove.
ZXV_GENDIR    := $(OBJDIR)/gen
ZXV_PHASE_HDR := $(ZXV_GENDIR)/zxv_phase_table.h
$(shell mkdir -p $(ZXV_GENDIR) && sh $(CURDIR)/build_system/gen_phase_table.sh $(CURDIR)/$(ZXV_PHASE_HDR) 2> $(CURDIR)/$(ZXV_GENDIR)/phase_census.txt)
CFLAGS += -I$(ZXV_GENDIR)
