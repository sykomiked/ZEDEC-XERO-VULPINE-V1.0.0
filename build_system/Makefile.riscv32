KERNEL_OBJS = $(KERNEL_SRCS:.c=.o)

TARGET = kernel_riscv32.elf
TARGET_BIN = kernel_riscv32.bin

.PHONY: all clean run

all: $(TARGET) $(TARGET_BIN)

$(TARGET): $(RISCV_ARCH_OBJS) $(KERNEL_OBJS)
	$(CC) $(LDFLAGS) -o $@ $^ $(LIBGCC)

$(TARGET_BIN): $(TARGET)
	$(OBJCOPY) -O binary $< $@

kernel/arch/riscv/%.o: kernel/arch/riscv/%.c
	$(CC) $(CFLAGS) -c -o $@ $<

kernel/arch/riscv/boot.o: kernel/arch/riscv/boot_rv32.s
	$(CC) $(CFLAGS) -c -o $@ $<

kernel/src/%.o: kernel/src/%.c
	$(CC) $(CFLAGS) -c -o $@ $<

run: $(TARGET)
	qemu-system-riscv32 -M virt -cpu rv32 -m 256M \
		-kernel $(TARGET) -nographic -serial mon:stdio

clean:
	rm -f $(RISCV_ARCH_OBJS) $(KERNEL_OBJS) $(TARGET) $(TARGET_BIN)
