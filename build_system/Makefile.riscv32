# Makefile.riscv32 — RISC-V 32-bit build for VOVINA SHAKINA kernel
#
# Cross-compiles the ZEDEC pqOS kernel for RISC-V 32 (QEMU virt).
#
# Author: H.M. Michael-Laurence: Curzi (c)
# License: SEL-3.3

# rv32 via multilib (-march=rv32 in CFLAGS below)
CROSS_COMPILE ?= riscv64-linux-gnu-
CC = $(CROSS_COMPILE)gcc
LD = $(CROSS_COMPILE)ld
OBJCOPY = $(CROSS_COMPILE)objcopy

# PARALLEL BY DEFAULT, ASKED OF THE HARDWARE. See Makefile.riscv for the full
# rationale and the GNU Make 4.3 measurements; the short form: -j$(nproc) lived
# in two helper scripts and never in the main build path, so every build this
# project ran used one core of twelve, and one-arch-at-a-time is exactly how
# five Makefiles drifted apart without anyone seeing it. JOBS=1 serialises,
# a command-line -jN overrides.
NPROC := $(shell nproc 2>/dev/null || echo 4)
JOBS  ?= $(NPROC)
MAKEFLAGS += -j$(JOBS)

# OUT-OF-TREE OBJECTS, one mirror per arch, so all five builds can run AT THE
# SAME TIME. This file's own RISCV_ARCH_OBJS comment below already describes the
# in-tree collision from the entry-object angle -- rv64's boot.o and rv32's
# sharing kernel/arch/riscv/ -- and solved it by renaming ONE object. build/
# generalises that fix to every object in the tree, including the ~200 shared
# kernel/src ones the rename never covered.
OBJDIR := build/riscv32

CFLAGS = -Wall -Wextra -O2 -ffreestanding -fno-math-errno -nostdlib -nostdinc \
         -fno-stack-protector -fno-pie -no-pie \
         -ffunction-sections -fdata-sections \
         -MMD -MP \
         -include kernel/include/freestanding.h \
         -isystem $(shell $(CC) -print-file-name=include) \
         -march=rv32imafd_zicsr -mabi=ilp32d \
         -DRAMFB_FWCFG_BASE=0x10100000UL \
         -mcmodel=medany \
         -Dmemset=fs_memset -Dmemcpy=fs_memcpy -Dstrlen=fs_strlen -Dstrcmp=fs_strcmp -Dstrcpy=fs_strcpy -Dmalloc=fs_malloc -Dcalloc=fs_calloc -Dmemcmp=fs_memcmp -Dpow=fs_pow -Dlog=fs_log \
         -Ikernel/arch/arm64 -Ikernel/arch/riscv -Ikernel/boot -Ikernel/compat \
         -Ikernel/include -Ikernel/include/freestanding_stubs -Ikernel/src -Ikernel/src/e8 -Ikernel/src/mixmat -Ikernel/src/mbcomp -Ikernel/src/modbind -Ikernel/src/abacus \
         -Ikernel/src/ai_layer -Ikernel/src/alloc -Ikernel/src/appkit -Ikernel/src/art_studio \
         -Ikernel/src/ascent -Ikernel/src/audiogenomics_pro -Ikernel/src/axiom_matrix -Ikernel/src/battering_ram \
         -Ikernel/src/bios -Ikernel/src/bootfeat -Ikernel/src/bridge -Ikernel/src/broker \
         -Ikernel/src/cards -Ikernel/src/cellular_multikernel -Ikernel/src/chiglet -Ikernel/src/choice \
         -Ikernel/src/chronicle -Ikernel/src/community_chest -Ikernel/src/concord -Ikernel/src/constellation \
         -Ikernel/src/count_house -Ikernel/src/crit168 -Ikernel/src/crown -Ikernel/src/crypto_wallet \
         -Ikernel/src/decent -Ikernel/src/denconnect -Ikernel/src/deploy -Ikernel/src/display -Ikernel/src/desktop \
         -Ikernel/src/dual_space -Ikernel/src/dualtrack -Ikernel/src/edp_risk -Ikernel/src/event_sched \
         -Ikernel/src/event_space -Ikernel/src/event_transport -Ikernel/src/finance -Ikernel/src/finance_markets \
         -Ikernel/src/font -Ikernel/src/fractal -Ikernel/src/fusion -Ikernel/src/games \
         -Ikernel/src/gematria -Ikernel/src/hardware -Ikernel/src/hdcm -Ikernel/src/holodeck \
         -Ikernel/src/holographic -Ikernel/src/hypercube -Ikernel/src/icon -Ikernel/src/identity \
         -Ikernel/src/immigration -Ikernel/src/interspace -Ikernel/src/ipfs -Ikernel/src/iphase \
         -Ikernel/src/iso20022 -Ikernel/src/lattice -Ikernel/src/license -Ikernel/src/lightningrod \
         -Ikernel/src/loader -Ikernel/src/logistics -Ikernel/src/lpres -Ikernel/src/mage \
         -Ikernel/src/mesh_net -Ikernel/src/mesh_token -Ikernel/src/ministry -Ikernel/src/mlkem \
         -Ikernel/src/net -Ikernel/src/nlb -Ikernel/src/onepolicy -Ikernel/src/orbital_compat \
         -Ikernel/src/orbital_elevator -Ikernel/src/oseq -Ikernel/src/phase_coord -Ikernel/src/pirate_apps \
         -Ikernel/src/pirate_fleet -Ikernel/src/plnp -Ikernel/src/porter_house -Ikernel/src/predictive \
         -Ikernel/src/prism_break -Ikernel/src/pterm -Ikernel/src/pungent -Ikernel/src/quantum \
         -Ikernel/src/rational -Ikernel/src/reality -Ikernel/src/recon -Ikernel/src/refinery \
         -Ikernel/src/reputation -Ikernel/src/rmag -Ikernel/src/robin_debanks -Ikernel/src/shimmer \
         -Ikernel/src/situation -Ikernel/src/smap -Ikernel/src/social_spaces -Ikernel/src/sovereign_node \
         -Ikernel/src/subterm -Ikernel/src/superpos -Ikernel/src/surplus -Ikernel/src/synthesis \
         -Ikernel/src/telemetry -Ikernel/src/theme -Ikernel/src/tls -Ikernel/src/trispace \
         -Ikernel/src/update -Ikernel/src/vbe -Ikernel/src/zab -Ikernel/src/syscall -Ikernel/src/invproof -Ikernel/src/codec -Ikernel/src/megarom -Ikernel/src/bombsquad -Ikernel/src/video -Ikernel/src/tolvovina -Ikernel/src/vena -Ikernel/src/vino \
         -Ikernel/src/vino_stores -Ikernel/src/virtio -Ikernel/src/voice -Ikernel/src/wyrmgate \
         -Ikernel/src/wyverneye -Ikernel/src/xedit -Ikernel/src/yantra -Ikernel/src/zcapital \
         -Ikernel/src/zxvfs

# --gc-sections, ADDED 2026-08-11. The banner-gate comment further down and
# verify_banners.sh's failure text both asserted this build "discards
# unreferenced sections (--gc-sections)" while neither the link nor CFLAGS
# carried anything of the kind, so nothing was ever discarded and every
# `nm kernel_riscv32.elf` count meant "linked in", not "reached". Both halves
# had to change here: -ffunction-sections -fdata-sections is added above.
#
# kernel/arch/riscv/linker.ld is SHARED with rv64 and was written for this: it
# roots *(.text.boot) through ENTRY(_start), KEEP()s .rodata.zxv_decl with a
# comment saying KEEP is inert today "so adding it later cannot silently empty
# the graph", and names .sdata/.sbss/.srodata whose -fdata-sections forms the
# existing wildcards already match -- so nothing escapes boot_rv32.s's clear_bss
# walk over [__bss_start, __bss_end).
#
# LIBGCC IS EMPTY ON THIS TARGET (no ilp32d libgcc exists), which makes section
# collection strictly safer here, not riskier: --gc-sections only ever REMOVES
# references, so any 64-bit divide/shift or __builtin_bswap helper that a staged
# module would have demanded of a libgcc that is not there now gets discarded
# before relocation instead of failing the link.
#
# --build-id=none IS passed now (no GC roots still -- see Makefile.riscv for both
# reasons, and for the 2026-08-11 measurement that reversed the build-id call:
# an allocated note at the 0x80200000 load base is executed as instructions by
# any loader that jumps to the base rather than the ELF entry, which is what
# QEMU 11 does and QEMU 6.2 does not).
LDFLAGS = -T kernel/arch/riscv/linker.ld -nostdlib -static -march=rv32imafd_zicsr -mabi=ilp32d \
          -Wl,--build-id=none -Wl,--gc-sections
LIBGCC =

# boot_rv32.o, NOT boot.o. Makefile.riscv emits boot.o from boot.s (rv64); this
# build emits its own object from boot_rv32.s. When both arches built IN-TREE,
# sharing one output path meant a stale rv64 boot.o could be linked into an rv32
# image (or vice versa) whenever the .o survived a switch, and distinct names
# made that impossible for the entry object. Since 2026-08-11 the two arches no
# longer share a directory at all ($(OBJDIR) above), so the collision is gone
# for every object rather than just this one. The distinct name is KEPT: it costs
# nothing and it is the reason the two boot paths can be told apart in a build log.
RISCV_ARCH_OBJS = \
    $(OBJDIR)/kernel/arch/riscv/boot_rv32.o \
    $(OBJDIR)/kernel/arch/riscv/uart_ns16550.o \
    $(OBJDIR)/kernel/arch/riscv/plic.o \
    $(OBJDIR)/kernel/arch/riscv/riscv_timer.o \
    $(OBJDIR)/kernel/arch/riscv/riscv_mmu.o \
    $(OBJDIR)/kernel/arch/riscv/kernel_main_riscv.o

