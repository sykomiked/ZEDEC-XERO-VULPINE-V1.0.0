#
# FULL-PARITY source set (2026-08-08): mirrors Makefile.arm64's portable src/
# modules so 32-bit carries the same subsystems as 64-bit. The only src/ files
# deliberately excluded are the 3 that depend on the arch layer and need an
# arm32 equivalent brought up on the server:
#   el0_userspace/el0_sched.c  video/ramfb.c  virtio/virtio_bus.c (+ vring.c)
# Everything else is arch-neutral freestanding C and compiles for armv7.

# gcc 11 (freestanding; avoids arm-none-eabi 10.3 _Complex header bug)
CROSS = arm-linux-gnueabihf-
CC = $(CROSS)gcc
AS = $(CROSS)as
LD = $(CROSS)ld
OBJCOPY = $(CROSS)objcopy

CFLAGS = -march=armv7-a -marm -mfpu=vfpv3-d16 -mfloat-abi=hard -ffreestanding -fno-math-errno -nostdlib \
         -include kernel/include/freestanding.h \
         -O2 -Wall -Wextra -std=c11 -fno-stack-protector \
         -Dmemset=fs_memset -Dmemcpy=fs_memcpy -Dstrlen=fs_strlen -Dstrcmp=fs_strcmp -Dstrcpy=fs_strcpy -Dmalloc=fs_malloc -Dcalloc=fs_calloc -Dmemcmp=fs_memcmp -Dpow=fs_pow -Dlog=fs_log \
         -Ikernel/include -Ikernel/include/freestanding_stubs -Ikernel/arch/arm32 \
         -Ikernel/src -Ikernel/src/e8 -Ikernel/src/mixmat -Ikernel/compat \
         -Ikernel/arch/arm32 -Ikernel/arch/arm64 -Ikernel/boot -Ikernel/compat \
         -Ikernel/include -Ikernel/include/freestanding_stubs -Ikernel/src -Ikernel/src/abacus \
         -Ikernel/src/ai_layer -Ikernel/src/alloc -Ikernel/src/appkit -Ikernel/src/apps \
         -Ikernel/src/art_studio -Ikernel/src/ascent -Ikernel/src/audiogenomics_pro -Ikernel/src/axiom_matrix \
         -Ikernel/src/battering_ram -Ikernel/src/bios -Ikernel/src/bootfeat -Ikernel/src/bridge \
         -Ikernel/src/broker -Ikernel/src/cards -Ikernel/src/cellular_multikernel -Ikernel/src/chiglet \
         -Ikernel/src/choice -Ikernel/src/chronicle -Ikernel/src/clock -Ikernel/src/community_chest \
         -Ikernel/src/concord -Ikernel/src/constellation -Ikernel/src/count_house -Ikernel/src/crit168 \
         -Ikernel/src/crown -Ikernel/src/crypto_wallet -Ikernel/src/decent -Ikernel/src/denconnect \
         -Ikernel/src/deploy -Ikernel/src/desktop -Ikernel/src/dual_space -Ikernel/src/dualtrack \
         -Ikernel/src/edp_risk -Ikernel/src/event_sched -Ikernel/src/event_space -Ikernel/src/event_transport \
         -Ikernel/src/finance -Ikernel/src/finance_markets -Ikernel/src/font -Ikernel/src/fractal \
         -Ikernel/src/fusion -Ikernel/src/games -Ikernel/src/gematria -Ikernel/src/hardware \
         -Ikernel/src/hdcm -Ikernel/src/holodeck -Ikernel/src/holographic -Ikernel/src/hypercube \
         -Ikernel/src/icon -Ikernel/src/identity -Ikernel/src/immigration -Ikernel/src/interspace \
         -Ikernel/src/ipfs -Ikernel/src/iphase -Ikernel/src/iso20022 -Ikernel/src/lattice \
         -Ikernel/src/license -Ikernel/src/lightningrod -Ikernel/src/loader -Ikernel/src/logistics \
         -Ikernel/src/lpres -Ikernel/src/mage -Ikernel/src/mesh_net -Ikernel/src/mesh_token \
         -Ikernel/src/ministry -Ikernel/src/mlkem -Ikernel/src/mm -Ikernel/src/net \
         -Ikernel/src/nlb -Ikernel/src/onepolicy -Ikernel/src/orbital_compat -Ikernel/src/orbital_elevator \
         -Ikernel/src/oseq -Ikernel/src/phase_coord -Ikernel/src/pirate_apps -Ikernel/src/pirate_fleet \
         -Ikernel/src/plnp -Ikernel/src/porter_house -Ikernel/src/predictive -Ikernel/src/prism_break \
         -Ikernel/src/pterm -Ikernel/src/pungent -Ikernel/src/quantum -Ikernel/src/rational \
         -Ikernel/src/reality -Ikernel/src/recon -Ikernel/src/refinery -Ikernel/src/reputation \
         -Ikernel/src/rmag -Ikernel/src/robin_debanks -Ikernel/src/sched -Ikernel/src/shimmer \
         -Ikernel/src/situation -Ikernel/src/smap -Ikernel/src/social_spaces -Ikernel/src/sovereign_node \
         -Ikernel/src/subterm -Ikernel/src/superpos -Ikernel/src/surplus -Ikernel/src/synthesis \
         -Ikernel/src/telemetry -Ikernel/src/theme -Ikernel/src/tls -Ikernel/src/trispace \
         -Ikernel/src/update -Ikernel/src/vbe -Ikernel/src/vena -Ikernel/src/vfs \
         -Ikernel/src/vino -Ikernel/src/vino_stores -Ikernel/src/virtio -Ikernel/src/voice \
         -Ikernel/src/wyrmgate -Ikernel/src/wyverneye -Ikernel/src/xedit -Ikernel/src/yantra \
         -Ikernel/src/zcapital -Ikernel/src/zxvfs

LDFLAGS = -T kernel/arch/arm32/linker.ld -nostdlib -static
LIBGCC = $(shell $(CC) -print-libgcc-file-name)

