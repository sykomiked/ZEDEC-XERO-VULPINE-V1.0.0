# Makefile.arm64 — ARM64 build for VOVINA SHAKINA kernel
#
# Cross-compiles the ZEDEC pqOS kernel for AArch64 (QEMU virt).
#
# Author: H.M. Michael-Laurence: Curzi (c)
# License: SEL-3.3

CROSS_COMPILE ?= aarch64-linux-gnu-
CC = $(CROSS_COMPILE)gcc
LD = $(CROSS_COMPILE)ld
OBJCOPY = $(CROSS_COMPILE)objcopy
OBJDUMP = $(CROSS_COMPILE)objdump

KERNEL_SIM_DEVICES ?= 0

CFLAGS = -std=c11 -Wall -Wextra -O2 -ffreestanding -nostdlib \
         -fno-stack-protector -fno-pie -no-pie -fno-builtin \
         -ffunction-sections -fdata-sections \
         -MMD -MP \
         -DKERNEL_SIM_DEVICES=$(KERNEL_SIM_DEVICES) \
         -DENABLE_EL0_USERSPACE=1 -DENABLE_TICK_IRQ=1 \
         -DENABLE_EVENT_LOOP=1 \
         $(CFLAGS_EXTRA) \
         -Dmemset=fs_memset -Dmemcpy=fs_memcpy -Dstrlen=fs_strlen \
         -Dstrcmp=fs_strcmp -Dstrcpy=fs_strcpy \
         -Dmalloc=fs_malloc -Dcalloc=fs_calloc \
         -Dmemcmp=fs_memcmp -Dpow=fs_pow -Dlog=fs_log \
         -include kernel/include/freestanding.h \
         -Ikernel/include -Ikernel/src -Ikernel/arch/arm64 -Ikernel/src/virtio -Ikernel/src/trispace -Ikernel/src/holodeck -Ikernel/src/denconnect -Ikernel/src/mlkem -Ikernel/boot \
         -Ikernel/src/plnp -Ikernel/src/smap -Ikernel/src/decent \
         -Ikernel/src/recon -Ikernel/src/hdcm -Ikernel/src/gematria \
         -Ikernel/src/dualtrack -Ikernel/src/superpos \
         -Ikernel/src/pungent -Ikernel/src/ascent \
         -Ikernel/src/lattice -Ikernel/src/pterm -Ikernel/src/xedit \
         -Ikernel/src/crypto_wallet -Ikernel/src/nlb \
         -Ikernel/src/license -Ikernel/src/surplus -Ikernel/src/edp_risk \
         -Ikernel/src/predictive -Ikernel/src/situation \
         -Ikernel/src/finance -Ikernel/src/identity \
         -Ikernel/src/quantum -Ikernel/src/hardware \
         -Ikernel/src/audiogenomics_pro \
         -Ikernel/src/synthesis -Ikernel/compat \
         -Ikernel/src/vino -Ikernel/src/vena -Ikernel/src/holographic \
         -Ikernel/src/axiom_matrix -Ikernel/src/telemetry \
         -Ikernel/src/oseq -Ikernel/src/rmag -Ikernel/src/lpres \
         -Ikernel/src/iphase -Ikernel/src/choice -Ikernel/src/phase_coord \
         -Ikernel/src/crit168 -Ikernel/include/freestanding_stubs \
         -Ikernel/src/net \
         -Ikernel/src/count_house -Ikernel/src/porter_house \
         -Ikernel/src/event_sched \
         -Ikernel/src/mesh_token \
         -Ikernel/src/community_chest \
         -Ikernel/src/ai_layer \
         -Ikernel/src/mesh_net \
         -Ikernel/src/immigration \
         -Ikernel/src/robin_debanks \
         -Ikernel/src/prism_break \
         -Ikernel/src/vbe \
         -Ikernel/src/desktop \
         -Ikernel/src/cellular_multikernel \
         -Ikernel/src/event_space \
         -Ikernel/src/orbital_elevator \
         -Ikernel/src/constellation \
         -Ikernel/src/event_transport \
         -Ikernel/src/hypercube \
         -Ikernel/src/yantra \
         -Ikernel/src/dual_space \
         -Ikernel/src/zxvfs \
         -Ikernel/src/loader \
         -Ikernel/src/appkit \
         -Ikernel/src/shimmer \
         -Ikernel/src/fractal \
         -Ikernel/src/rational \
         -Ikernel/src/abacus \
         -Ikernel/src/lightningrod \
         -Ikernel/src/bios \
         -Ikernel/src/chiglet -Ikernel/src/cards -Ikernel/src/refinery -Ikernel/src/concord -Ikernel/src/wyrmgate -Ikernel/src/wyverneye -Ikernel/src/chronicle \
         -Ikernel/src/deploy -Ikernel/src/theme -Ikernel/src/icon -Ikernel/src/font -Ikernel/src/bridge -Ikernel/src/update -Ikernel/src/mage -Ikernel/src/reality -Ikernel/src/bootfeat \
         -Ikernel/src/onepolicy -Ikernel/src/zcapital -Ikernel/src/ipfs -Ikernel/src/crown -Ikernel/src/ministry \
         -Ikernel/src/vino_stores -Ikernel/src/interspace -Ikernel/src/broker -Ikernel/src/battering_ram -Ikernel/src/tls -Ikernel/src/finance_markets -Ikernel/src/iso20022 -Ikernel/src/alloc \
         -Ikernel/src/pirate_fleet -Ikernel/src/social_spaces -Ikernel/src/reputation -Ikernel/src/art_studio -Ikernel/src/games -Ikernel/src/voice -Ikernel/src/subterm -Ikernel/src/orbital_compat -Ikernel/src/fusion -Ikernel/src/sovereign_node -Ikernel/src/logistics -Ikernel/src/pirate_apps

LDFLAGS = -T kernel/arch/arm64/linker.ld -nostdlib -static -Wl,--gc-sections
LIBGCC = $(shell $(CC) -print-libgcc-file-name 2>/dev/null || echo /usr/lib/gcc-cross/aarch64-linux-gnu/13/libgcc.a)

# ARM64 arch-specific objects
ARM64_ARCH_OBJS = \
    kernel/arch/arm64/boot.o \
    kernel/arch/arm64/uart_pl011.o \
    kernel/arch/arm64/gicv3.o \
    kernel/arch/arm64/arm64_timer.o \
    kernel/arch/arm64/arm64_mmu.o \
    kernel/arch/arm64/arm64_exceptions.o \
    kernel/arch/arm64/boot_evidence.o \
    kernel/arch/arm64/kernel_main_arm64.o \
    kernel/arch/arm64/el0_userspace.o \
    kernel/arch/arm64/user_procs.o \
    kernel/arch/arm64/ramdisk.o \
    kernel/arch/arm64/virtio_blk.o \
    kernel/arch/arm64/virtio_net.o \
    kernel/arch/arm64/virtio_input.o \
    kernel/arch/arm64/virtio_snd.o \
    kernel/arch/arm64/entropy.o

