         -Ikernel/src/chiglet -Ikernel/src/cards -Ikernel/src/refinery -Ikernel/src/concord -Ikernel/src/wyrmgate -Ikernel/src/wyverneye -Ikernel/src/chronicle \
         -Ikernel/src/deploy -Ikernel/src/theme -Ikernel/src/icon -Ikernel/src/font -Ikernel/src/bridge -Ikernel/src/update -Ikernel/src/mage -Ikernel/src/reality -Ikernel/src/bootfeat \
         -Ikernel/src/onepolicy -Ikernel/src/zcapital -Ikernel/src/ipfs -Ikernel/src/crown -Ikernel/src/ministry \
         -Ikernel/src/vino_stores -Ikernel/src/interspace -Ikernel/src/broker -Ikernel/src/battering_ram -Ikernel/src/tls -Ikernel/src/finance_markets -Ikernel/src/iso20022 -Ikernel/src/alloc \
         -Ikernel/src/pirate_fleet -Ikernel/src/social_spaces -Ikernel/src/reputation -Ikernel/src/art_studio -Ikernel/src/games -Ikernel/src/voice -Ikernel/src/subterm -Ikernel/src/orbital_compat -Ikernel/src/fusion -Ikernel/src/sovereign_node -Ikernel/src/logistics -Ikernel/src/pirate_apps \
         -Ikernel/src/acpi -Ikernel/src/audio -Ikernel/src/bluetooth -Ikernel/src/wifi \
         -Ikernel/src/bootlegger -Ikernel/src/browser -Ikernel/src/clock -Ikernel/src/dharana \
         -Ikernel/src/epu -Ikernel/src/fs -Ikernel/src/legal_engine -Ikernel/src/macgyver \
         -Ikernel/src/panopticon -Ikernel/src/rce -Ikernel/src/rur -Ikernel/src/sutra \
         -Ikernel/src/ubh -Ikernel/src/zxpkg \
         -Ikernel/src/sched \
         -Igui
#
# TWO OF THE -I PATHS ABOVE ARE LOAD-BEARING AND WERE MEASURED, NOT GUESSED:
#
#   -Ikernel/src/sched  dharma.h line 56 does `#include "sched.h"`. There is
#     exactly one sched.h in the tree (kernel/src/sched/sched.h) and exactly one
#     out-of-directory includer (dharma.h) -- verified with `find kernel -name
#     sched.h` and `grep -rl '#include "sched.h"'`. Without this path the name
#     resolved to the HOST /usr/include/sched.h, which drags in features.h ->
#     features-time64.h -> bits/wordsize.h, which does not exist for the cross
#     target. That is why five dharma sources "failed to compile": not a code
#     defect, a header shadowed by glibc. Diagnosed from the real error text
#     (`bits/wordsize.h: No such file or directory`), not from the file name.
#
#   -Igui  kernel/src/apps/apps.h line 22 does `#include "gui.h"`, and gui.h
#     lives OUTSIDE kernel/src. Two copies exist and they are byte-identical
#     (`diff gui/gui.h subsystems/gui/gui.h` is empty), so the choice looks
#     arbitrary and is not: gui.h's own includes are RELATIVE
#     (`../kernel/src/vbe/vbe.h`, `../kernel/src/keyboard/keyboard.h`,
#     `../kernel/src/mouse/mouse.h`). From 05_KERNEL/gui/ those resolve to
#     05_KERNEL/kernel/src/... and exist. From 05_KERNEL/subsystems/gui/ they
#     resolve to 05_KERNEL/subsystems/kernel/src/... which does not exist. So
#     only the root-level gui/ copy is usable, and the tie is broken by
#     measurement rather than preference.
#     It is appended LAST on purpose: -I is searched in order, so gui/'s other
#     headers (event.h, layout.h, theme.h) can never shadow kernel/src/theme's
#     theme.h or anything else already on the list.
#     WHAT THIS DOES NOT DO: it does not build the GUI backend. gui/gui.c is
#     outside kernel/src, so verify_layers.sh (which scans `find kernel/src
#     -name '*.c'`) cannot classify it and the DRC would never see it. It is
#     therefore left out, and the consequence is stated plainly: apps.o carries
#     exactly one unresolvable reference, `U gui_create_window` (measured with
#     nm -u; every other undefined symbol in it -- vfs_*, vino_*, vena_*, m5_* --
#     is already in the build). Nothing calls apps_*, so --gc-sections discards
#     those sections before relocation and the link succeeds. The day someone
#     gives apps a caller, the link will fail loudly on gui_create_window, which
#     is the correct signal: apps needs a GUI backend re-homed onto the
#     ramfb + virtio-input path zxv_shell already drives, and that is a
#     different piece of work from an include-path decision.

# GC ROOTS FOR STAGED MODULES. --gc-sections discards any section nothing
# references, so a module with no caller yet is in KERNEL_SRCS, compiles, and is
# still ABSENT from the ELF (this is exactly what verify_banners.sh exists to
# catch).
#
# 2026-08-10: the tolvovina GC roots (tvl_stereo_selfcheck, tvl_raster_selfcheck)
# are REMOVED, per their own instruction to remove them once a real caller
# exists. kernel/src/tolvovina/tvl_bringup.c now calls all four tolvovina
# self-checks, and boot_features.c calls tvl_bringup(), so the modules are
# reachable from kernel_main by an ordinary call chain. Keeping the roots would
# have made `nm` say "present" whether or not that chain works -- the whole
# point of this gate is that retention must not be able to impersonate use.
GC_ROOTS =

LDFLAGS = -T kernel/arch/arm64/linker.ld -nostdlib -static -Wl,--gc-sections -Wl,--build-id=none $(GC_ROOTS)
LIBGCC = $(shell $(CC) -print-libgcc-file-name 2>/dev/null || echo /usr/lib/gcc-cross/aarch64-linux-gnu/13/libgcc.a)

# ARM64 arch-specific objects. Under $(OBJDIR) since 2026-08-11 -- see the
# OBJDIR comment above the CFLAGS block.
ARM64_ARCH_OBJS = \
    $(OBJDIR)/kernel/arch/arm64/boot.o \
    $(OBJDIR)/kernel/arch/arm64/uart_pl011.o \
    $(OBJDIR)/kernel/arch/arm64/gicv3.o \
    $(OBJDIR)/kernel/arch/arm64/arm64_timer.o \
    $(OBJDIR)/kernel/arch/arm64/arm64_mmu.o \
