# Makefile.arm64 — ARM64 build for VOVINA SHAKINA kernel
#
# Cross-compiles the ZEDEC pqOS kernel for AArch64 (QEMU virt).
#
# Author: H.M. Michael-Laurence: Curzi (c)
# License: Apache-2.0

CROSS_COMPILE ?= aarch64-linux-gnu-
CC = $(CROSS_COMPILE)gcc
LD = $(CROSS_COMPILE)ld
OBJCOPY = $(CROSS_COMPILE)objcopy
OBJDUMP = $(CROSS_COMPILE)objdump

KERNEL_SIM_DEVICES ?= 0

# PARALLEL BY DEFAULT, ASKED OF THE HARDWARE, NOT HARDCODED. `-j$(nproc)` lived
# in two helper scripts and never in the main build path, so every build this
# project ever ran used one core of twelve. Measured against GNU Make 4.3 on the
# build box: `MAKEFLAGS += -j` does take effect from inside a makefile (6 x 2s
# jobs in 2.0s), `JOBS=1` serialises it (12.0s), and a command-line `-j2`
# overrides it (6.0s) -- so both escape hatches for a bisect or an ordered log
# are one variable away.
NPROC := $(shell nproc 2>/dev/null || echo 4)
JOBS  ?= $(NPROC)
MAKEFLAGS += -j$(JOBS)

# OUT-OF-TREE OBJECTS, one build/<arch> mirror per arch, so all five Makefiles
# can run AT THE SAME TIME. Until 2026-08-11 this file used
# $(KERNEL_SRCS:.c=.o) and wrote kernel/src/x/y.o -- the exact paths riscv,
# riscv32 and arm32 also wrote. Four arches, one set of filenames: whichever ran
# last won, and a survivor from another arch surfaced as "file format not
# recognized". Makefile.x86_64 has had OBJDIR since it was written; this brings
# the other four onto its scheme. ~/zxv/.buildlock and the
# `find kernel -name '*.o' -delete` prologue exist only to work around the
# collision that this variable removes.
OBJDIR := build/arm64

# NOTE: -fno-tree-vectorize/-fno-tree-slp-vectorize below are REQUIRED for
# correctness, not speed: the IRQ vector (boot.s SAVE_REGS) saves only x0-x30,
# NOT the FP/SIMD register file, so any live state the compiler parks in NEON
# v-registers is clobbered when a timer IRQ preempts kernel code -> wild faults
# (the kernel_main scan-loop poison-index bug, #41). -mgeneral-regs-only makes
# ANY float/double/complex use, scalar FP included, a compile error: kernel code
# is integer-only (fixed point), so the FP/SIMD file is never live in C code.
# -Wno-misleading-indentation: the codebase uses an intentional ultra-dense
# single-line style (opcode-decode tables, one-line guards) that trips this pure
# whitespace/style warning; it is never a correctness signal here. ALL correctness
# warnings (-Wall -Wextra) stay ON, and the substantive ones (-Wsign-compare,
# -Wtautological-compare) were fixed rather than suppressed. Same rationale as the
# Linux kernel disabling this one sub-warning.
CFLAGS = -std=c11 -Wall -Wextra -O2 -ffreestanding -nostdlib \
         -fno-stack-protector -fno-pie -no-pie -fno-builtin \
         -ffunction-sections -fdata-sections \
         -fno-tree-vectorize -fno-tree-slp-vectorize -mgeneral-regs-only \
         -Werror=double-promotion -Werror=float-conversion \
         -fno-math-errno \
         -Wno-misleading-indentation \
         -MMD -MP \
         -DKERNEL_SIM_DEVICES=$(KERNEL_SIM_DEVICES) \
         -DENABLE_EL0_USERSPACE=1 -DENABLE_TICK_IRQ=1 \
         -DENABLE_EVENT_LOOP=1 \
         $(CFLAGS_EXTRA) \
         -Dmemset=fs_memset -Dmemcpy=fs_memcpy -Dstrlen=fs_strlen \
         -Dstrcmp=fs_strcmp -Dstrcpy=fs_strcpy \
         -Dmalloc=fs_malloc -Dcalloc=fs_calloc \
         -Dmemcmp=fs_memcmp -Dpow=fs_pow -Dlog=fs_log \
         -include kernel/include/freestanding.h \
         -Ikernel/include -Ikernel/src -Ikernel/src/e8 -Ikernel/src/mixmat -Ikernel/src/mbcomp -Ikernel/src/modbind -Ikernel/arch/arm64 -Ikernel/src/virtio -Ikernel/src/trispace -Ikernel/src/holodeck -Ikernel/src/denconnect -Ikernel/src/mlkem -Ikernel/src/curzi -Ikernel/src/pqsec -Ikernel/boot \
         -Ikernel/src/plnp -Ikernel/src/smap -Ikernel/src/decent \
         -Ikernel/src/recon -Ikernel/src/hdcm -Ikernel/src/gematria \
         -Ikernel/src/dualtrack -Ikernel/src/superpos \
         -Ikernel/src/pungent -Ikernel/src/ascent \
         -Ikernel/src/lattice -Ikernel/src/pterm -Ikernel/src/xedit \
         -Ikernel/src/crypto_wallet -Ikernel/src/nlb \
         -Ikernel/src/license -Ikernel/src/surplus -Ikernel/src/edp_risk \
         -Ikernel/src/predictive -Ikernel/src/situation \
         -Ikernel/src/rational -Ikernel/src/finance -Ikernel/src/identity \
         -Ikernel/src/quantum -Ikernel/src/hardware \
         -Ikernel/src/audiogenomics_pro \
         -Ikernel/src/synthesis -Ikernel/compat \
         -Ikernel/src/vino -Ikernel/src/vena -Ikernel/src/holographic \
         -Ikernel/src/axiom_matrix -Ikernel/src/telemetry \
         -Ikernel/src/oseq -Ikernel/src/rmag -Ikernel/src/lpres \
         -Ikernel/src/iphase -Ikernel/src/choice -Ikernel/src/phase_coord \
         -Ikernel/src/crit168 -Ikernel/include/freestanding_stubs \
