# ---------------------------------------------------------------------------
# THE 49 SOURCES ABOVE THE BLANK CONTINUATION WERE STAGED, NOT DEAD.
#
# They compile with the CFLAGS above and nothing else was needed but the two
# -I paths documented at the top. What is NOT claimed: that they RUN. Compiling
# is one state, linking is a second, and being reachable in kernel_arm64.elf is
# a third. Under -ffunction-sections + --gc-sections a source can be in this
# list, compile, link, and still be entirely absent from the ELF because no
# retained section references it. Every one of these is in exactly that state
# today, and no GC_ROOTS entry was added to hide it: rooting a leaf makes `nm`
# say "present" for a module nothing runs, which is worse than an honest zero
# because it looks integrated and is not (this is the same reason the tolvovina
# roots were removed above).
#
# FOUR THINGS DELIBERATELY LEFT OUT, each for a measured reason:
#
#   kernel/src/bringup/arch_globals.c  -- its own header says linking it on
#     arm64 is a duplicate-symbol error, because kernel_main_arm64.c already
#     defines the vfs/net/router/sched globals it provides. It compiles clean;
#     that is exactly the trap. Correctly excluded by design, unchanged.
#
#   kernel/src/gdt/gdt.c, kernel/src/idt/idt.c -- 32-bit protected-mode code in
#     a long-mode kernel (`unknown register name 'eax'`; idt.c cannot even find
#     pic.h). Already adjudicated elsewhere; not touched.
#
#   kernel/src/sutra/debug_vino.c -- a HOSTED tool. It uses stdout/fflush and
#     fails with `'stdout' undeclared`. The other nine sutra sources are in.
#
#   kernel/experimental/p2p_caracho/p2p_caracho.c (was kernel/src/) -- compiles clean, and its own file
#     header says: "SUPERSEDED -- moved to kernel/src/bootlegger/bootlegger.c
#     ... do not include or build it." The two files' global symbol sets do not
#     collide (measured: 0 common globals), so building both would have LINKED
#     -- it would just have shipped one transport twice. bootlegger.c is in.
#     The file stays on disk; it is not dead, it is superseded.
#
# TEN MORE ORPHANS ARE HOSTED TEST HARNESSES, not kernel code: every mlkem
# *_validate.c, robin_debanks/crypto_validate.c, and sutra/debug_sutra{,_runtime}.c
# defines `int main(void)` (measured with nm, not inferred from the file name --
# they compile clean only because <stdio.h> resolves through
# kernel/include/freestanding_stubs). Ten `main` definitions in one link is ten
# multiple-definition errors. They belong to a host test target, not to this one.
#
# The remaining orphans are the x86 port-I/O cluster (ata, keyboard, mouse, pci,
# pic, timer, net/rtl8139) -- `impossible constraint in 'asm'` on aarch64, which
# is not an arm64 question -- and kernel/src/apps/{clock_app,dharma_monitor,
# notes_app,vfs_stub}.c. Those four are NOT a missing include path: the three
# app files reference types (clock_app_t, notes_app_t, dharma_monitor_app_t,
# oseq_state_t, tantra_engine_t) that apps.h does not declare, and vfs_stub.c
# is a host-test stub that would collide with kernel/src/vfs/vfs.c by its own
# description. apps.c itself is in.
# ---------------------------------------------------------------------------

KERNEL_OBJS = $(patsubst %.c,$(OBJDIR)/%.o,$(KERNEL_SRCS))

# Directories created ONCE at parse time, before any recipe runs, so no two -j
# jobs can race for the same parent. The in-rule mkdir is a backstop only.
OBJDIRS := $(sort $(dir $(ARM64_ARCH_OBJS) $(KERNEL_OBJS)))
$(shell mkdir -p $(OBJDIRS))

TARGET = kernel_arm64.elf
TARGET_BIN = kernel_arm64.bin

# Auto-generated header dependencies (from -MMD -MP): rebuild any .o when a
# header it includes changes. Without this, editing a struct in a .h left stale
# .o files carrying the OLD layout — a silent, ugly class of bug (a shell struct
# grew two fields but kernel_main.o kept the old size, so writes landed in
# adjacent memory). Never again.
DEPS = $(ARM64_ARCH_OBJS:.o=.d) $(KERNEL_OBJS:.o=.d)
-include $(DEPS)

.PHONY: all clean run

all: $(TARGET) $(TARGET_BIN)

# The banner gate runs INSIDE the link rule, not as a separate target, so there
# is no way to obtain an ELF that has not been checked. A separate `make verify`
# would just be one more thing to forget -- which is the exact failure this
# guards against.
#
# WHY IT EXISTS: this build uses -ffunction-sections -fdata-sections
# --gc-sections, so the linker DISCARDS any section nothing references. A module
# can be in KERNEL_SRCS, compile, link and pass its own tests while being ABSENT
# from the binary. Measured 2026-08-09: tls/x25519/aead/hkdf, oseq, chiglet all
# had 0 symbols in the ELF immediately after being added to KERNEL_SRCS. So a
# boot banner announcing a subsystem is a claim about `nm`, not about the
# Makefile, and this makes the build prove it.
#
# Set VERIFY_BANNERS=0 to bypass. Do that only to inspect a broken link -- never
# to ship, because bypassing it is exactly how the binary and the banners drift.
VERIFY_BANNERS ?= 1

$(TARGET): $(ARM64_ARCH_OBJS) $(KERNEL_OBJS)
	$(CC) $(LDFLAGS) -o $@ $^ $(LIBGCC)
	@if [ "$(VERIFY_BANNERS)" = "1" ]; then \
		build_system/verify_layers.sh || { \
			echo "*** BUILD FAILED: layer violation (DRC). A module may not"; \
			echo "*** depend on a higher layer. See build_system/verify_layers.sh."; \
			rm -f $@; exit 1; }; \
		build_system/verify_banners.sh $@ || { \
			echo ""; \
			echo "*** BUILD FAILED: a boot banner announces a subsystem that is"; \
			echo "*** not in $@. Either remove the banner or give the module a"; \
			echo "*** real caller -- being in KERNEL_SRCS is not enough under"; \
			echo "*** --gc-sections. See build_system/verify_banners.sh."; \
			rm -f $@; \
			exit 1; \
		}; \
	else \
		echo "  [WARN] banner verification BYPASSED (VERIFY_BANNERS=0)"; \
	fi

$(TARGET_BIN): $(TARGET)
	$(OBJCOPY) -O binary $< $@

# ---- BOOTAA64.EFI: self-contained UEFI app that embeds the flat kernel ----
# Boots the desktop from the universal ISO under UEFI (AAVMF). The blob is
# .incbin'd from kernel_arm64.bin, so that must be built first (it is a dep).
# Stub is -fno-pic (PC-relative adrp/add, no runtime relocs) + no FP/NEON.
EFI_APP = BOOTAA64.EFI
EFI_OBJS = kernel/arch/arm64/efi_header.o kernel/arch/arm64/efi_stub.o kernel/arch/arm64/efi_tramp.o kernel/arch/arm64/efi_kernel_blob.o
$(EFI_APP): $(TARGET_BIN) kernel/arch/arm64/efi_stub.c kernel/arch/arm64/efi_header.S kernel/arch/arm64/efi_tramp.S kernel/arch/arm64/efi_kernel_blob.S build_system/efi_stub.ld
	$(CC) -c -O2 -ffreestanding -fno-pic -fno-stack-protector -mgeneral-regs-only -o kernel/arch/arm64/efi_stub.o kernel/arch/arm64/efi_stub.c
	$(CC) -c -o kernel/arch/arm64/efi_header.o kernel/arch/arm64/efi_header.S
	$(CC) -c -o kernel/arch/arm64/efi_tramp.o kernel/arch/arm64/efi_tramp.S
	$(CC) -c -o kernel/arch/arm64/efi_kernel_blob.o kernel/arch/arm64/efi_kernel_blob.S
	$(LD) -T build_system/efi_stub.ld -o kernel/arch/arm64/efi_stub.elf $(EFI_OBJS)
	@END=$$($(CROSS_COMPILE)nm kernel/arch/arm64/efi_stub.elf | awk '/ __image_end$$/{print "0x"$$1}'); \
	 $(OBJCOPY) -O binary --pad-to=$$END kernel/arch/arm64/efi_stub.elf $(EFI_APP); \
	 echo "  [EFI] $(EFI_APP) padded to SizeOfImage $$END"

# ONE pattern rule now covers kernel/arch/arm64/*.c AND kernel/src/**/*.c AND
# kernel/compat/*.c AND kernel/freestanding.c. The last two previously fell
# through to make's BUILT-IN %.o: %.c rule, which is a different recipe; naming
# every input explicitly removes that quiet second compile path.
$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

# Assembly: explicit rule, so no implicit .c prerequisite is inferred for it.
$(OBJDIR)/kernel/arch/arm64/boot.o: kernel/arch/arm64/boot.s
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<

run: $(TARGET)
	qemu-system-aarch64 -M virt,gic-version=3 -cpu cortex-a53 -m 256M \
		-kernel $(TARGET) -nographic -serial mon:stdio

clean:
	rm -rf $(OBJDIR) $(TARGET) $(TARGET_BIN)

# ---- THE DERIVED PHASE TABLE ------------------------------------------------
# Generated, never committed. build_system/gen_phase_table.sh computes one
# #define per declared module -- its l13 phase, taken from its DRC layer, and
# where verify_layers.sh's layer_of() is silent, from the floor its own local
# includes impose. kernel/include/zxv_decl.h includes the result and ZXV_DECLARE
# pastes ZXV_PHASE_OF_<module> into the module record, so no phase is ever typed
# and a new module gets one the moment it is declared.
#
# GENERATED AT PARSE TIME, ON PURPOSE, NOT AS A RULE. Every object in this build
# includes this header, so as a rule it would have to be a prerequisite of ~300
# targets; miss one and a -j build races a compile against the generator and
# fails intermittently -- the single worst failure mode to debug. A parse-time
# $(shell ...) has run to completion before make has decided what to build at
# all, so no ordering exists to get wrong. It costs ~0.3s and it re-derives on
# every invocation, which is what keeps the table from going stale.
#
# The census goes to $(OBJDIR)/gen/phase_census.txt: a build that silently
# generated the wrong number of phases would be exactly the invisible drift this
# whole mechanism exists to remove.
ZXV_GENDIR    := $(OBJDIR)/gen
ZXV_PHASE_HDR := $(ZXV_GENDIR)/zxv_phase_table.h
$(shell mkdir -p $(ZXV_GENDIR) && sh $(CURDIR)/build_system/gen_phase_table.sh $(CURDIR)/$(ZXV_PHASE_HDR) 2> $(CURDIR)/$(ZXV_GENDIR)/phase_census.txt)
CFLAGS += -I$(ZXV_GENDIR)
