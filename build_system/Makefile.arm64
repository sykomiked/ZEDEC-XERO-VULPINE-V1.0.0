    $(OBJDIR)/kernel/arch/arm64/kernel_main_arm64.o \
    $(OBJDIR)/kernel/arch/arm64/el0_userspace.o \
    $(OBJDIR)/kernel/arch/arm64/user_procs.o \
    $(OBJDIR)/kernel/arch/arm64/ramdisk.o \
    $(OBJDIR)/kernel/arch/arm64/virtio_blk.o \
    $(OBJDIR)/kernel/arch/arm64/virtio_net.o \
    $(OBJDIR)/kernel/arch/arm64/virtio_input.o \
    $(OBJDIR)/kernel/arch/arm64/virtio_snd.o \
    $(OBJDIR)/kernel/arch/arm64/entropy.o

